{
  "name": "onlinechess",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test:app": "mocha --require ./test/_setLocaleEn.js ./test/chess.app.test.js ./test/brain41.pawnEval.test.js ./test/strings.test.js ./test/themeSchema.test.js ./test/customThemeStore.test.js ./test/positionValidation.test.js ./test/session.phase0.test.js ./test/session.gameSession.test.js ./test/session.onlineMode.test.js ./test/session.practiceMode.test.js ./test/session.positionSetupMode.test.js ./test/mobile.sessionReview.test.js ./test/mobile.sessionLocalEngine.test.js ./test/mobile.sessionOnline.test.js ./test/adapters.brainHttp.test.js ./test/adapters.brainIpc.test.js ./test/adapters.createEnginePort.test.js ./test/rematchColors.test.js ./test/rematchPeerLeft.test.js ./test/onlineGameOpponentForward.test.js ./test/onlineGameReconnect.test.js ./test/timeoutGameOver.test.js ./test/playUi.movesPanel.test.js ./test/playUi.clocksController.test.js ./test/playUi.savedGamesModel.test.js ./test/playUi.savedGamesList.test.js ./test/playUi.reviewModel.test.js ./test/playUi.reviewNav.test.js ./test/playUi.sessionMode.test.js ./test/playUi.dockModeChrome.test.js ./test/playUi.actionRail.test.js ./test/playUi.statusBar.test.js ./test/playUi.engineTurn.test.js ./test/playUi.phase1Remainder.test.js ./test/playChatPanel.test.js ./test/playUi.rightDockMode.test.js ./test/servePlayHtml.test.js ./test/siteBundleUrls.test.js",
    "test:pgn": "node ./scripts/run-mocha.js pgn",
    "test:heavy": "node ./scripts/run-mocha.js heavy",
    "test:web:api": "mocha --exit --require ./test/_teardownWorkers.js ./test/security.http.test.js ./test/web.api.test.js ./test/webCustomThemes.api.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:web": "npm run test:web:api && npm run test:e2e",
    "test:brain": "node ./scripts/run-mocha.js brain",
    "test:brain:all": "node ./scripts/run-mocha.js brain-all",
    "test:all": "node ./scripts/run-mocha.js all && npm run test:web",
    "test:light": "node ./scripts/run-mocha.js light",
    "test": "node ./scripts/run-mocha.js default && npm run test:web",
    "coverage": "c8 --reporter=html --reporter=text-summary node ./scripts/run-mocha.js default && npm run test:web",
    "coverage:all": "c8 --reporter=html --reporter=text-summary node ./scripts/run-mocha.js all && npm run test:web",
    "test:coverage": "npm run coverage",
    "analysis": "npx eslint ./src/**/*.js",
    "jira": "node scripts/jira.js",
    "i18n:build": "node scripts/i18n-build-en-extra.js && node scripts/i18n-build-he-extra.js",
    "i18n:finish": "node scripts/i18n-finish.js",
    "start": "npm run build:client && node ./server.js",
    "start:dev": "npm run build:client && node --inspect ./server.js",
    "start:prod": "npm run build:client && node ./server.js",
    "build:play": "node ./scripts/build-play-shell.js",
    "build:site": "node ./scripts/build-site-shell.js",
    "build:client": "npm run build:play && npm run build:site",
    "install:stockfish": "bash ./scripts/install-stockfish-linux.sh",
    "postinstall": "node ./scripts/maybe-install-stockfish.js",
    "oracle:bootstrap": "bash ./scripts/oracle-bootstrap.sh",
    "start:desktop:server": "SHMERLING_MODE=desktop SHMERLING_USER_DATA=./.shmerling-desktop-dev SHMERLING_SYNC_CUSTOM_THEMES=1 node ./server-desktop.js",
    "desktop": "node scripts/run-desktop.js",
    "desktop:setup": "cd desktop && npm install && npm run setup",
    "desktop:stage": "node ./scripts/stage-app-bundle.js",
    "desktop:verify": "node ./scripts/verify-desktop-bundle.js",
    "desktop:dist:win": "cd desktop && npm install && npm run dist:win",
    "desktop:git:release": "node scripts/git-publish-release.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "connect-flash": "^0.1.1",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.0.2",
    "ejs-mate": "^4.0.0",
    "esbuild": "^0.25.12",
    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "express-ws": "^5.0.2",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsdoc": "^4.0.3",
    "method-override": "^3.0.0",
    "mongoose": "^8.7.0",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.7",
    "path": "^0.12.7",
    "sanitize-html": "^2.14.0",
    "uuid": "^14.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.62.0",
    "c8": "^10.1.3",
    "eslint": "^10.0.1",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.5",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "mocha": {
      "diff": "^9.0.0",
      "serialize-javascript": "^7.0.5"
    }
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "src/desktop/ui/**",
      "src/views/**",
      "src/assets/**"
    ],
    "reporter": [
      "html",
      "text-summary"
    ]
  }
}
