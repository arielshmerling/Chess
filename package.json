{
  "name": "onlinechess",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "nyc --reporter=html mocha ./test/chess.test.js ./test/chess.fide-rules.test.js",
    "test:app": "mocha ./test/chess.app.test.js ./test/brain41.pawnEval.test.js ./test/strings.test.js ./test/positionValidation.test.js ./test/session.phase0.test.js ./test/session.gameSession.test.js ./test/session.onlineMode.test.js ./test/session.practiceMode.test.js ./test/session.positionSetupMode.test.js ./test/mobile.sessionReview.test.js ./test/mobile.sessionLocalEngine.test.js ./test/mobile.sessionOnline.test.js ./test/adapters.brainHttp.test.js ./test/adapters.brainIpc.test.js ./test/adapters.createEnginePort.test.js ./test/rematchColors.test.js ./test/playUi.movesPanel.test.js ./test/playUi.clocksController.test.js ./test/playUi.savedGamesModel.test.js ./test/playUi.savedGamesList.test.js ./test/playUi.reviewModel.test.js ./test/playUi.reviewNav.test.js ./test/playUi.sessionMode.test.js ./test/playUi.dockModeChrome.test.js ./test/playUi.actionRail.test.js ./test/playUi.statusBar.test.js ./test/playUi.engineTurn.test.js ./test/playUi.phase1Remainder.test.js",
    "test:brain": "mocha ./test/brain41.pawnEval.test.js ./test/brain42.advancedPawn.test.js ./test/brain42.adaptiveDepth.test.js ./test/brain42.gamePhase.test.js ./test/brain42.mateInThree.test.js ./test/brain43.mateInThree.test.js",
    "test:heavy": "mocha ./test/chess.heavy.js",
    "test:all": "mocha --exit --require ./test/_teardownWorkers.js \"./test/**/*.test.js\"",
    "test:web:api": "mocha --exit --require ./test/_teardownWorkers.js ./test/web.api.test.js ./test/webCustomThemes.api.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:web": "npm run test:web:api && npm run test:e2e",
    "test:coverage": "nyc --concurrency=1 --reporter=html --reporter=text-summary mocha --exit --require ./test/_teardownWorkers.js \"./test/**/*.test.js\"",
    "coverage": "npm run test:coverage",
    "analysis": "npx eslint ./src/**/*.js",
    "i18n:build": "node scripts/i18n-build-en-extra.js",
    "i18n:finish": "node scripts/i18n-finish.js",
    "start": "node ./server.js",
    "start:dev": "node --inspect ./server.js",
    "start:prod": "node ./server.js",
    "start:desktop:server": "SHMERLING_MODE=desktop SHMERLING_USER_DATA=./.shmerling-desktop-dev SHMERLING_SYNC_CUSTOM_THEMES=1 node ./server-desktop.js",
    "desktop": "node scripts/run-desktop.js",
    "desktop:setup": "cd desktop && npm install && npm run setup",
    "desktop:dist:win": "cd desktop && npm install && npm run dist:win",
    "desktop:git:release": "node scripts/git-publish-release.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "connect-flash": "^0.1.1",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.0.2",
    "ejs-mate": "^4.0.0",
    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "express-ws": "^5.0.2",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsdoc": "^4.0.3",
    "method-override": "^3.0.0",
    "mongoose": "^8.7.0",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.7",
    "path": "^0.12.7",
    "sanitize-html": "^2.14.0",
    "uuid": "^14.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.62.0",
    "eslint": "^10.0.1",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "istanbul-lib-processinfo": {
      "uuid": "^11.1.1"
    },
    "mocha": {
      "diff": "^9.0.0",
      "serialize-javascript": "^7.0.5"
    }
  },
  "nyc": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "src/desktop/ui/**",
      "src/views/**",
      "src/assets/**"
    ],
    "concurrency": 1
  }
}
