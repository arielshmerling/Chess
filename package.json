{
  "name": "onlinechess",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "nyc --reporter=html mocha ./test/chess.test.js ./test/chess.fide-rules.test.js",
    "test:app": "mocha ./test/chess.app.test.js ./test/brain41.pawnEval.test.js",
    "test:brain": "mocha ./test/brain41.pawnEval.test.js ./test/brain42.advancedPawn.test.js ./test/brain42.adaptiveDepth.test.js ./test/brain42.gamePhase.test.js ./test/brain42.mateInThree.test.js ./test/brain43.mateInThree.test.js",
    "test:heavy": "mocha ./test/chess.heavy.test.js",
    "test:all": "npm run test && npm run test:heavy",
    "analysis": "npx eslint ./src/**/*.js",
    "start": "node ./server.js",
    "start:dev": "node --inspect ./server.js",
    "start:prod": "node ./server.js",
    "start:desktop:server": "SHMERLING_MODE=desktop SHMERLING_USER_DATA=./.shmerling-desktop-dev SHMERLING_SYNC_CUSTOM_THEMES=1 node ./server-desktop.js",
    "desktop": "cd desktop && npm install && npm start",
    "desktop:dist:win": "cd desktop && npm install && npm run dist:win",
    "desktop:dist:win:dir": "cd desktop && npm install && npm run dist:win:dir",
    "desktop:dist:win:zip": "cd desktop && npm install && npm run dist:win:dir:zip",
    "desktop:git:release": "node desktop/scripts/git-publish-release.js",
    "dummy:active-games:add": "node ./scripts/dummy-active-games-seed.js",
    "dummy:active-games:remove": "node ./scripts/dummy-active-games-delete.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "connect-flash": "^0.1.1",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.0.2",
    "ejs-mate": "^4.0.0",
    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "express-ws": "^5.0.2",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsdoc": "^4.0.3",
    "method-override": "^3.0.0",
    "mongoose": "^8.7.0",
    "nodemailer": "^8.0.8",
    "nodemon": "^3.1.7",
    "path": "^0.12.7",
    "sanitize-html": "^2.14.0",
    "uuid": "^14.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^10.0.1",
    "globals": "^15.14.0",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0"
  },
  "overrides": {
    "istanbul-lib-processinfo": {
      "uuid": "^11.1.1"
    },
    "mocha": {
      "diff": "^9.0.0",
      "serialize-javascript": "^7.0.5"
    }
  }
}
