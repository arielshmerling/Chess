# Copy to your shell profile or a local file (never commit secrets).
# Required for builds users can install without security warnings.

# --- macOS (Developer ID + notarization) ---
# export CSC_NAME="Developer ID Application: Your Name (TEAM_ID)"
export APPLE_ID="you@example.com"
export APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
export APPLE_TEAM_ID="XXXXXXXXXX"

# --- Windows (Authenticode — sign .exe on Mac via electron-builder) ---
export CSC_LINK="/absolute/path/to/code-signing.pfx"
export CSC_KEY_PASSWORD="certificate-password"

# Optional: disable auto-discovery if multiple certs in Keychain
# export CSC_IDENTITY_AUTO_DISCOVERY=false
