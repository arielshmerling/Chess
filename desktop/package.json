{
  "name": "shmerling-desktop",
  "productName": "Shmerling Chess",
  "version": "1.0.0",
  "description": "Shmerling Chess — offline desktop",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare:icons": "node scripts/prepare-icons.js",
    "patch:app-name": "node scripts/patch-electron-app-name.js",
    "postinstall": "node scripts/prepare-icons.js && node scripts/patch-electron-app-name.js",
    "prestart": "node scripts/prepare-icons.js && node scripts/patch-electron-app-name.js",
    "start": "electron .",
    "predist": "node scripts/prepare-icons.js && node scripts/patch-electron-app-name.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.shmerling.app",
    "productName": "Shmerling Chess",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "build/icon.png",
      "build/icon.ico",
      "build/icon.icns",
      "../server-desktop.js",
      "../src/**/*",
      "../data/opening-book-states.bin",
      "../assets/**/*",
      "!../**/*.test.js",
      "!../test/**"
    ],
    "extraResources": [
      {
        "from": "../data/opening-book-states.bin",
        "to": "data/opening-book-states.bin"
      }
    ],
    "mac": {
      "category": "public.app-category.board-games",
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleDisplayName": "Shmerling Chess",
        "CFBundleName": "Shmerling Chess"
      },
      "target": ["dmg"]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
