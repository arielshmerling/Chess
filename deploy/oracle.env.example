# Copy to repo root as `.env` on the Oracle VM, then fill in real values.
# Do not commit the real `.env`.

PORT=3000
NODE_ENV=production

# MongoDB Atlas (or other) connection string
DATABASE_URL=mongodb+srv://USER:PASS@CLUSTER/chess?retryWrites=true&w=majority

JWT_SECRET=change-me
SESSION_SECRET=change-me

# Stockfish (bootstrap links ./bin/stockfish → apt binary when available)
STOCKFISH_PATH=/home/ubuntu/Chess/bin/stockfish
UCI_LOW_MEMORY=1

# Optional email / admin — only if you use those features
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ADMIN_NOTIFY_EMAILS=
