<% layout("../views/layouts/boilerplate") %>

<link rel="stylesheet" href="/welcome.css">
<link rel="stylesheet" href="/board-geometry.css">

<div class="welcome-container list-page board-geometry">
  <header class="hero-banner hero-banner--board">
    <div class="hero-board-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text-section">
        <h1 class="hero-username"><%= t('site.list.title') %></h1>
        <p class="hero-tagline"><%= t('site.list.tagline') %></p>
      </div>
    </div>
  </header>

  <div class="games-section">
    <section class="games-panel my-games-panel list-games-panel" id="PlayerGameList">
      <div class="panel-header">
        <div class="panel-header-top">
          <div class="panel-title-group">
            <h2 class="panel-title"><%= t('site.list.allGames') %></h2>
          </div>
          <% if (playerGames && playerGames.length > 0) { %>
          <p class="panel-subtitle panel-subtitle--inline"><%= t('site.list.gamesCount', { count: playerGames.length }) %></p>
          <% } %>
        </div>
      </div>
      <div class="panel-body">
        <% if (playerGames && playerGames.length > 0) { %>
        <% function gameColLabel(key) {
            var map = {
              Date: t("site.gameList.date"),
              Time: t("site.gameList.time"),
              White: t("common.white"),
              Black: t("common.black"),
              Result: t("site.gameList.result"),
              Moves: t("site.activeGames.moves"),
              Reason: t("site.gameList.reason"),
              Type: t("site.gameList.type"),
              Status: t("site.gameList.status"),
            };
            return map[key] || key;
          } %>
        <div class="table-scroll table-scroll--wide">
          <table class="games-table sortable">
            <thead>
              <tr>
                <th class="sortable-th col-num" data-sort-key="rowIndex" title="<%= t('site.welcome.sortByRowNumber') %>">
                  <span class="th-label">#</span>
                  <span class="sort-icon" aria-hidden="true"></span>
                </th>
                <% obj = playerGames[0]; %>
                <% for(const key in obj) { %>
                  <% if(key !== "Id" && !key.startsWith("_")) { %>
                <th class="sortable-th" data-sort-key="<%= key.replace(/^\s+/, '').replace(/\s+$/, '') %>" title="<%= t('site.welcome.sortBy', { key: gameColLabel(key.trim()) }) %>">
                  <span class="th-label"><%= gameColLabel(key) %></span>
                  <span class="sort-icon" aria-hidden="true"></span>
                </th>
                  <% } %>
                <% } %>
                <th class="col-action"><%= t('site.list.action') %></th>
              </tr>
            </thead>
            <tbody>
              <% rowIndex = 0; for(const obj of playerGames) { %>
              <tr data-row-index="<%= rowIndex %>" data-nav-href="/review?type=history&id=<%= obj.Id %>">
                <td class="row-number sortable-td col-num" data-sort-key="rowIndex" data-sort-value="<%= rowIndex %>"><%= rowIndex + 1 %></td>
                <% for(const key in obj) { %>
                  <% if(key !== 'Id' && !key.startsWith('_')) { %>
                    <% sortVal = key === 'Date' ? (obj._sortableDate || 0) : (key === 'Moves' ? (obj.Moves || 0) : (obj[key] != null ? String(obj[key]).replace(/"/g, '&quot;') : '')); %>
                <td class="<%= key.trim() === 'Reason' ? 'align-left ' : '' %>sortable-td" data-sort-key="<%= key.trim() %>" data-sort-value="<%= sortVal %>"<% if (key.trim() === 'Result' && obj._resultReason) { %> title="<%= String(obj._resultReason).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;') %>"<% } %>>
                  <%= obj[key] %>
                </td>
                  <% } %>
                <% } %>
                <td class="no-sort col-action" data-stop-nav>
                  <form action="/list/<%= obj.Id %>?_method=delete" method="POST" class="list-delete-form">
                    <input type="hidden" name="sortKey" value="">
                    <input type="hidden" name="sortOrder" value="">
                    <button type="submit" class="list-delete-btn"><%= t('common.delete') %></button>
                  </form>
                </td>
              </tr>
              <% rowIndex++; } %>
            </tbody>
          </table>
        </div>
        <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function() {
    var table = document.querySelector('#PlayerGameList table.sortable');
    if (!table) return;
    var thead = table.querySelector('thead tr');
    var tbody = table.querySelector('tbody');
    var sortState = { key: null, asc: true };

    function parseSortFromUrl() {
        var params = new URLSearchParams(window.location.search);
        var key = params.get('sort');
        var order = params.get('order');
        if (key) sortState.key = key;
        if (order === 'asc' || order === 'desc') sortState.asc = order === 'asc';
    }

    function updateUrlSort() {
        if (!sortState.key) return;
        var params = new URLSearchParams(window.location.search);
        params.set('sort', sortState.key);
        params.set('order', sortState.asc ? 'asc' : 'desc');
        var url = window.location.pathname + '?' + params.toString();
        history.replaceState(null, '', url);
    }

    function updateFormsSortInputs() {
        document.querySelectorAll('.list-delete-form').forEach(function(form) {
            var keyInput = form.querySelector('input[name="sortKey"]');
            var orderInput = form.querySelector('input[name="sortOrder"]');
            if (keyInput) keyInput.value = sortState.key || '';
            if (orderInput) orderInput.value = sortState.key ? (sortState.asc ? 'asc' : 'desc') : '';
        });
    }

    function getSortValue(cell) {
        var key = cell.getAttribute('data-sort-key');
        var raw = cell.getAttribute('data-sort-value');
        if (key === 'rowIndex' || key === 'Date' || key === 'Moves') return Number(raw) || 0;
        return raw;
    }

    function compare(a, b) {
        var na = typeof a === 'number', nb = typeof b === 'number';
        if (na && nb) return a - b;
        if (na) return -1;
        if (nb) return 1;
        return String(a).localeCompare(String(b));
    }

    function applySort(key) {
        if (!key) return;
        var th = thead.querySelector('th.sortable-th[data-sort-key="' + key + '"]');
        if (!th) return;
        var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
        rows.sort(function(ra, rb) {
            var ca = ra.querySelector('td[data-sort-key="' + key + '"]');
            var cb = rb.querySelector('td[data-sort-key="' + key + '"]');
            if (!ca || !cb) return 0;
            var va = getSortValue(ca), vb = getSortValue(cb);
            var cmp = compare(va, vb);
            return sortState.asc ? cmp : -cmp;
        });
        rows.forEach(function(r) { tbody.appendChild(r); });
        rows.forEach(function(r, i) {
            var numCell = r.querySelector('td[data-sort-key="rowIndex"]');
            if (numCell) { numCell.setAttribute('data-sort-value', i); numCell.textContent = i + 1; }
        });
        thead.querySelectorAll('.sort-icon').forEach(function(icon) { icon.textContent = ''; icon.classList.remove('asc', 'desc'); });
        var activeIcon = th.querySelector('.sort-icon');
        if (activeIcon) {
            activeIcon.textContent = sortState.asc ? '\u25B2' : '\u25BC';
            activeIcon.classList.add(sortState.asc ? 'asc' : 'desc');
        }
        updateUrlSort();
        updateFormsSortInputs();
    }

    parseSortFromUrl();
    if (sortState.key) applySort(sortState.key);
    else updateFormsSortInputs();

    thead.addEventListener('click', function(ev) {
        var th = ev.target.closest('th.sortable-th');
        if (!th) return;
        ev.preventDefault();
        var key = th.getAttribute('data-sort-key');
        if (sortState.key === key) sortState.asc = !sortState.asc;
        else { sortState.key = key; sortState.asc = true; }
        applySort(key);
    });
})();
        </script>
        <% } else { %>
        <div class="no-games-message">
          <p><%= t('site.welcome.noCompleted') %></p>
        </div>
        <% } %>
      </div>
    </section>
  </div>

  <%- include('partials/site-page-footer') %>
</div>
