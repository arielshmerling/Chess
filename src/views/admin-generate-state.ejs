<% layout("../views/layouts/boilerplate") %>

<div class="home admin-page admin-generate-state-page">
  <div class="games-section admin-games-section">
    <div class="games-panel admin-tabbed-panel">
      <div class="panel-header admin-panel-header">
        <div class="panel-title-group admin-panel-title-row admin-generate-state-title-row">
          <h2 class="panel-title"><%= t('site.adminPage.generateTitle') %></h2>
          <a href="/admin" class="admin-generate-state-link-back"><%= t('site.adminPage.backToAdmin') %></a>
        </div>
      </div>
      <div class="panel-body admin-panel-body admin-generate-state-body">
        <p class="admin-generate-state-intro"><%= t('site.adminPage.generateIntro') %></p>
        <fieldset class="admin-generate-state-targets">
          <legend class="admin-generate-state-legend"><%= t('site.adminPage.target') %></legend>
          <label class="admin-generate-state-radio-label">
            <input type="radio" name="generate-target" value="mongo" checked>
            <span><%= t('site.adminPage.targetMongo') %></span>
          </label>
          <label class="admin-generate-state-radio-label">
            <input type="radio" name="generate-target" value="book">
            <span><%= t('site.adminPage.targetBook') %></span>
          </label>
        </fieldset>
        <div class="admin-generate-state-actions">
          <button type="button" id="btn-start-generation" class="button admin-generate-state-btn admin-generate-state-btn-start"><%= t('site.adminPage.startGeneration') %></button>
          <button type="button" id="btn-stop-generation" class="button admin-generate-state-btn admin-generate-state-btn-stop" disabled><%= t('site.adminPage.stop') %></button>
        </div>
        <div class="admin-generate-state-status" id="generate-state-status" aria-live="polite"><%= t('site.adminPage.idle') %></div>
        <div class="admin-generate-state-progress-wrap" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="generate-state-progress-wrap">
          <div class="admin-generate-state-progress-fill" id="generate-state-progress-fill"></div>
        </div>
        <div class="admin-generate-state-log" id="generate-state-log"></div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function () {
  function t(key, params) {
    if (window.ShmerlingStrings && typeof window.ShmerlingStrings.t === "function") {
      return window.ShmerlingStrings.t(key, params);
    }
    return key;
  }
  var statusEl = document.getElementById("generate-state-status");
  var fillEl = document.getElementById("generate-state-progress-fill");
  var wrapEl = document.getElementById("generate-state-progress-wrap");
  var logEl = document.getElementById("generate-state-log");
  var btnStart = document.getElementById("btn-start-generation");
  var btnStop = document.getElementById("btn-stop-generation");
  var targetInputs = document.querySelectorAll('input[name="generate-target"]');
  var es = null;
  var terminalStatus = false;

  function selectedMode() {
    for (var i = 0; i < targetInputs.length; i++) {
      if (targetInputs[i].checked) {
        return targetInputs[i].value;
      }
    }
    return "mongo";
  }

  function setBusy(busy) {
    btnStart.disabled = !!busy;
    btnStop.disabled = !busy;
    for (var j = 0; j < targetInputs.length; j++) {
      targetInputs[j].disabled = !!busy;
    }
  }

  function setPct(p) {
    var x = Math.max(0, Math.min(100, Math.round(p)));
    fillEl.style.width = x + "%";
    wrapEl.setAttribute("aria-valuenow", String(x));
  }

  function logLine(msg) {
    var line = document.createElement("div");
    line.className = "admin-generate-state-log-line";
    line.textContent = msg;
    logEl.appendChild(line);
    logEl.scrollTop = logEl.scrollHeight;
  }

  function stopStream() {
    if (es) {
      es.close();
      es = null;
    }
  }

  function run(mode) {
    stopStream();
    logEl.innerHTML = "";
    setPct(0);
    setBusy(true);
    terminalStatus = false;
    statusEl.textContent = t("site.adminPage.starting");
    var url = "/admin/generate-state/stream?mode=" + encodeURIComponent(mode);
    es = new EventSource(url);

    es.onmessage = function (ev) {
      try {
        var data = JSON.parse(ev.data);
        if (data.type === "start") {
          statusEl.textContent = t("site.adminPage.running", { mode: data.mode });
          return;
        }
        if (data.type === "phase") {
          statusEl.textContent = data.message || data.phase || "";
          if (data.phase === "reading" && data.fileCount != null) {
            logLine(t("site.adminPage.readingFiles", { count: data.fileCount }));
          }
          if (data.phase === "replay" && data.totalGames != null) {
            logLine(t("site.adminPage.replayingGames", { count: data.totalGames }));
          }
          return;
        }
        if (data.type === "progress") {
          if (data.phase === "writing") {
            setPct(96);
            statusEl.textContent = data.message || t("site.adminPage.writingOpeningBook");
            return;
          }
          if (data.segment === "reading" && data.fileTotal > 0) {
            setPct((data.fileIndex / data.fileTotal) * 12);
            statusEl.textContent = t("site.adminPage.readingPgn", { index: data.fileIndex, total: data.fileTotal, games: data.gamesLoaded || 0 });
          } else if (data.segment === "replay" && data.total > 0) {
            setPct(12 + (data.current / data.total) * 83);
            statusEl.textContent = t("site.adminPage.replayGameProgress", { current: data.current, total: data.total, completed: data.gamesCompleted });
          }
          return;
        }
        if (data.type === "done") {
          setPct(100);
          if (data.stopped) {
            var parts = [t("site.adminPage.stopped")];
            if (data.bookUnchanged) {
              parts.push(t("site.adminPage.bookUnchanged"));
            } else if (data.mode === "book" && data.entryCount != null) {
              parts.push(t("site.adminPage.bookLinesInFile", { count: data.entryCount, file: data.file || t("site.adminPage.openingBookDefault") }));
            }
            if (data.cancelledBeforeRead) {
              parts.push(t("site.adminPage.cancelledBeforeRead"));
            }
            if (data.cancelledAfterRead) {
              parts.push(t("site.adminPage.cancelledAfterRead"));
            }
            if (data.mode === "mongo" && data.gamesCompleted != null) {
              parts.push(t("site.adminPage.mongoGamesSaved", { count: data.gamesCompleted }));
            }
            statusEl.textContent = parts.join(" ");
          } else if (data.mode === "book") {
            statusEl.textContent = data.entryCount != null
              ? t("site.adminPage.doneBook", { count: data.entryCount, file: data.file || t("site.adminPage.openingBookDefault") })
              : t("site.adminPage.doneBookFileOnly", { file: data.file || t("site.adminPage.openingBookDefault") });
          } else {
            statusEl.textContent = t("site.adminPage.doneMongo", {
                detail: data.gamesCompleted != null
                  ? t("site.adminPage.doneMongoDetail", { count: data.gamesCompleted })
                  : ""
              });
          }
          logLine(statusEl.textContent);
          terminalStatus = true;
          stopStream();
          setBusy(false);
          return;
        }
        if (data.type === "error") {
          statusEl.textContent = t("site.adminPage.errorPrefix", { message: data.message || t("site.adminPage.unknownError") });
          logLine(statusEl.textContent);
          terminalStatus = true;
          stopStream();
          setBusy(false);
        }
      } catch (err) {
        console.error(err);
      }
    };

    es.onerror = function () {
      stopStream();
      setBusy(false);
      if (!terminalStatus) {
        statusEl.textContent = t("site.adminPage.connectionClosed");
      }
    };
  }

  btnStart.addEventListener("click", function () {
    run(selectedMode());
  });

  btnStop.addEventListener("click", function () {
    fetch("/admin/generate-state/stop", {
      method: "POST",
      credentials: "same-origin",
      headers: { Accept: "application/json" },
    }).catch(function (err) {
      console.error(err);
    });
  });
})();
</script>
