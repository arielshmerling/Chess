<% layout("../views/layouts/boilerplate") %>

<link rel="stylesheet" href="/welcome.css">
<script>
  window.__LAST_GAME_OPTIONS__ = window.__LAST_GAME_OPTIONS__ || {};
</script>

<!-- <div id="gameBar" class="gameBar">
        <div class="gameBarElement">AI Vs. Ariel</div>
        <div class="gameBarElement"></div>
        <div class="gameBarElement"></div>
    </div> -->

<div id="main" data-initial-game-id="<%= typeof gameId !== 'undefined' && gameId != null ? gameId : '' %>" data-research-mode="<%= typeof researchMode !== 'undefined' && researchMode ? 'true' : '' %>">
  <div id="bookmarksPanel" class="bookmarksPanel">
    <div class="panelHeader bookmarksPanel-header"><%= t('classic.bookmarks') %></div>
    <button id="addBookmarkBtn" class="button" onclick="addBookmark()"><%= t('classic.bookmarkAlertTitle') %></button>
    <div class="bookmarksSeperator"></div>
    <div id="bookmarksList" class="bookmarksList">
      <!--   <div class="bookmark">
        <div>01/01/2025 12:50</div>
        <div><%= t('site.game.practice') %></div>
      </div>

      <div class="bookmark">

      </div> -->
    </div>
    <div class="bookmarksFooter">

    </div>

  </div>
  <div class="controlPanel">
    <div id="blackClock" class="sideBlock clock short blackClock">
      <div id="blackTurnClock" class="turnClock unvisible"><img src="/images/clock.png" width="24" />
      </div>
      <div id="blackClockTimeText">05:00:00</div>

    </div>
      <div id="blackPlayersInfo" class="sideBlock playerInfo short">
      <div class="playerInfo-statusWrap">
        <div class="friends-status-dot friends-status-offline" id="blackPlayerStatus" title="" aria-label=""></div>
      </div>
      <div id="blackPlayerName"></div>
      <div id="blackPlayerDiconnectionTimer" class="disconnectionTimer hide"></div>
    </div>

    <div id="whiteCapturedPiece" class="sideBlock captureToolsList"></div>
    <div>

      <div id="movesDivContainer" class="movesDivContainer">
        <div id="movesDivHeader" class="movesDivHeader">
          <table class="movesTableHeader">
            <tr>
              <th>#</th>
              <th><%= t('common.white') %></th>
              <th><%= t('common.black') %></th>
            </tr>
          </table>
        </div>
        <div id="movesDiv" class="movesDiv">

        </div>
      </div>
      <div id="gameNav" class="gameNav">

      </div>
    </div>
  </div>

  <div class="seperator"></div>

  <div id="chessboard" dir="ltr"> </div>

  <div class="seperator"></div>


  <div class="controlPanel">
    <div id="whiteClock" class="sideBlock clock short whiteClock">
      <div id="whiteTurnClock" class="turnClock unvisible"><img src="/images/clock.png" width="24" />
      </div>
      <div id="whiteClockTimeText">05:00:00</div>
    </div>
    <div id="whitePlayersInfo" class="sideBlock playerInfo short">
      <div class="playerInfo-statusWrap">
        <div class="friends-status-dot friends-status-offline" id="whitePlayerStatus" title="" aria-label=""></div>
      </div>
      <div id="whitePlayerName"></div>
      <div id="whitePlayerDiconnectionTimer" class="disconnectionTimer hide"></div>
    </div>
    <div id="blackCapturedPiece" class="sideBlock captureToolsList"></div>
    <div class="messagesContainer">
      <!-- <textarea id="messages" class="messages" readonly>                </textarea> -->
      <div id="messages" class="messages"></div>
      <div class="chatSendLine">
        <label class="a11y-sr-only" for="chatline"><%= t('site.accessibility.chatInput') %></label>
        <input type="text" class="chatline" id="chatline" maxlength="30" aria-label="<%= t('site.accessibility.chatInput') %>" />
        <button type="button" class="sendButton" aria-label="<%= t('site.accessibility.sendChat') %>" onclick="onSendChatButtonClick(event)">
          <img src="/images/whiteSend.png" alt="" />
        </button>
      </div>
    </div>
  </div>

</div>

<section id="options">
</section>

<div id="debugGameId" class="debug-game-id" title="Debug: game identifier">Game ID: <%= typeof gameId !== 'undefined' && gameId != null ? gameId : '(none)' %></div>

  <!-- New game options modal (for Rematch on single player) -->
  <div id="playNowModal" class="play-now-modal" aria-hidden="true">
    <div class="play-now-modal-overlay" onclick="closePlayNowModal()"></div>
    <div class="play-now-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="playNowModalTitle">
      <h2 id="playNowModalTitle" class="play-now-modal-title"><%= t('site.playNow.title') %></h2>
      <form id="playNowForm" class="play-now-form" onsubmit="startNewGameFromModal(event)">
        <div class="play-now-field">
          <label class="play-now-label"><%= t('site.playNow.playingColor') %></label>
          <div class="play-now-radio-group">
            <label class="play-now-radio">
              <input type="radio" name="color" value="white" checked>
              <span><%= t('common.white') %></span>
            </label>
            <label class="play-now-radio">
              <input type="radio" name="color" value="black">
              <span><%= t('common.black') %></span>
            </label>
          </div>
        </div>
        <div class="play-now-field">
          <div class="play-now-engine-time-row">
            <div class="play-now-engine-col">
              <label class="play-now-label" for="playNowEngine"><%= t('common.engine') %></label>
              <select id="playNowEngine" name="engine" class="play-now-select play-now-select--compact">
                <option value="brain43" selected><%= t('play.newGameDialog.brain43') %></option>
                <option value="brain42"><%= t('play.newGameDialog.brain42') %></option>
                <option value="brain41"><%= t('play.newGameDialog.brain41') %></option>
                <option value="brain4"><%= t('play.newGameDialog.brain4') %></option>
                <option value="brain3"><%= t('site.playNow.brain3') %></option>
                <option value="brain2"><%= t('site.playNow.brain2') %></option>
              </select>
            </div>
            <div class="play-now-time-col">
              <label class="play-now-label" for="playNowTimeMinutes"><%= t('site.playNow.timeMin') %></label>
              <input type="number" id="playNowTimeMinutes" name="timeMinutes" class="play-now-time-input" min="1" max="180" step="1" value="90" title="Clock time per side in minutes">
            </div>
          </div>
        </div>
        <div class="play-now-field">
          <label class="play-now-label" for="playNowDifficulty"><%= t('site.playNow.difficulty') %></label>
          <div class="play-now-slider-row">
            <input type="range" min="1" max="6" value="3" name="difficulty" id="playNowDifficulty" class="play-now-slider" oninput="document.getElementById('playNowDifficultyValue').textContent=this.value">
            <span id="playNowDifficultyValue" class="play-now-slider-value">3</span>
          </div>
        </div>
        <div class="play-now-field">
          <label class="play-now-label"><%= t('site.playNow.mousePreference') %></label>
          <div class="play-now-radio-group">
            <label class="play-now-radio" id="mouseDragLabel">
              <input type="radio" name="mouse" value="drag" id="mouseDrag" checked>
              <span><%= t('site.playNow.drag') %></span>
            </label>
            <label class="play-now-radio">
              <input type="radio" name="mouse" value="double" id="mouseDouble">
              <span><%= t('site.playNow.doubleClick') %></span>
            </label>
          </div>
        </div>
        <div class="play-now-field">
          <label class="play-now-checkbox-label">
            <input type="checkbox" name="showMoves" id="playNowShowMoves" value="1" checked>
            <span><%= t('site.playNow.showAvailableMoves') %></span>
          </label>
        </div>
        <div class="play-now-field">
          <label class="play-now-checkbox-label" title="<%= t('site.playNow.privateHint') %>">
            <input type="checkbox" name="private" id="playNowPrivate" value="1">
            <span><%= t('site.playNow.private') %></span>
          </label>
        </div>
        <div class="play-now-modal-actions">
          <button type="button" class="play-now-btn-cancel" onclick="closePlayNowModal()"><%= t('site.cancel') %></button>
          <button type="submit" class="play-now-btn-start"><%= t('common.start') %></button>
        </div>
      </form>
    </div>
  </div>