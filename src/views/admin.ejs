<% layout("../views/layouts/boilerplate") %>
<link rel="stylesheet" href="/assets/welcome.css">

<div class="home admin-page">
  <div class="games-section admin-games-section">
    <div class="games-panel admin-tabbed-panel">
      <div class="panel-header admin-panel-header">
        <div class="panel-title-group admin-panel-title-row">
          <h2 class="panel-title"><%= t('site.adminPage.title') %></h2>
        </div>
        <div class="admin-tab-strip" role="tablist" aria-label="<%= t('site.adminPage.sectionsAria') %>">
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-users" aria-controls="admin-panel-main" aria-selected="true" tabindex="0"><%= t('site.adminPage.users') %></button>
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-games" aria-controls="admin-panel-main" aria-selected="false" tabindex="-1"><%= t('site.adminPage.games') %></button>
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-engines" aria-controls="admin-panel-main" aria-selected="false" tabindex="-1"><%= t('site.adminPage.engines') %></button>
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-states" aria-controls="admin-panel-main" aria-selected="false" tabindex="-1"><%= t('site.adminPage.states') %></button>
        </div>
      </div>
      <div class="panel-body admin-panel-body">
        <div class="admin-tab-toolbar" id="admin-users-toolbar">
          <a href="/register" class="admin-add-user-btn">
            <span class="admin-add-user-icon" aria-hidden="true">+</span>
            <span class="admin-add-user-label"><%= t('site.adminPage.addUser') %></span>
          </a>
        </div>
        <div class="admin-tab-toolbar" id="admin-states-toolbar" hidden>
          <a href="/admin/generate-state" class="admin-add-user-btn">
            <span class="admin-add-user-icon" aria-hidden="true">+</span>
            <span class="admin-add-user-label"><%= t('site.adminPage.generate') %></span>
          </a>
          <p class="admin-opening-book-count" aria-live="polite">
            <%= t('site.adminPage.openingBookLabel') %>
            <strong><%= typeof openingBookEntryCount !== 'undefined' ? openingBookEntryCount : 0 %></strong>
            <%= t('site.adminPage.gameLines') %>
          </p>
        </div>
        <div class="table-scroll compact" id="admin-panel-main" role="tabpanel" aria-labelledby="admin-tab-users">
          <div id="admin-games-empty" class="no-games-message admin-games-empty" hidden>
            <p><%= t('site.adminPage.noGamesInDb') %></p>
          </div>
          <div id="admin-table-shell" class="admin-table-shell">
            <table class="games-table" id="admin-main-table">
              <thead>
                <tr id="admin-table-head-row">
                  <th><%= t('site.adminPage.colNum') %></th>
                  <th><%= t('site.adminPage.colUsername') %></th>
                  <th><%= t('site.adminPage.colType') %></th>
                  <th><%= t('site.adminPage.colEmail') %></th>
                  <th><%= t('site.adminPage.colPassword') %></th>
                  <th><%= t('site.adminPage.colLevel') %></th>
                  <th><%= t('site.adminPage.colElo') %></th>
                  <th><%= t('site.adminPage.colJoined') %></th>
                  <th><%= t('site.adminPage.colLastLogin') %></th>
                  <th><%= t('site.adminPage.colActiveGames') %></th>
                  <th><%= t('site.adminPage.colFriends') %></th>
                  <th><%= t('site.adminPage.colBookmarks') %></th>
                </tr>
              </thead>
              <tbody id="admin-table-body"></tbody>
            </table>
          </div>
          <nav id="admin-games-pages-nav" class="pagesNav admin-games-pages-nav" hidden aria-label="<%= t('site.adminPage.gamesPaginationAria') %>"></nav>
        </div>
      </div>
    </div>
  </div>
</div>

<% var adminUsersJson = JSON.stringify(typeof adminUsers !== "undefined" && adminUsers ? adminUsers : []).replace(/</g, "\\u003c"); %>
<% var adminGamesJson = JSON.stringify(typeof adminGames !== "undefined" && adminGames ? adminGames : []).replace(/</g, "\\u003c"); %>
<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
  window.__ADMIN_USERS__ = <%- adminUsersJson %>;
  window.__ADMIN_GAMES__ = <%- adminGamesJson %>;
  (function () {
    function t(key, params) {
      if (window.ShmerlingStrings && typeof window.ShmerlingStrings.t === "function") {
        return window.ShmerlingStrings.t(key, params);
      }
      return key;
    }
    var ADMIN_TAB_CONFIG = [
      {
        headers: [
          t("site.adminPage.colNum"),
          t("site.adminPage.colUsername"),
          t("site.adminPage.colType"),
          t("site.adminPage.colEmail"),
          t("site.adminPage.colPassword"),
          t("site.adminPage.colLevel"),
          t("site.adminPage.colElo"),
          t("site.adminPage.colJoined"),
          t("site.adminPage.colLastLogin"),
          t("site.adminPage.colActiveGames"),
          t("site.adminPage.colFriends"),
          t("site.adminPage.colBookmarks")
        ],
        emptyMsg: t("site.adminPage.emptyUsers")
      },
      {
        headers: [t("site.adminPage.colNum"), t("site.adminPage.colId"), t("site.adminPage.colType"), t("site.adminPage.colStatus")],
        emptyMsg: t("site.adminPage.emptyData")
      },
      {
        headers: [t("site.adminPage.colNum"), t("site.adminPage.colName"), t("site.adminPage.colAvailable"), t("site.adminPage.colNotes")],
        emptyMsg: t("site.adminPage.emptyData")
      },
      {
        headers: [t("site.adminPage.colNote")],
        emptyMsg: t("site.adminPage.emptyStates")
      }
    ];

    var tabs = document.querySelectorAll(".admin-tab-btn");
    var table = document.getElementById("admin-main-table");
    var headRow = document.getElementById("admin-table-head-row");
    var tbody = document.getElementById("admin-table-body");
    var toolbar = document.getElementById("admin-users-toolbar");
    var toolbarStates = document.getElementById("admin-states-toolbar");
    var panelMain = document.getElementById("admin-panel-main");
    var gamesEmptyEl = document.getElementById("admin-games-empty");
    var tableShell = document.getElementById("admin-table-shell");
    var gamesPagesNav = document.getElementById("admin-games-pages-nav");
    var ADMIN_GAMES_PAGE_SIZE = 20;
    var adminGamesWorking = null;
    var adminGamesPage = 1;

    function formatDateTime(iso) {
      if (!iso) return "—";
      try {
        var d = new Date(iso);
        if (isNaN(d.getTime())) return "—";
        return d.toLocaleString(undefined, { dateStyle: "short", timeStyle: "short" });
      } catch (e) {
        return "—";
      }
    }

    function updateUserInCache(userId, field, value) {
      var list = window.__ADMIN_USERS__;
      if (!list) return;
      for (var j = 0; j < list.length; j++) {
        if (list[j].id === userId) {
          list[j][field] = value;
          return;
        }
      }
    }

    function patchUserField(userId, payload) {
      return axios.patch("/admin/users/" + encodeURIComponent(userId), payload);
    }

    function attachEditableCell(td, userId, field, initialValue) {
      var state = { value: initialValue != null ? String(initialValue) : "" };
      td.classList.add("admin-cell-editable");
      if (field === "email") td.classList.add("admin-cell-email");

      var label = document.createElement("span");
      label.className = "admin-editable-label";
      label.setAttribute("title", t("site.adminPage.clickToEdit"));
      label.setAttribute("tabindex", "0");

      function renderLabel() {
        label.textContent = state.value !== "" ? state.value : "\u2014";
      }
      renderLabel();

      var skipBlur = false;

      function commitEdit() {
        var input = td.querySelector("input.admin-editable-input");
        if (!input) return;
        var newVal = input.value.trim();
        input.remove();
        label.style.display = "";
        if (newVal === state.value) {
          renderLabel();
          return;
        }
        var payload = {};
        payload[field] = newVal;
        patchUserField(userId, payload)
          .then(function (res) {
            var data = res.data;
            if (data && data.ok && data.user) {
              if (field === "username") state.value = data.user.username || "";
              else state.value = data.user.email != null ? String(data.user.email) : "";
              updateUserInCache(userId, field === "username" ? "username" : "email", state.value);
            }
            renderLabel();
          })
          .catch(function (err) {
            var msg = t("site.adminPage.updateFailed");
            if (err.response && err.response.data && err.response.data.message) msg = err.response.data.message;
            showSiteAlert(msg, t("site.adminPage.couldNotSave")).then(function () {
              renderLabel();
            });
          });
      }

      function startEdit() {
        if (td.querySelector("input.admin-editable-input")) return;
        var inp = document.createElement("input");
        inp.type = field === "email" ? "email" : "text";
        inp.className = "admin-editable-input";
        inp.value = state.value;
        inp.autocomplete = "off";
        label.style.display = "none";
        td.appendChild(inp);
        inp.focus();
        inp.select();

        inp.addEventListener("keydown", function (e) {
          if (e.key === "Enter") {
            e.preventDefault();
            inp.blur();
          }
          if (e.key === "Escape") {
            e.preventDefault();
            skipBlur = true;
            inp.remove();
            label.style.display = "";
            renderLabel();
          }
        });
        inp.addEventListener("blur", function onBlur() {
          if (skipBlur) {
            skipBlur = false;
            return;
          }
          commitEdit();
        });
      }

      label.addEventListener("click", function (e) {
        e.stopPropagation();
        startEdit();
      });
      label.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          startEdit();
        }
      });

      td.appendChild(label);
    }

    function attachPasswordCell(td, userId) {
      td.classList.add("admin-cell-editable");
      var label = document.createElement("span");
      label.className = "admin-editable-label admin-password-label";
      label.setAttribute("title", t("site.adminPage.setPasswordTitle"));
      label.setAttribute("tabindex", "0");

      function setLabelDefault() {
        label.textContent = t("site.adminPage.setPassword");
      }
      setLabelDefault();

      var skipBlur = false;

      function trySave(inp) {
        if (!inp || !inp.parentNode) return;
        var v = inp.value;
        inp.remove();
        label.style.display = "";
        var trimmed = v.trim();
        if (!trimmed) {
          setLabelDefault();
          return;
        }
        if (trimmed.length < 4 || trimmed.length > 30) {
          showSiteAlert(t("site.adminPage.passwordLengthInvalid"), t("site.adminPage.invalidPassword")).then(function () {
            setLabelDefault();
          });
          return;
        }
        patchUserField(userId, { password: trimmed })
          .then(function (res) {
            if (res.data && res.data.ok) {
              label.textContent = t("site.adminPage.saved");
              setTimeout(setLabelDefault, 2000);
            } else {
              setLabelDefault();
            }
          })
          .catch(function (err) {
            var msg = t("site.adminPage.updateFailed");
            if (err.response && err.response.data && err.response.data.message) msg = err.response.data.message;
            showSiteAlert(msg, t("site.adminPage.couldNotSave")).then(function () {
              setLabelDefault();
            });
          });
      }

      function startEdit() {
        if (td.querySelector("input.admin-password-input")) return;
        var inp = document.createElement("input");
        inp.type = "password";
        inp.className = "admin-editable-input admin-password-input";
        inp.autocomplete = "new-password";
        inp.maxLength = 30;
        inp.placeholder = t("site.adminPage.newPasswordPlaceholder");
        label.style.display = "none";
        td.appendChild(inp);
        inp.focus();

        inp.addEventListener("keydown", function (e) {
          if (e.key === "Enter") {
            e.preventDefault();
            skipBlur = true;
            trySave(inp);
            setTimeout(function () { skipBlur = false; }, 0);
          }
          if (e.key === "Escape") {
            e.preventDefault();
            skipBlur = true;
            inp.remove();
            label.style.display = "";
            setLabelDefault();
            setTimeout(function () { skipBlur = false; }, 0);
          }
        });
        inp.addEventListener("blur", function () {
          setTimeout(function () {
            if (skipBlur) return;
            if (inp.parentNode) trySave(inp);
          }, 120);
        });
      }

      label.addEventListener("click", function (e) {
        e.stopPropagation();
        startEdit();
      });
      label.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          startEdit();
        }
      });

      td.appendChild(label);
    }

    var PLAYER_LEVELS = [
      { value: "Rookie", label: t("site.register.rookie") },
      { value: "Skilled", label: t("site.register.skilled") },
      { value: "Elite", label: t("site.register.elite") },
      { value: "Grand Master", label: t("site.register.grandMaster") },
    ];

    var USER_TYPES = [
      { value: "Admin", label: t("site.adminPage.userTypeAdmin") },
      { value: "Partner", label: t("site.adminPage.userTypePartner") },
      { value: "Member", label: t("site.adminPage.userTypeMember") },
    ];

    function userTypeLabel(value) {
      for (var i = 0; i < USER_TYPES.length; i++) {
        if (USER_TYPES[i].value === value) return USER_TYPES[i].label;
      }
      return value || t("site.adminPage.userTypeMember");
    }

    function playerLevelLabel(value) {
      for (var i = 0; i < PLAYER_LEVELS.length; i++) {
        if (PLAYER_LEVELS[i].value === value) return PLAYER_LEVELS[i].label;
      }
      return value || "";
    }

    function attachRoleDropdown(td, userId, userType) {
      var known = false;
      for (var ui = 0; ui < USER_TYPES.length; ui++) {
        if (USER_TYPES[ui].value === userType) { known = true; break; }
      }
      var state = {
        userType: known ? userType : "Member",
      };
      td.classList.add("admin-cell-editable");
      var label = document.createElement("span");
      label.className = "admin-editable-label";
      label.setAttribute("title", t("site.adminPage.clickChangeUserType"));
      label.setAttribute("tabindex", "0");

      function renderLabel() {
        label.textContent = userTypeLabel(state.userType);
      }
      renderLabel();

      function removeSelect(sel) {
        if (sel && sel.parentNode) sel.remove();
        label.style.display = "";
        renderLabel();
      }

      function startEdit() {
        if (td.querySelector("select.admin-role-select")) return;
        var sel = document.createElement("select");
        sel.className = "admin-editable-select admin-role-select";
        sel.setAttribute("aria-label", t("site.adminPage.userTypeAria"));
        USER_TYPES.forEach(function (typeOpt) {
          var o = document.createElement("option");
          o.value = typeOpt.value;
          o.textContent = typeOpt.label;
          if (typeOpt.value === state.userType) o.selected = true;
          sel.appendChild(o);
        });
        label.style.display = "none";
        td.appendChild(sel);
        sel.focus();

        var patching = false;

        sel.addEventListener("change", function () {
          var newType = sel.value;
          if (newType === state.userType) return;
          var msg = newType === "Admin"
            ? t("site.adminPage.grantAdminConfirm")
            : state.userType === "Admin"
              ? t("site.adminPage.demoteAdminConfirm", { type: userTypeLabel(newType) })
              : t("site.adminPage.changeUserTypeConfirm", { type: userTypeLabel(newType) });
          showSiteConfirm(msg, { title: t("site.adminPage.changeUserTypeTitle") }).then(function (ok) {
            if (!ok) {
              sel.value = state.userType;
              return;
            }
            patching = true;
            patchUserField(userId, { userType: newType })
              .then(function (res) {
                var data = res.data;
                if (data && data.ok && data.user) {
                  state.userType = data.user.userType || newType;
                  updateUserInCache(userId, "userType", state.userType);
                  updateUserInCache(userId, "admin", !!data.user.admin);
                }
                removeSelect(sel);
              })
              .catch(function (err) {
                var errMsg = t("site.adminPage.updateFailed");
                if (err.response && err.response.data && err.response.data.message) errMsg = err.response.data.message;
                showSiteAlert(errMsg, t("site.adminPage.couldNotSave")).then(function () {
                  sel.value = state.userType;
                });
              })
              .finally(function () {
                patching = false;
              });
          });
        });

        sel.addEventListener("keydown", function (e) {
          if (e.key === "Escape") {
            e.preventDefault();
            removeSelect(sel);
          }
        });

        sel.addEventListener("blur", function () {
          setTimeout(function () {
            if (patching) return;
            if (sel.parentNode) removeSelect(sel);
          }, 200);
        });
      }

      label.addEventListener("click", function (e) {
        e.stopPropagation();
        startEdit();
      });
      label.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          startEdit();
        }
      });

      td.appendChild(label);
    }

    function attachLevelDropdown(td, userId, levelStr) {
      var state = { level: levelStr != null ? String(levelStr) : "" };
      td.classList.add("admin-cell-editable");
      var label = document.createElement("span");
      label.className = "admin-editable-label";
      label.setAttribute("title", t("site.adminPage.clickChangeLevel"));
      label.setAttribute("tabindex", "0");

      function renderLabel() {
        label.textContent = state.level !== "" ? playerLevelLabel(state.level) : "\u2014";
      }
      renderLabel();

      function removeSelect(sel) {
        if (sel && sel.parentNode) sel.remove();
        label.style.display = "";
        renderLabel();
      }

      function levelKnown(value) {
        for (var i = 0; i < PLAYER_LEVELS.length; i++) {
          if (PLAYER_LEVELS[i].value === value) return true;
        }
        return false;
      }

      function startEdit() {
        if (td.querySelector("select.admin-level-select")) return;
        var sel = document.createElement("select");
        sel.className = "admin-editable-select admin-level-select";
        sel.setAttribute("aria-label", t("site.adminPage.playerLevelAria"));
        PLAYER_LEVELS.forEach(function (lv) {
          var o = document.createElement("option");
          o.value = lv.value;
          o.textContent = lv.label;
          if (lv.value === state.level) o.selected = true;
          sel.appendChild(o);
        });
        if (state.level && !levelKnown(state.level)) {
          var oExtra = document.createElement("option");
          oExtra.value = state.level;
          oExtra.textContent = state.level;
          oExtra.selected = true;
          sel.insertBefore(oExtra, sel.firstChild);
        }
        label.style.display = "none";
        td.appendChild(sel);
        sel.focus();

        var patching = false;

        sel.addEventListener("change", function () {
          var newLevel = sel.value;
          if (newLevel === state.level) {
            removeSelect(sel);
            return;
          }
          patching = true;
          patchUserField(userId, { level: newLevel })
            .then(function (res) {
              var data = res.data;
              if (data && data.ok && data.user) {
                state.level = data.user.level != null ? String(data.user.level) : "";
                updateUserInCache(userId, "level", state.level);
              }
              removeSelect(sel);
            })
            .catch(function (err) {
              var msg = t("site.adminPage.updateFailed");
              if (err.response && err.response.data && err.response.data.message) msg = err.response.data.message;
              showSiteAlert(msg, t("site.adminPage.couldNotSave")).then(function () {
                sel.value = state.level && levelKnown(state.level) ? state.level : PLAYER_LEVELS[0].value;
              });
            })
            .finally(function () {
              patching = false;
            });
        });

        sel.addEventListener("keydown", function (e) {
          if (e.key === "Escape") {
            e.preventDefault();
            removeSelect(sel);
          }
        });

        sel.addEventListener("blur", function () {
          setTimeout(function () {
            if (patching) return;
            if (sel.parentNode) removeSelect(sel);
          }, 200);
        });
      }

      label.addEventListener("click", function (e) {
        e.stopPropagation();
        startEdit();
      });
      label.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          startEdit();
        }
      });

      td.appendChild(label);
    }

    function renderUsersRows(users) {
      var colCount = ADMIN_TAB_CONFIG[0].headers.length;
      tbody.innerHTML = "";
      if (!users || users.length === 0) {
        var trEmpty = document.createElement("tr");
        trEmpty.className = "admin-table-empty-row";
        var tdEmpty = document.createElement("td");
        tdEmpty.colSpan = colCount;
        tdEmpty.className = "admin-table-empty mute";
        tdEmpty.textContent = ADMIN_TAB_CONFIG[0].emptyMsg;
        trEmpty.appendChild(tdEmpty);
        tbody.appendChild(trEmpty);
        return;
      }
      users.forEach(function (u, i) {
        var tr = document.createElement("tr");
        tr.className = "admin-user-row";
        var tdNum = document.createElement("td");
        tdNum.className = "row-number";
        tdNum.textContent = String(i + 1);
        var tdName = document.createElement("td");
        attachEditableCell(tdName, u.id, "username", u.username);
        var tdRole = document.createElement("td");
        attachRoleDropdown(tdRole, u.id, u.userType || (u.admin ? "Admin" : "Member"));
        var tdEmail = document.createElement("td");
        attachEditableCell(tdEmail, u.id, "email", u.email);
        var tdPwd = document.createElement("td");
        attachPasswordCell(tdPwd, u.id);
        var tdLevel = document.createElement("td");
        attachLevelDropdown(tdLevel, u.id, u.level);
        var tdElo = document.createElement("td");
        tdElo.textContent = u.elo != null && u.elo !== "" ? String(u.elo) : "—";
        var tdJoined = document.createElement("td");
        tdJoined.textContent = formatDateTime(u.joinedDate);
        var tdLogin = document.createElement("td");
        tdLogin.textContent = formatDateTime(u.lastLogin);
        var tdActive = document.createElement("td");
        tdActive.textContent = u.activeGamesCount != null ? String(u.activeGamesCount) : "0";
        var tdFriends = document.createElement("td");
        tdFriends.textContent = u.friendsCount != null ? String(u.friendsCount) : "0";
        var tdBm = document.createElement("td");
        tdBm.textContent = u.bookmarksCount != null ? String(u.bookmarksCount) : "0";
        tr.appendChild(tdNum);
        tr.appendChild(tdName);
        tr.appendChild(tdRole);
        tr.appendChild(tdEmail);
        tr.appendChild(tdPwd);
        tr.appendChild(tdLevel);
        tr.appendChild(tdElo);
        tr.appendChild(tdJoined);
        tr.appendChild(tdLogin);
        tr.appendChild(tdActive);
        tr.appendChild(tdFriends);
        tr.appendChild(tdBm);
        tbody.appendChild(tr);
      });
    }

    var adminGamesSortState = { key: null, asc: true };

    function initAdminGamesWorking() {
      try {
        var raw = window.__ADMIN_GAMES__ || [];
        adminGamesWorking = JSON.parse(JSON.stringify(raw));
      } catch (e) {
        adminGamesWorking = [];
      }
      adminGamesPage = 1;
      adminGamesSortState = { key: null, asc: true };
    }

    function valueForSort(game, key) {
      if (key === "rowIndex") return game._sortIdx != null ? game._sortIdx : 0;
      if (key === "Date") return game._sortableDate != null ? game._sortableDate : 0;
      if (key === "Moves") return game.Moves != null ? Number(game.Moves) : 0;
      var v = game[key];
      return v != null ? String(v) : "";
    }

    function compareSortValues(va, vb) {
      var na = typeof va === "number" && !isNaN(va);
      var nb = typeof vb === "number" && !isNaN(vb);
      if (na && nb) return va - vb;
      if (na) return -1;
      if (nb) return 1;
      return String(va).localeCompare(String(vb));
    }

    function sortGamesWorking(key, asc) {
      if (!adminGamesWorking || !adminGamesWorking.length) return;
      adminGamesWorking.forEach(function (g, i) {
        g._sortIdx = i;
      });
      adminGamesWorking.sort(function (a, b) {
        var va = valueForSort(a, key);
        var vb = valueForSort(b, key);
        var cmp = compareSortValues(va, vb);
        return asc ? cmp : -cmp;
      });
    }

    function syncAdminGamesSortIcons() {
      if (!adminGamesSortState.key || !headRow) return;
      var key = adminGamesSortState.key;
      var th = headRow.querySelector("th.sortable-th[data-sort-key=\"" + key.replace(/\\/g, "\\\\").replace(/"/g, '\\"') + "\"]");
      if (!th) return;
      headRow.querySelectorAll(".sort-icon").forEach(function (icon) {
        icon.textContent = "";
        icon.classList.remove("asc", "desc");
      });
      var activeIcon = th.querySelector(".sort-icon");
      if (activeIcon) {
        activeIcon.textContent = adminGamesSortState.asc ? "\u25B2" : "\u25BC";
        activeIcon.classList.add(adminGamesSortState.asc ? "asc" : "desc");
      }
    }

    function renderAdminGamesPagination() {
      if (!gamesPagesNav) return;
      var total = (adminGamesWorking && adminGamesWorking.length) || 0;
      if (total === 0) {
        gamesPagesNav.hidden = true;
        gamesPagesNav.innerHTML = "";
        return;
      }
      var totalPages = Math.max(1, Math.ceil(total / ADMIN_GAMES_PAGE_SIZE));
      if (adminGamesPage > totalPages) adminGamesPage = totalPages;
      if (adminGamesPage < 1) adminGamesPage = 1;
      var page = adminGamesPage;
      var windowSize = 10;
      var startPage = Math.floor((page - 1) / windowSize) * windowSize + 1;
      var endPage = Math.min(startPage + windowSize - 1, totalPages);
      var prev10Page = Math.max(1, startPage - windowSize);
      var next10Page = Math.min(totalPages, startPage + windowSize);
      var smallWindowSize = 5;
      var startPage5 = Math.floor((page - 1) / smallWindowSize) * smallWindowSize + 1;
      var endPage5 = Math.min(startPage5 + smallWindowSize - 1, totalPages);
      var prev5Page = Math.max(1, startPage5 - smallWindowSize);
      var next5Page = Math.min(totalPages, startPage5 + smallWindowSize);

      var parts = [];
      function link(dataPage, inner, className, title) {
        var cls = className ? " class=\"" + className + "\"" : "";
        var tit = title ? " title=\"" + String(title).replace(/"/g, "&quot;") + "\"" : "";
        parts.push("<a href=\"#\"" + cls + tit + " data-admin-page=\"" + dataPage + "\">" + inner + "</a>");
      }
      link(1, t("site.adminPage.first"));
      if (startPage > 1) {
        link(prev10Page, "<img src=\"/images/prev.png\" alt=\"" + t("site.adminPage.previous") + "\">", "pageNavIcon pageNavStep10", t("site.adminPage.previous10Pages"));
      }
      if (startPage5 > 1) {
        link(prev5Page, "<img src=\"/images/prev.png\" alt=\"" + t("site.adminPage.previous") + "\">", "pageNavIcon pageNavStep5", t("site.adminPage.previous5Pages"));
      }
      var i;
      for (i = startPage5; i <= endPage5; i++) {
        var cls5 = "pageNavItem pageNavWindow5" + (i === page ? " selectedPage" : "");
        link(i, String(i), cls5);
      }
      for (i = startPage; i <= endPage; i++) {
        var cls10 = "pageNavItem pageNavWindow10" + (i === page ? " selectedPage" : "");
        link(i, String(i), cls10);
      }
      if (endPage5 < totalPages) {
        link(next5Page, "<img src=\"/images/next.png\" alt=\"" + t("site.adminPage.next") + "\">", "pageNavIcon pageNavStep5", t("site.adminPage.next5Pages"));
      }
      if (endPage < totalPages) {
        link(next10Page, "<img src=\"/images/next.png\" alt=\"" + t("site.adminPage.next") + "\">", "pageNavIcon pageNavStep10", t("site.adminPage.next10Pages"));
      }
      link(totalPages, t("site.adminPage.last"));
      gamesPagesNav.innerHTML = parts.join("");
      gamesPagesNav.hidden = false;
    }

    function attachAdminGamesPaginationOnce() {
      if (attachAdminGamesPaginationOnce.done) return;
      attachAdminGamesPaginationOnce.done = true;
      if (!gamesPagesNav) return;
      gamesPagesNav.addEventListener("click", function (ev) {
        var t = ev.target.closest("a[data-admin-page]");
        if (!t || !gamesPagesNav.contains(t)) return;
        ev.preventDefault();
        var p = parseInt(t.getAttribute("data-admin-page"), 10);
        if (isNaN(p) || p < 1) return;
        var total = (adminGamesWorking && adminGamesWorking.length) || 0;
        var totalPages = Math.max(1, Math.ceil(total / ADMIN_GAMES_PAGE_SIZE));
        if (p > totalPages) p = totalPages;
        adminGamesPage = p;
        renderGamesListTable();
      });
    }

    function gameRowKeys(obj) {
      var keys = [];
      for (var k in obj) {
        if (Object.prototype.hasOwnProperty.call(obj, k) && k !== "Id" && k.charAt(0) !== "_") keys.push(k);
      }
      return keys;
    }

    function gameIdStr(obj) {
      var id = obj.Id;
      if (id == null) return "";
      return typeof id === "object" && id.toString ? id.toString() : String(id);
    }

    function updateFormsSortInputs() {
      document.querySelectorAll("#admin-panel-main .list-delete-form").forEach(function (form) {
        var keyInput = form.querySelector("input[name=\"sortKey\"]");
        var orderInput = form.querySelector("input[name=\"sortOrder\"]");
        if (keyInput) keyInput.value = adminGamesSortState.key || "";
        if (orderInput) orderInput.value = adminGamesSortState.key ? (adminGamesSortState.asc ? "asc" : "desc") : "";
      });
    }

    function renderGamesListTable() {
      if (!table || !headRow || !tbody) return;
      headRow.innerHTML = "";
      tbody.innerHTML = "";
      if (gamesEmptyEl) {
        gamesEmptyEl.hidden = true;
        gamesEmptyEl.style.display = "none";
      }
      if (tableShell) tableShell.style.display = "";
      table.style.display = "";
      if (gamesPagesNav) {
        gamesPagesNav.hidden = true;
        gamesPagesNav.innerHTML = "";
      }

      var games = adminGamesWorking || [];
      if (!games.length) {
        adminGamesSortState = { key: null, asc: true };
        table.style.display = "none";
        if (tableShell) tableShell.style.display = "none";
        if (gamesEmptyEl) {
          gamesEmptyEl.hidden = false;
          gamesEmptyEl.style.display = "";
        }
        return;
      }

      var keys = gameRowKeys(games[0]);

      var thNum = document.createElement("th");
      thNum.className = "sortable-th";
      thNum.setAttribute("data-sort-key", "rowIndex");
      thNum.title = t("site.adminPage.sortByRowNumber");
      thNum.innerHTML = "<span class=\"th-label\">" + t("site.adminPage.colNum") + "</span><span class=\"sort-icon\" aria-hidden=\"true\"></span>";
      headRow.appendChild(thNum);

      keys.forEach(function (key) {
        var th = document.createElement("th");
        th.className = "sortable-th";
        var trimKey = key.replace(/^\s+/, "").replace(/\s+$/, "");
        th.setAttribute("data-sort-key", trimKey);
        th.title = t("site.adminPage.sortBy", { key: trimKey });
        var spanL = document.createElement("span");
        spanL.className = "th-label";
        spanL.textContent = key;
        var spanI = document.createElement("span");
        spanI.className = "sort-icon";
        spanI.setAttribute("aria-hidden", "true");
        th.appendChild(spanL);
        th.appendChild(spanI);
        headRow.appendChild(th);
      });

      var thAct = document.createElement("th");
      thAct.textContent = t("site.adminPage.colAction");
      headRow.appendChild(thAct);

      var total = games.length;
      var start = (adminGamesPage - 1) * ADMIN_GAMES_PAGE_SIZE;
      var slice = games.slice(start, start + ADMIN_GAMES_PAGE_SIZE);

      slice.forEach(function (obj, i) {
        var idStr = gameIdStr(obj);
        var globalIdx = start + i;
        var tr = document.createElement("tr");
        tr.setAttribute("data-row-index", String(globalIdx));

        var tdNum = document.createElement("td");
        tdNum.className = "sortable-td";
        tdNum.setAttribute("data-sort-key", "rowIndex");
        tdNum.setAttribute("data-sort-value", String(globalIdx));
        tdNum.textContent = String(globalIdx + 1);
        tdNum.onclick = function () { window.location = "/review?type=history&id=" + encodeURIComponent(idStr); };
        tr.appendChild(tdNum);

        keys.forEach(function (key) {
          var sortVal;
          if (key === "Date") sortVal = obj._sortableDate != null ? obj._sortableDate : 0;
          else if (key === "Moves") sortVal = obj.Moves != null ? obj.Moves : 0;
          else sortVal = obj[key] != null ? String(obj[key]) : "";

          var td = document.createElement("td");
          var trimKey = key.replace(/^\s+/, "").replace(/\s+$/, "");
          td.setAttribute("data-sort-key", trimKey);
          td.setAttribute("data-sort-value", String(sortVal));
          if (trimKey === "Reason") td.className = "align-left sortable-td";
          else td.className = "sortable-td";
          td.onclick = function () { window.location = "/review?type=history&id=" + encodeURIComponent(idStr); };
          td.textContent = obj[key] != null ? String(obj[key]) : "";
          tr.appendChild(td);
        });

        var tdAct = document.createElement("td");
        tdAct.className = "no-sort";
        var form = document.createElement("form");
        form.action = "/list/" + encodeURIComponent(idStr) + "?_method=delete";
        form.method = "POST";
        form.className = "list-delete-form";
        var hi = document.createElement("input");
        hi.type = "hidden";
        hi.name = "sortKey";
        hi.value = "";
        form.appendChild(hi);
        var ho = document.createElement("input");
        ho.type = "hidden";
        ho.name = "sortOrder";
        ho.value = "";
        form.appendChild(ho);
        var hret = document.createElement("input");
        hret.type = "hidden";
        hret.name = "returnTo";
        hret.value = "/admin";
        form.appendChild(hret);
        var a = document.createElement("a");
        a.href = "#";
        a.textContent = t("site.adminPage.delete");
        a.onclick = function () { form.submit(); return false; };
        form.appendChild(a);
        tdAct.appendChild(form);
        tr.appendChild(tdAct);

        tbody.appendChild(tr);
      });

      syncAdminGamesSortIcons();
      updateFormsSortInputs();
      renderAdminGamesPagination();
    }

    function attachAdminGamesSortOnce() {
      if (attachAdminGamesSortOnce.done) return;
      attachAdminGamesSortOnce.done = true;

      panelMain.addEventListener("click", function (ev) {
        if (!panelMain.classList.contains("admin-games-list-mode")) return;
        var tbl = document.getElementById("admin-main-table");
        if (!tbl || !tbl.classList.contains("sortable")) return;
        var th = ev.target.closest("th.sortable-th");
        if (!th || !tbl.contains(th)) return;
        ev.preventDefault();
        var key = th.getAttribute("data-sort-key");
        if (adminGamesSortState.key === key) adminGamesSortState.asc = !adminGamesSortState.asc;
        else {
          adminGamesSortState.key = key;
          adminGamesSortState.asc = true;
        }
        sortGamesWorking(key, adminGamesSortState.asc);
        adminGamesPage = 1;
        renderGamesListTable();
      });
    }

    function renderTableForTab(index) {
      var cfg = ADMIN_TAB_CONFIG[index];
      if (!cfg || !headRow || !tbody || !table) return;

      if (toolbar) toolbar.hidden = index !== 0;
      if (toolbarStates) toolbarStates.hidden = index !== 3;

      if (index === 1) {
        panelMain.classList.add("admin-games-list-mode");
        table.className = "games-table sortable";
        initAdminGamesWorking();
        renderGamesListTable();
        attachAdminGamesSortOnce();
        attachAdminGamesPaginationOnce();
        return;
      }

      panelMain.classList.remove("admin-games-list-mode");
      if (tableShell) {
        tableShell.style.display = "";
      }
      if (gamesPagesNav) {
        gamesPagesNav.hidden = true;
        gamesPagesNav.innerHTML = "";
      }
      table.className = "games-table";
      table.style.display = "";
      if (gamesEmptyEl) {
        gamesEmptyEl.hidden = true;
        gamesEmptyEl.style.display = "none";
      }

      headRow.innerHTML = "";
      cfg.headers.forEach(function (label) {
        var th = document.createElement("th");
        th.textContent = label;
        headRow.appendChild(th);
      });

      if (index === 0) {
        renderUsersRows(window.__ADMIN_USERS__ || []);
      } else {
        var n = cfg.headers.length;
        tbody.innerHTML = "";
        var tr = document.createElement("tr");
        tr.className = "admin-table-empty-row";
        var td = document.createElement("td");
        td.colSpan = n;
        td.className = "admin-table-empty mute";
        td.textContent = cfg.emptyMsg;
        tr.appendChild(td);
        tbody.appendChild(tr);
      }
    }

    function selectTab(index) {
      tabs.forEach(function (tab, i) {
        var on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        if (on) tab.classList.add("admin-tab-btn--active");
        else tab.classList.remove("admin-tab-btn--active");
      });
      renderTableForTab(index);
      if (panelMain && tabs[index]) panelMain.setAttribute("aria-labelledby", tabs[index].id);
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener("click", function () { selectTab(i); });
      tab.addEventListener("keydown", function (e) {
        var next = null;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") next = (i + 1) % tabs.length;
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next !== null) {
          e.preventDefault();
          selectTab(next);
          tabs[next].focus();
        }
      });
    });
    var urlParams = new URLSearchParams(window.location.search);
    var tabQ = urlParams.get("tab");
    var startTab = 0;
    if (tabQ === "games") startTab = 1;
    else if (tabQ === "engines") startTab = 2;
    else if (tabQ === "states") startTab = 3;
    selectTab(startTab);
    if (tabQ) {
      try {
        window.history.replaceState({}, "", window.location.pathname);
      } catch (e) { /* ignore */ }
    }
  })();
</script>
