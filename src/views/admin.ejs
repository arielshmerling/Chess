<% layout("../views/layouts/boilerplate") %>
<link rel="stylesheet" href="/assets/welcome.css">

<div class="home admin-page">
  <div class="games-section admin-games-section">
    <div class="games-panel admin-tabbed-panel">
      <div class="panel-header admin-panel-header">
        <div class="panel-title-group admin-panel-title-row">
          <h2 class="panel-title">Admin</h2>
        </div>
        <div class="admin-tab-strip" role="tablist" aria-label="Admin sections">
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-users" aria-controls="admin-panel-main" aria-selected="true" tabindex="0">Users</button>
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-games" aria-controls="admin-panel-main" aria-selected="false" tabindex="-1">Games</button>
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-engines" aria-controls="admin-panel-main" aria-selected="false" tabindex="-1">Engines</button>
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-log" aria-controls="admin-panel-main" aria-selected="false" tabindex="-1">Log</button>
        </div>
      </div>
      <div class="panel-body admin-panel-body">
        <div class="admin-tab-toolbar" id="admin-users-toolbar">
          <a href="/register" class="admin-add-user-btn">
            <span class="admin-add-user-icon" aria-hidden="true">+</span>
            <span class="admin-add-user-label">Add user</span>
          </a>
        </div>
        <div class="table-scroll compact" id="admin-panel-main" role="tabpanel" aria-labelledby="admin-tab-users">
          <table class="games-table" id="admin-main-table">
            <thead>
              <tr id="admin-table-head-row">
                <th>#</th>
                <th>Username</th>
                <th>Role</th>
                <th>Email</th>
                <th>Level</th>
                <th>Elo</th>
                <th>Joined</th>
                <th>Last login</th>
                <th>Active games</th>
                <th>Friends</th>
                <th>Bookmarks</th>
              </tr>
            </thead>
            <tbody id="admin-table-body"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="admin-confirm-overlay" class="admin-confirm-overlay" aria-hidden="true">
  <div class="admin-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="admin-confirm-title">
    <h3 id="admin-confirm-title" class="admin-confirm-title">Confirm</h3>
    <p id="admin-confirm-message" class="admin-confirm-message"></p>
    <div class="admin-confirm-actions">
      <button type="button" class="button admin-confirm-cancel">Cancel</button>
      <button type="button" class="button admin-confirm-ok">Confirm</button>
    </div>
  </div>
</div>

<% var adminUsersJson = JSON.stringify(typeof adminUsers !== "undefined" && adminUsers ? adminUsers : []).replace(/</g, "\\u003c"); %>
<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
  window.__ADMIN_USERS__ = <%- adminUsersJson %>;
  (function () {
    var ADMIN_TAB_CONFIG = [
      {
        toolbar: true,
        headers: ["#", "Username", "Role", "Email", "Level", "Elo", "Joined", "Last login", "Active games", "Friends", "Bookmarks"],
        emptyMsg: "No users yet."
      },
      { toolbar: false, headers: ["#", "Id", "Type", "Status"], emptyMsg: "No data yet." },
      { toolbar: false, headers: ["#", "Name", "Available", "Notes"], emptyMsg: "No data yet." },
      { toolbar: false, headers: ["Time", "Level", "Message"], emptyMsg: "No log entries yet." }
    ];

    var tabs = document.querySelectorAll(".admin-tab-btn");
    var headRow = document.getElementById("admin-table-head-row");
    var tbody = document.getElementById("admin-table-body");
    var toolbar = document.getElementById("admin-users-toolbar");
    var panelMain = document.getElementById("admin-panel-main");

    function formatDateTime(iso) {
      if (!iso) return "—";
      try {
        var d = new Date(iso);
        if (isNaN(d.getTime())) return "—";
        return d.toLocaleString(undefined, { dateStyle: "short", timeStyle: "short" });
      } catch (e) {
        return "—";
      }
    }

    function updateUserInCache(userId, field, value) {
      var list = window.__ADMIN_USERS__;
      if (!list) return;
      for (var j = 0; j < list.length; j++) {
        if (list[j].id === userId) {
          list[j][field] = value;
          return;
        }
      }
    }

    function patchUserField(userId, payload) {
      return axios.patch("/admin/users/" + encodeURIComponent(userId), payload);
    }

    function showAdminConfirm(message, title) {
      return new Promise(function (resolve) {
        var overlay = document.getElementById("admin-confirm-overlay");
        var titleEl = document.getElementById("admin-confirm-title");
        var msgEl = document.getElementById("admin-confirm-message");
        var btnOk = overlay && overlay.querySelector(".admin-confirm-ok");
        var btnCancel = overlay && overlay.querySelector(".admin-confirm-cancel");
        if (!overlay || !titleEl || !msgEl || !btnOk || !btnCancel) {
          resolve(window.confirm(message));
          return;
        }
        titleEl.textContent = title || "Confirm";
        msgEl.textContent = message;
        var prevOverflow = document.body.style.overflow;
        document.body.style.overflow = "hidden";
        overlay.classList.add("admin-confirm-overlay--open");
        overlay.setAttribute("aria-hidden", "false");

        function cleanup() {
          document.body.style.overflow = prevOverflow;
          overlay.classList.remove("admin-confirm-overlay--open");
          overlay.setAttribute("aria-hidden", "true");
          document.removeEventListener("keydown", onKey);
          overlay.removeEventListener("click", onOverlayClick);
          btnOk.removeEventListener("click", onOk);
          btnCancel.removeEventListener("click", onCancel);
        }

        function onOk() {
          cleanup();
          resolve(true);
        }
        function onCancel() {
          cleanup();
          resolve(false);
        }
        function onKey(e) {
          if (e.key === "Escape") {
            e.preventDefault();
            onCancel();
          }
        }
        function onOverlayClick(e) {
          if (e.target === overlay) onCancel();
        }

        btnOk.addEventListener("click", onOk);
        btnCancel.addEventListener("click", onCancel);
        document.addEventListener("keydown", onKey);
        overlay.addEventListener("click", onOverlayClick);
        btnOk.focus();
      });
    }

    function attachEditableCell(td, userId, field, initialValue) {
      var state = { value: initialValue != null ? String(initialValue) : "" };
      td.classList.add("admin-cell-editable");
      if (field === "email") td.classList.add("admin-cell-email");

      var label = document.createElement("span");
      label.className = "admin-editable-label";
      label.setAttribute("title", "Click to edit");
      label.setAttribute("tabindex", "0");

      function renderLabel() {
        label.textContent = state.value !== "" ? state.value : "\u2014";
      }
      renderLabel();

      var skipBlur = false;

      function commitEdit() {
        var input = td.querySelector("input.admin-editable-input");
        if (!input) return;
        var newVal = input.value.trim();
        input.remove();
        label.style.display = "";
        if (newVal === state.value) {
          renderLabel();
          return;
        }
        var payload = {};
        payload[field] = newVal;
        patchUserField(userId, payload)
          .then(function (res) {
            var data = res.data;
            if (data && data.ok && data.user) {
              if (field === "username") state.value = data.user.username || "";
              else state.value = data.user.email != null ? String(data.user.email) : "";
              updateUserInCache(userId, field === "username" ? "username" : "email", state.value);
            }
            renderLabel();
          })
          .catch(function (err) {
            var msg = "Update failed";
            if (err.response && err.response.data && err.response.data.message) msg = err.response.data.message;
            alert(msg);
            renderLabel();
          });
      }

      function startEdit() {
        if (td.querySelector("input.admin-editable-input")) return;
        var inp = document.createElement("input");
        inp.type = field === "email" ? "email" : "text";
        inp.className = "admin-editable-input";
        inp.value = state.value;
        inp.autocomplete = "off";
        label.style.display = "none";
        td.appendChild(inp);
        inp.focus();
        inp.select();

        inp.addEventListener("keydown", function (e) {
          if (e.key === "Enter") {
            e.preventDefault();
            inp.blur();
          }
          if (e.key === "Escape") {
            e.preventDefault();
            skipBlur = true;
            inp.remove();
            label.style.display = "";
            renderLabel();
          }
        });
        inp.addEventListener("blur", function onBlur() {
          if (skipBlur) {
            skipBlur = false;
            return;
          }
          commitEdit();
        });
      }

      label.addEventListener("click", function (e) {
        e.stopPropagation();
        startEdit();
      });
      label.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          startEdit();
        }
      });

      td.appendChild(label);
    }

    var PLAYER_LEVELS = ["Rookie", "Skilled", "Elite", "Grand Master"];

    function attachRoleDropdown(td, userId, isAdmin) {
      var state = { admin: !!isAdmin };
      td.classList.add("admin-cell-editable");
      var label = document.createElement("span");
      label.className = "admin-editable-label";
      label.setAttribute("title", "Click to change role");
      label.setAttribute("tabindex", "0");

      function renderLabel() {
        label.textContent = state.admin ? "Admin" : "User";
      }
      renderLabel();

      function removeSelect(sel) {
        if (sel && sel.parentNode) sel.remove();
        label.style.display = "";
        renderLabel();
      }

      function startEdit() {
        if (td.querySelector("select.admin-role-select")) return;
        var sel = document.createElement("select");
        sel.className = "admin-editable-select admin-role-select";
        sel.setAttribute("aria-label", "Role");
        [["User", "0"], ["Admin", "1"]].forEach(function (pair) {
          var o = document.createElement("option");
          o.value = pair[1];
          o.textContent = pair[0];
          if ((pair[1] === "1") === state.admin) o.selected = true;
          sel.appendChild(o);
        });
        label.style.display = "none";
        td.appendChild(sel);
        sel.focus();

        var patching = false;

        sel.addEventListener("change", function () {
          var newAdmin = sel.value === "1";
          if (newAdmin === state.admin) return;
          var msg = newAdmin
            ? "Grant admin privileges to this user? They will be able to access admin tools and manage accounts."
            : "Remove admin privileges from this user? They will lose access to the admin area.";
          showAdminConfirm(msg, "Change role").then(function (ok) {
            if (!ok) {
              sel.value = state.admin ? "1" : "0";
              return;
            }
            patching = true;
            patchUserField(userId, { admin: newAdmin })
              .then(function (res) {
                var data = res.data;
                if (data && data.ok && data.user) {
                  state.admin = !!data.user.admin;
                  updateUserInCache(userId, "admin", state.admin);
                }
                removeSelect(sel);
              })
              .catch(function (err) {
                var errMsg = "Update failed";
                if (err.response && err.response.data && err.response.data.message) errMsg = err.response.data.message;
                alert(errMsg);
                sel.value = state.admin ? "1" : "0";
              })
              .finally(function () {
                patching = false;
              });
          });
        });

        sel.addEventListener("keydown", function (e) {
          if (e.key === "Escape") {
            e.preventDefault();
            removeSelect(sel);
          }
        });

        sel.addEventListener("blur", function () {
          setTimeout(function () {
            if (patching) return;
            if (sel.parentNode) removeSelect(sel);
          }, 200);
        });
      }

      label.addEventListener("click", function (e) {
        e.stopPropagation();
        startEdit();
      });
      label.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          startEdit();
        }
      });

      td.appendChild(label);
    }

    function attachLevelDropdown(td, userId, levelStr) {
      var state = { level: levelStr != null ? String(levelStr) : "" };
      td.classList.add("admin-cell-editable");
      var label = document.createElement("span");
      label.className = "admin-editable-label";
      label.setAttribute("title", "Click to change level");
      label.setAttribute("tabindex", "0");

      function renderLabel() {
        label.textContent = state.level !== "" ? state.level : "\u2014";
      }
      renderLabel();

      function removeSelect(sel) {
        if (sel && sel.parentNode) sel.remove();
        label.style.display = "";
        renderLabel();
      }

      function startEdit() {
        if (td.querySelector("select.admin-level-select")) return;
        var sel = document.createElement("select");
        sel.className = "admin-editable-select admin-level-select";
        sel.setAttribute("aria-label", "Player level");
        PLAYER_LEVELS.forEach(function (lv) {
          var o = document.createElement("option");
          o.value = lv;
          o.textContent = lv;
          if (lv === state.level) o.selected = true;
          sel.appendChild(o);
        });
        if (state.level && PLAYER_LEVELS.indexOf(state.level) === -1) {
          var oExtra = document.createElement("option");
          oExtra.value = state.level;
          oExtra.textContent = state.level;
          oExtra.selected = true;
          sel.insertBefore(oExtra, sel.firstChild);
        }
        label.style.display = "none";
        td.appendChild(sel);
        sel.focus();

        var patching = false;

        sel.addEventListener("change", function () {
          var newLevel = sel.value;
          if (newLevel === state.level) {
            removeSelect(sel);
            return;
          }
          patching = true;
          patchUserField(userId, { level: newLevel })
            .then(function (res) {
              var data = res.data;
              if (data && data.ok && data.user) {
                state.level = data.user.level != null ? String(data.user.level) : "";
                updateUserInCache(userId, "level", state.level);
              }
              removeSelect(sel);
            })
            .catch(function (err) {
              var msg = "Update failed";
              if (err.response && err.response.data && err.response.data.message) msg = err.response.data.message;
              alert(msg);
              sel.value = state.level && PLAYER_LEVELS.indexOf(state.level) !== -1 ? state.level : PLAYER_LEVELS[0];
            })
            .finally(function () {
              patching = false;
            });
        });

        sel.addEventListener("keydown", function (e) {
          if (e.key === "Escape") {
            e.preventDefault();
            removeSelect(sel);
          }
        });

        sel.addEventListener("blur", function () {
          setTimeout(function () {
            if (patching) return;
            if (sel.parentNode) removeSelect(sel);
          }, 200);
        });
      }

      label.addEventListener("click", function (e) {
        e.stopPropagation();
        startEdit();
      });
      label.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          startEdit();
        }
      });

      td.appendChild(label);
    }

    function renderUsersRows(users) {
      var colCount = ADMIN_TAB_CONFIG[0].headers.length;
      tbody.innerHTML = "";
      if (!users || users.length === 0) {
        var trEmpty = document.createElement("tr");
        trEmpty.className = "admin-table-empty-row";
        var tdEmpty = document.createElement("td");
        tdEmpty.colSpan = colCount;
        tdEmpty.className = "admin-table-empty mute";
        tdEmpty.textContent = ADMIN_TAB_CONFIG[0].emptyMsg;
        trEmpty.appendChild(tdEmpty);
        tbody.appendChild(trEmpty);
        return;
      }
      users.forEach(function (u, i) {
        var tr = document.createElement("tr");
        tr.className = "admin-user-row";
        var tdNum = document.createElement("td");
        tdNum.className = "row-number";
        tdNum.textContent = String(i + 1);
        var tdName = document.createElement("td");
        attachEditableCell(tdName, u.id, "username", u.username);
        var tdRole = document.createElement("td");
        attachRoleDropdown(tdRole, u.id, u.admin);
        var tdEmail = document.createElement("td");
        attachEditableCell(tdEmail, u.id, "email", u.email);
        var tdLevel = document.createElement("td");
        attachLevelDropdown(tdLevel, u.id, u.level);
        var tdElo = document.createElement("td");
        tdElo.textContent = u.elo != null && u.elo !== "" ? String(u.elo) : "—";
        var tdJoined = document.createElement("td");
        tdJoined.textContent = formatDateTime(u.joinedDate);
        var tdLogin = document.createElement("td");
        tdLogin.textContent = formatDateTime(u.lastLogin);
        var tdActive = document.createElement("td");
        tdActive.textContent = u.activeGamesCount != null ? String(u.activeGamesCount) : "0";
        var tdFriends = document.createElement("td");
        tdFriends.textContent = u.friendsCount != null ? String(u.friendsCount) : "0";
        var tdBm = document.createElement("td");
        tdBm.textContent = u.bookmarksCount != null ? String(u.bookmarksCount) : "0";
        tr.appendChild(tdNum);
        tr.appendChild(tdName);
        tr.appendChild(tdRole);
        tr.appendChild(tdEmail);
        tr.appendChild(tdLevel);
        tr.appendChild(tdElo);
        tr.appendChild(tdJoined);
        tr.appendChild(tdLogin);
        tr.appendChild(tdActive);
        tr.appendChild(tdFriends);
        tr.appendChild(tdBm);
        tbody.appendChild(tr);
      });
    }

    function renderTableForTab(index) {
      var cfg = ADMIN_TAB_CONFIG[index];
      if (!cfg || !headRow || !tbody) return;

      headRow.innerHTML = "";
      cfg.headers.forEach(function (label) {
        var th = document.createElement("th");
        th.textContent = label;
        headRow.appendChild(th);
      });

      if (index === 0) {
        renderUsersRows(window.__ADMIN_USERS__ || []);
      } else {
        var n = cfg.headers.length;
        tbody.innerHTML = "";
        var tr = document.createElement("tr");
        tr.className = "admin-table-empty-row";
        var td = document.createElement("td");
        td.colSpan = n;
        td.className = "admin-table-empty mute";
        td.textContent = cfg.emptyMsg;
        tr.appendChild(td);
        tbody.appendChild(tr);
      }

      if (toolbar) toolbar.hidden = !cfg.toolbar;
    }

    function selectTab(index) {
      tabs.forEach(function (tab, i) {
        var on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        if (on) tab.classList.add("admin-tab-btn--active");
        else tab.classList.remove("admin-tab-btn--active");
      });
      renderTableForTab(index);
      if (panelMain && tabs[index]) panelMain.setAttribute("aria-labelledby", tabs[index].id);
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener("click", function () { selectTab(i); });
      tab.addEventListener("keydown", function (e) {
        var next = null;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") next = (i + 1) % tabs.length;
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next !== null) {
          e.preventDefault();
          selectTab(next);
          tabs[next].focus();
        }
      });
    });
    selectTab(0);
  })();
</script>
