<% layout("../views/layouts/boilerplate") %>
<link rel="stylesheet" href="/assets/welcome.css">

<div class="home admin-page">
  <div class="games-section admin-games-section">
    <div class="games-panel admin-tabbed-panel">
      <div class="panel-header admin-panel-header">
        <div class="panel-title-group admin-panel-title-row">
          <h2 class="panel-title">Admin</h2>
        </div>
        <div class="admin-tab-strip" role="tablist" aria-label="Admin sections">
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-users" aria-controls="admin-panel-main" aria-selected="true" tabindex="0">Users</button>
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-games" aria-controls="admin-panel-main" aria-selected="false" tabindex="-1">Games</button>
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-engines" aria-controls="admin-panel-main" aria-selected="false" tabindex="-1">Engines</button>
          <button type="button" class="admin-tab-btn" role="tab" id="admin-tab-log" aria-controls="admin-panel-main" aria-selected="false" tabindex="-1">Log</button>
        </div>
      </div>
      <div class="panel-body admin-panel-body">
        <div class="admin-tab-toolbar" id="admin-users-toolbar">
          <a href="/register" class="button">Add user</a>
        </div>
        <div class="table-scroll compact" id="admin-panel-main" role="tabpanel" aria-labelledby="admin-tab-users">
          <table class="games-table" id="admin-main-table">
            <thead>
              <tr id="admin-table-head-row">
                <th>#</th>
                <th>Username</th>
                <th>Role</th>
                <th>Email</th>
                <th>Level</th>
                <th>Elo</th>
                <th>Joined</th>
                <th>Last login</th>
                <th>Active games</th>
                <th>Friends</th>
                <th>Bookmarks</th>
              </tr>
            </thead>
            <tbody id="admin-table-body"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<% var adminUsersJson = JSON.stringify(typeof adminUsers !== "undefined" && adminUsers ? adminUsers : []).replace(/</g, "\\u003c"); %>
<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
  window.__ADMIN_USERS__ = <%- adminUsersJson %>;
  (function () {
    var ADMIN_TAB_CONFIG = [
      {
        toolbar: true,
        headers: ["#", "Username", "Role", "Email", "Level", "Elo", "Joined", "Last login", "Active games", "Friends", "Bookmarks"],
        emptyMsg: "No users yet."
      },
      { toolbar: false, headers: ["#", "Id", "Type", "Status"], emptyMsg: "No data yet." },
      { toolbar: false, headers: ["#", "Name", "Available", "Notes"], emptyMsg: "No data yet." },
      { toolbar: false, headers: ["Time", "Level", "Message"], emptyMsg: "No log entries yet." }
    ];

    var tabs = document.querySelectorAll(".admin-tab-btn");
    var headRow = document.getElementById("admin-table-head-row");
    var tbody = document.getElementById("admin-table-body");
    var toolbar = document.getElementById("admin-users-toolbar");
    var panelMain = document.getElementById("admin-panel-main");

    function formatDateTime(iso) {
      if (!iso) return "—";
      try {
        var d = new Date(iso);
        if (isNaN(d.getTime())) return "—";
        return d.toLocaleString(undefined, { dateStyle: "short", timeStyle: "short" });
      } catch (e) {
        return "—";
      }
    }

    function renderUsersRows(users) {
      var colCount = ADMIN_TAB_CONFIG[0].headers.length;
      tbody.innerHTML = "";
      if (!users || users.length === 0) {
        var trEmpty = document.createElement("tr");
        trEmpty.className = "admin-table-empty-row";
        var tdEmpty = document.createElement("td");
        tdEmpty.colSpan = colCount;
        tdEmpty.className = "admin-table-empty mute";
        tdEmpty.textContent = ADMIN_TAB_CONFIG[0].emptyMsg;
        trEmpty.appendChild(tdEmpty);
        tbody.appendChild(trEmpty);
        return;
      }
      users.forEach(function (u, i) {
        var tr = document.createElement("tr");
        tr.className = "admin-user-row";
        var tdNum = document.createElement("td");
        tdNum.className = "row-number";
        tdNum.textContent = String(i + 1);
        var tdName = document.createElement("td");
        tdName.textContent = u.username != null ? String(u.username) : "";
        var tdRole = document.createElement("td");
        tdRole.textContent = u.admin ? "Admin" : "User";
        var tdEmail = document.createElement("td");
        tdEmail.className = "admin-cell-email";
        tdEmail.textContent = u.email != null ? String(u.email) : "";
        var tdLevel = document.createElement("td");
        tdLevel.textContent = u.level != null ? String(u.level) : "";
        var tdElo = document.createElement("td");
        tdElo.textContent = u.elo != null && u.elo !== "" ? String(u.elo) : "—";
        var tdJoined = document.createElement("td");
        tdJoined.textContent = formatDateTime(u.joinedDate);
        var tdLogin = document.createElement("td");
        tdLogin.textContent = formatDateTime(u.lastLogin);
        var tdActive = document.createElement("td");
        tdActive.textContent = u.activeGamesCount != null ? String(u.activeGamesCount) : "0";
        var tdFriends = document.createElement("td");
        tdFriends.textContent = u.friendsCount != null ? String(u.friendsCount) : "0";
        var tdBm = document.createElement("td");
        tdBm.textContent = u.bookmarksCount != null ? String(u.bookmarksCount) : "0";
        tr.appendChild(tdNum);
        tr.appendChild(tdName);
        tr.appendChild(tdRole);
        tr.appendChild(tdEmail);
        tr.appendChild(tdLevel);
        tr.appendChild(tdElo);
        tr.appendChild(tdJoined);
        tr.appendChild(tdLogin);
        tr.appendChild(tdActive);
        tr.appendChild(tdFriends);
        tr.appendChild(tdBm);
        tbody.appendChild(tr);
      });
    }

    function renderTableForTab(index) {
      var cfg = ADMIN_TAB_CONFIG[index];
      if (!cfg || !headRow || !tbody) return;

      headRow.innerHTML = "";
      cfg.headers.forEach(function (label) {
        var th = document.createElement("th");
        th.textContent = label;
        headRow.appendChild(th);
      });

      if (index === 0) {
        renderUsersRows(window.__ADMIN_USERS__ || []);
      } else {
        var n = cfg.headers.length;
        tbody.innerHTML = "";
        var tr = document.createElement("tr");
        tr.className = "admin-table-empty-row";
        var td = document.createElement("td");
        td.colSpan = n;
        td.className = "admin-table-empty mute";
        td.textContent = cfg.emptyMsg;
        tr.appendChild(td);
        tbody.appendChild(tr);
      }

      if (toolbar) toolbar.hidden = !cfg.toolbar;
    }

    function selectTab(index) {
      tabs.forEach(function (tab, i) {
        var on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        if (on) tab.classList.add("admin-tab-btn--active");
        else tab.classList.remove("admin-tab-btn--active");
      });
      renderTableForTab(index);
      if (panelMain && tabs[index]) panelMain.setAttribute("aria-labelledby", tabs[index].id);
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener("click", function () { selectTab(i); });
      tab.addEventListener("keydown", function (e) {
        var next = null;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") next = (i + 1) % tabs.length;
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next !== null) {
          e.preventDefault();
          selectTab(next);
          tabs[next].focus();
        }
      });
    });
    selectTab(0);
  })();
</script>
