<div id="site-confirm-overlay" class="admin-confirm-overlay" aria-hidden="true">
  <div class="admin-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="site-confirm-title">
    <h3 id="site-confirm-title" class="admin-confirm-title"><%= t('site.confirm') %></h3>
    <p id="site-confirm-message" class="admin-confirm-message"></p>
    <div class="admin-confirm-actions">
      <button type="button" class="button admin-confirm-cancel site-confirm-cancel"><%= t('site.cancel') %></button>
      <button type="button" class="button admin-confirm-ok site-confirm-ok">Confirm</button>
    </div>
  </div>
</div>
<div id="site-alert-overlay" class="admin-confirm-overlay" aria-hidden="true">
  <div class="admin-confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="site-alert-title">
    <h3 id="site-alert-title" class="admin-confirm-title"><%= t('site.notice') %></h3>
    <p id="site-alert-message" class="admin-confirm-message"></p>
    <div class="admin-confirm-actions">
      <button type="button" class="button admin-confirm-ok site-alert-ok"><%= t('site.ok') %></button>
    </div>
  </div>
</div>
