<% if (typeof desktopDownloads !== "undefined" && desktopDownloads && desktopDownloads.downloads && desktopDownloads.downloads.length > 0) {
  var winDl = null;
  var macDl = null;
  desktopDownloads.downloads.forEach(function (d) {
    if (d.platform === "windows") { winDl = d; }
    if (d.platform === "mac") { macDl = d; }
  });
  if (winDl || macDl) { %>
<footer class="welcome-desktop-downloads" aria-label="Desktop app downloads">
  <p class="welcome-desktop-downloads-line">
    <% if (winDl) { %><a class="welcome-desktop-downloads-link" href="<%= winDl.url %>" download="<%= winDl.filename %>">Download for Windows</a><% } %><% if (winDl && macDl) { %><span class="welcome-desktop-downloads-sep" aria-hidden="true"> · </span><% } %><% if (macDl) { %><a class="welcome-desktop-downloads-link" href="<%= macDl.url %>" download="<%= macDl.filename %>">Download for Mac</a><% } %>
  </p>
</footer>
<% } } %>
