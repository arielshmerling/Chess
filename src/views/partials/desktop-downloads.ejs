<% if (typeof desktopDownloads !== "undefined" && desktopDownloads && desktopDownloads.downloads && desktopDownloads.downloads.length > 0) { %>
<section class="desktop-downloads-panel" aria-labelledby="desktopDownloadsTitle">
  <div class="desktop-downloads-panel-inner">
    <div class="desktop-downloads-header">
      <h3 class="desktop-downloads-title" id="desktopDownloadsTitle">Shmerling Chess — Desktop app</h3>
      <p class="desktop-downloads-subtitle">Offline play with the full desktop experience<% if (desktopDownloads.version) { %> · v<%= desktopDownloads.version %><% } %></p>
    </div>
    <ul class="desktop-downloads-list">
      <% desktopDownloads.downloads.forEach(function (item) { %>
      <li class="desktop-downloads-item">
        <a class="desktop-downloads-btn" href="<%= item.url %>" download="<%= item.filename %>">
          <span class="desktop-downloads-btn-label">Download for <%= item.label %></span>
          <% if (item.sizeLabel) { %>
          <span class="desktop-downloads-btn-meta"><%= item.sizeLabel %></span>
          <% } %>
        </a>
      </li>
      <% }); %>
    </ul>
    <p class="desktop-downloads-hint">macOS: open the DMG and drag <strong>Shmerling Chess</strong> to Applications. Windows installer: run Setup and follow the wizard. Windows ZIP: unzip and run <strong>Shmerling Chess.exe</strong>.</p>
  </div>
</section>
<% } %>
