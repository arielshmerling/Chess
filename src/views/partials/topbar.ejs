<% var minimalTopbar = typeof hideTopbar !== 'undefined' && hideTopbar; %>
<div id="header">
  <div id="logoArea" class="flexRow">
    <div class="site-title">
      <a href="/home" aria-label="<%= t('site.homeAria') %>"><img src="/images/shmerling.png" alt="Shmerling" class="site-logo-img"></a>
    </div>
  </div>

  <% if (!minimalTopbar) { %>
  <div class="topBarMenu">
    <div class="menuBarMenuItem topBarMenu-home"><a href="/home"><%= t('site.home') %></a></div>
    <div class="menuBarMenuItem"><a href="/search"><%= t('site.search') %></a></div>
    <div class="menuBarMenuItem"><a href="/friends"><%= t('site.friends') %></a></div>
    <div class="menuBarMenuItem topBarMenu-groups"><a href="#"><%= t('site.groups') %></a></div>
    <% if (typeof canDebug !== 'undefined' && canDebug) { %>
    <div class="menuBarMenuItem"><a href="<%= (typeof canUsePlayPage !== 'undefined' && canUsePlayPage) ? '/play?mode=practice' : '/game?gameType=3' %>"><%= t('site.debug') %></a></div>
    <% } %>
  </div>
  <% } %>

  <div id="logout">
    <% var useWebPreferences = typeof showWebPreferences !== 'undefined' && showWebPreferences; %>
    <% if (useWebPreferences) { %>
    <div class="web-user-menu">
      <button
        type="button"
        id="webUserMenuTrigger"
        class="web-user-menu-trigger"
        aria-expanded="false"
        aria-controls="webUserMenuPanel"
        aria-haspopup="menu"
      >
        <span class="web-user-menu-avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path>
          </svg>
        </span>
        <span class="web-user-menu-name"><%= username %></span>
        <svg class="web-user-menu-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="m4 6 4 4 4-4"></path>
        </svg>
      </button>
      <div id="webUserMenuPanel" class="web-user-menu-panel" role="menu" hidden>
        <button type="button" class="web-user-menu-item" role="menuitem" disabled><%= t('site.account') %></button>
        <button type="button" id="webUserPreferencesAction" class="web-user-menu-item" role="menuitem"><%= t('site.preferences') %></button>
        <% if (admin) { %>
        <a href="/admin" class="web-user-menu-item" role="menuitem"><%= t('site.administrate') %></a>
        <% } %>
        <div class="web-user-menu-separator" role="separator"></div>
        <a href="/logout" class="web-user-menu-item" role="menuitem"><%= t('site.logOut') %></a>
      </div>
    </div>
    <div id="webDesktopPrefsHost" class="web-desktop-prefs-host" aria-live="polite"></div>
    <% } else { %>
    <% if (username) { %>
    <span class="topbar-username"><%= username %></span>
    <% } %>
    <label class="switch">
      <input type="checkbox" id="themeSwitch">
      <span class="slider round"></span>
    </label>
    <% if (!minimalTopbar) { %>
    <% if (username) { %>
    <a href="/logout"> <%= t('site.logOut') %> </a>
    <% } else { %>
    <a href="/Login"> <%= t('site.logIn') %> </a>
    <% } %>
    <% if (admin) { %>
    <a href="/admin"> <%= t('site.admin') %> </a>
    <% } %>
    <% } %>
    <% } %>
  </div>

</div>


<div id="mainMenu" class="mainMenu" style="visibility: hidden;">
  <div class="menuItem" onclick="menuNewGameOnePlayer()"><%= t('classic.humanVsComputer') %></div>
  <div class="menuItem" onclick="menuNewGameTwoPlayers()"><%= t('classic.newGameTwoPlayers') %></div>
  <div class="menuItem" onclick="menuResignEventHandler()"><%= t('play.actions.resign') %></div>
  <div class="menuItem" onclick="menuUndo()"><%= t('play.actions.undo') %></div>
  <div class="menuItem" onclick="menuSaveEventHandler();"><%= t('play.actions.save') %></div>
  <div class="menuItem" onclick="menuLoadEventHandler()"><%= t('classic.load') %></div>
  <div class="menuItem" onclick="menuPositionSetup()"><%= t('play.actions.positionSetup') %></div>
  <div class="menuItem" onclick="menuSettings()"><%= t('classic.settings') %></div>
  <div class="menuItem last" onclick=""><%= t('classic.help') %></div>
</div>