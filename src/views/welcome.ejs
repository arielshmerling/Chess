<% layout("../views/layouts/boilerplate") %>

<link rel="stylesheet" href="/welcome.css">
<link rel="stylesheet" href="/friends.css">
<script>
  window.__LAST_GAME_OPTIONS__ = <%- JSON.stringify(typeof lastGameOptions !== "undefined" && lastGameOptions ? lastGameOptions : {}) %>;
</script>

<div class="welcome-container">
  <!-- Hero Banner with Chess Theme -->
  <div class="hero-banner">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-logo">
        <img src="/images/logo_chess.png" alt="Shmerling Chess Club" class="hero-logo-img">
      </div>
      <div class="hero-text-section">
        <h1 class="hero-greeting">Welcome Back</h1>
        <h2 class="hero-username"><%=username %></h2>
        <p class="hero-tagline">Your move awaits</p>
      </div>
      <div class="hero-right">
        <div class="hero-chess-icon">
          <div class="chess-pieces-container">
            <!-- <span class="chess-piece-symbol king-symbol">♔</span> -->
          </div>
        </div>
        <div class="hero-play-now">
          <button type="button" class="play-now-btn" id="startAIGame" onclick="openPlayNowModal()"><span class="play-now-btn-text">Play Now!</span></button>
        </div>
      </div>
    </div>
  </div>

  <!-- New game options modal -->
  <div id="playNowModal" class="play-now-modal" aria-hidden="true">
    <div class="play-now-modal-overlay" onclick="closePlayNowModal()"></div>
    <div class="play-now-modal-dialog" role="dialog" aria-labelledby="playNowModalTitle">
      <h2 id="playNowModalTitle" class="play-now-modal-title">Start a new Game</h2>
      <form id="playNowForm" class="play-now-form" onsubmit="startNewGameFromModal(event)">
        <div class="play-now-field">
          <label class="play-now-label">Playing color</label>
          <div class="play-now-radio-group">
            <label class="play-now-radio">
              <input type="radio" name="color" value="white" checked>
              <span>White</span>
            </label>
            <label class="play-now-radio">
              <input type="radio" name="color" value="black">
              <span>Black</span>
            </label>
          </div>
        </div>
        <div class="play-now-field">
          <div class="play-now-engine-time-row">
            <div class="play-now-engine-col">
              <label class="play-now-label" for="playNowEngine">Engine</label>
              <select id="playNowEngine" name="engine" class="play-now-select play-now-select--compact">
                <option value="brain4">Brain 4.0</option>
                <option value="brain3">Brain 3</option>
                <option value="brain2">Brain 2</option>
                <option value="brain5">Brain 5</option>
              </select>
            </div>
            <div class="play-now-time-col">
              <label class="play-now-label" for="playNowTimeMinutes">Time (min)</label>
              <input type="number" id="playNowTimeMinutes" name="timeMinutes" class="play-now-time-input" min="1" max="180" step="1" value="90" title="Clock time per side in minutes">
            </div>
          </div>
        </div>
        <div class="play-now-field">
          <label class="play-now-label" for="playNowDifficulty">Difficulty (1–5)</label>
          <div class="play-now-slider-row">
            <input type="range" min="1" max="5" value="3" name="difficulty" id="playNowDifficulty" class="play-now-slider" oninput="document.getElementById('playNowDifficultyValue').textContent=this.value">
            <span id="playNowDifficultyValue" class="play-now-slider-value">3</span>
          </div>
        </div>
        <div class="play-now-field">
          <label class="play-now-label">Mouse preference</label>
          <div class="play-now-radio-group">
            <label class="play-now-radio" id="mouseDragLabel">
              <input type="radio" name="mouse" value="drag" id="mouseDrag" checked>
              <span>Drag</span>
            </label>
            <label class="play-now-radio">
              <input type="radio" name="mouse" value="double" id="mouseDouble">
              <span>Double click</span>
            </label>
          </div>
        </div>
        <div class="play-now-field">
          <label class="play-now-checkbox-label">
            <input type="checkbox" name="showMoves" id="playNowShowMoves" value="1" checked>
            <span>Show available moves</span>
          </label>
        </div>
        <div class="play-now-modal-actions">
          <button type="button" class="play-now-btn-cancel" onclick="closePlayNowModal()">Cancel</button>
          <button type="submit" class="play-now-btn-start">Start</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Games Section -->
  <div class="games-section">
    <div class="welcome-active-games-row">
    <!-- Active Games (Online + AI) -->
    <div class="games-panel online-games-panel">
      <div class="panel-header">
        <div class="panel-header-top">
          <div class="panel-title-group">
            <h3 class="panel-title">Active Games</h3>
            <span class="panel-badge">Live</span>
          </div>
          <a href="/active-games-list" class="panel-show-all-btn" title="View all active games">Show All</a>
        </div>
        <div class="panel-subtitle">Most recent first</div>
      </div>
      <div class="panel-body online-games-body<% if (allGames && allGames.length > 0) { %> has-online-games<% } %>" id="online-games-container">
        <script type="application/json" id="active-games-initial-json"><%- JSON.stringify(allGames || []).replace(/</g, '\\u003c') %></script>
        <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
          window.__WELCOME_USERNAME__ = <%- typeof username !== 'undefined' && username ? JSON.stringify(String(username)) : '""' %>;
        </script>
        <div id="online-games-cards-root" class="online-games-cards-root">
          <div
            id="active-game-highlight-wrap"
            class="active-game-highlight"
            style="display: <%= (allGames && allGames.length > 0) ? 'flex' : 'none' %>;"
            role="link"
            tabindex="0"
          >
            <div class="active-highlight-board-wrap">
              <div id="active-mini-board" class="active-mini-board" aria-hidden="true"></div>
            </div>
            <div class="active-highlight-side">
              <div id="active-highlight-names" class="active-highlight-names"></div>
              <p id="active-highlight-started" class="active-highlight-started" title=""></p>
              <div id="active-highlight-meta" class="active-highlight-meta"></div>
            </div>
          </div>
          <div id="active-games-compact-list" class="active-games-compact-list" aria-label="Other active games"></div>
        </div>
        <div class="no-games-message" id="online-no-games-msg">
          <p>No games at the moment</p>
        </div>
      </div>
      <script src="/activeGamesHome.js" defer></script>
    </div>

    <!-- Friends (accepted only; invite / rejoin — no remove) -->
    <div class="games-panel home-friends-panel" id="homeFriendsPanel">
      <div class="panel-header">
        <div class="panel-header-top">
          <div class="panel-title-group">
            <h3 class="panel-title">Friends</h3>
          </div>
          <a href="/friends" class="panel-show-all-btn" title="Friends page">Show All</a>
        </div>
        <div class="panel-subtitle">Invite an online friend to play</div>
      </div>
      <div class="panel-body home-friends-body" id="home-friends-body">
        <div class="table-scroll" id="home-friends-table-wrap">
          <table class="games-table home-friends-table" aria-label="Friends">
            <thead>
              <tr>
                <th>#</th>
                <th>Friend</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="home-friends-tbody"></tbody>
          </table>
        </div>
        <div class="no-games-message home-friends-empty" id="home-friends-empty">
          <p>No friends yet</p>
          <p class="home-friends-empty-hint"><a href="/friends" class="footer-link home-friends-empty-link">Find players</a></p>
        </div>
      </div>
      <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function () {
  var panel = document.getElementById("homeFriendsPanel");
  var bodyEl = document.getElementById("home-friends-body");
  var tbody = document.getElementById("home-friends-tbody");
  if (!panel || !tbody || !bodyEl) return;

  var liveOnlineByUserId = {};
  var wsResyncTimer = null;
  var playingUsernames = {};
  var gamePlayersById = {};
  var pendingInviterJoiningGameId = null;
  var pendingInviterJoiningUntil = 0;
  var JOINING_LABEL_MS = 15000;
  var joiningLabelRevertTimer = null;

  function markInviterJoiningGame(gameId) {
    if (!gameId) return;
    pendingInviterJoiningGameId = String(gameId);
    pendingInviterJoiningUntil = Date.now() + JOINING_LABEL_MS;
    if (joiningLabelRevertTimer) clearTimeout(joiningLabelRevertTimer);
    joiningLabelRevertTimer = setTimeout(function () {
      joiningLabelRevertTimer = null;
      pendingInviterJoiningGameId = null;
      pendingInviterJoiningUntil = 0;
      applyPresenceToAllRows();
    }, JOINING_LABEL_MS);
  }

  function esc(s) {
    return String(s == null ? "" : s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function postJson(url, body) {
    return fetch(url, {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify(body || {}),
    }).then(function (r) {
      return r.json().then(function (data) {
        if (!r.ok) throw new Error((data && data.message) || r.statusText || "Request failed");
        return data;
      });
    });
  }

  function statusTitle(st) {
    if (st === "playing") return "Playing";
    if (st === "online") return "Online";
    return "Offline";
  }

  function statusLabel(st) {
    if (st === "playing") return "Playing";
    if (st === "online") return "Online";
    return "Offline";
  }

  function computeEffectiveStatus(f) {
    if (f.username && playingUsernames[f.username]) return "playing";
    if (Object.prototype.hasOwnProperty.call(liveOnlineByUserId, f.id)) {
      return liveOnlineByUserId[f.id] ? "online" : "offline";
    }
    return f.status || "offline";
  }

  function syncPlayingFromApi(friends) {
    if (!friends) return;
    friends.forEach(function (f) {
      if (f.rowType !== "friend") return;
      if (f.status === "playing") playingUsernames[f.username] = 1;
      else delete playingUsernames[f.username];
    });
  }

  function mergePresenceFromApiFriends(friends) {
    if (!friends) return;
    var friendIds = {};
    friends.forEach(function (f) {
      if (f.rowType !== "friend") return;
      var id = f.id;
      friendIds[id] = true;
      if (f.status === "playing") {
        delete liveOnlineByUserId[id];
        return;
      }
      liveOnlineByUserId[id] = f.status === "online";
    });
    Object.keys(liveOnlineByUserId).forEach(function (k) {
      if (!friendIds[k]) delete liveOnlineByUserId[k];
    });
  }

  function sharedGamePrimaryButtonLabel(sharedGid) {
    var gid = sharedGid != null ? String(sharedGid) : "";
    if (
      gid &&
      pendingInviterJoiningGameId &&
      gid === pendingInviterJoiningGameId &&
      Date.now() < pendingInviterJoiningUntil
    ) {
      return "Joining";
    }
    return "Rejoin";
  }

  function setEmptyVisible(hasRows) {
    bodyEl.classList.toggle("has-home-friends", !!hasRows);
  }

  function renumberRows() {
    var rows = tbody.querySelectorAll("tr[data-friend-id]");
    for (var i = 0; i < rows.length; i++) {
      var numCell = rows[i].querySelector("td.home-friends-row-num");
      if (numCell) numCell.textContent = String(i + 1);
    }
  }

  function updateRowVisual(tr, f) {
    if (!tr || tr.getAttribute("data-friend-game-invite-pending") === "true") return;
    var st = computeEffectiveStatus(f);
    var dot = tr.querySelector(".friends-status-dot");
    if (dot) {
      dot.className = "friends-status-dot friends-status-" + st;
      dot.title = statusTitle(st);
      dot.setAttribute("aria-label", statusTitle(st));
    }
    var statusTd = tr.querySelector("td.home-friends-status-cell");
    if (statusTd) statusTd.textContent = statusLabel(st);

    var primary = tr.querySelector(".friends-row-actions .friends-btn-primary");
    if (!primary) return;
    var sharedGid = tr.getAttribute("data-shared-game-id");
    var fid = tr.getAttribute("data-friend-id");
    var fun = tr.getAttribute("data-friend-username") || "";
    if (st === "playing" && sharedGid) {
      primary.disabled = false;
      primary.textContent = sharedGamePrimaryButtonLabel(sharedGid);
      primary.setAttribute("data-action", "rejoin-game");
      primary.setAttribute("data-game-id", sharedGid);
      primary.removeAttribute("data-friend-id");
      primary.removeAttribute("data-username");
      primary.classList.remove("friends-btn-invite");
      primary.classList.add("friends-btn-rejoin");
      return;
    }
    primary.textContent = "Invite";
    primary.removeAttribute("data-action");
    primary.removeAttribute("data-game-id");
    if (fid) primary.setAttribute("data-friend-id", fid);
    if (fun) primary.setAttribute("data-username", fun);
    primary.classList.add("friends-btn-invite");
    primary.classList.remove("friends-btn-rejoin");
    primary.disabled = st !== "online";
  }

  function applyPresenceToAllRows() {
    var rows = tbody.querySelectorAll("tr[data-friend-id]");
    for (var i = 0; i < rows.length; i++) {
      var tr = rows[i];
      if (tr.getAttribute("data-friend-game-invite-pending") === "true") continue;
      var id = tr.getAttribute("data-friend-id");
      var un = tr.getAttribute("data-friend-username") || "";
      updateRowVisual(tr, { id: id, username: un, status: "offline", rowType: "friend" });
    }
  }

  function renderTable(friendRows, pendingGameInvite) {
    tbody.innerHTML = "";
    var list = (friendRows || []).filter(function (f) {
      return f && f.rowType === "friend";
    });
    list.sort(function (a, b) {
      return String(a.username || "").localeCompare(String(b.username || ""), undefined, { sensitivity: "base" });
    });
    if (list.length === 0) {
      setEmptyVisible(false);
      return;
    }
    setEmptyVisible(true);
    list.forEach(function (f) {
      var tr = document.createElement("tr");
      tr.setAttribute("data-friend-id", f.id);
      tr.setAttribute("data-friend-username", f.username || "");
      var pg =
        pendingGameInvite &&
        pendingGameInvite.inviteeUserId === f.id;
      if (pg) {
        tr.setAttribute("data-friend-game-invite-pending", "true");
        tr.innerHTML =
          '<td class="row-number home-friends-row-num">0</td>' +
          '<td class="home-friends-name-cell"><span class="friends-status-dot friends-status-online" title="Waiting for response" aria-label="Waiting for response"></span> ' +
          '<span class="friends-username">' +
          esc(f.username) +
          '</span> <span class="friends-game-invite-pending-suffix">(invite sent)</span></td>' +
          '<td class="home-friends-status-cell">Pending</td>' +
          '<td class="home-friends-actions-cell"><div class="friends-row-actions">' +
          '<button type="button" class="friends-btn friends-btn-muted" data-action="withdraw-game-invite" data-game-id="' +
          esc(pendingGameInvite.gameId) +
          '">Cancel invite</button></div></td>';
        tbody.appendChild(tr);
        return;
      }
      var st = computeEffectiveStatus(f);
      var dotClass = "friends-status-dot friends-status-" + st;
      var sharedId = f.sharedGameWithMeId || null;
      if (sharedId) tr.setAttribute("data-shared-game-id", sharedId);
      var showRejoin = st === "playing" && sharedId;
      var inviteDisabled = st !== "online";
      var primaryBtn;
      if (showRejoin) {
        primaryBtn =
          '<button type="button" class="friends-btn friends-btn-primary friends-btn-rejoin" data-action="rejoin-game" data-game-id="' +
          esc(sharedId) +
          '">' +
          esc(sharedGamePrimaryButtonLabel(sharedId)) +
          "</button>";
      } else {
        primaryBtn =
          '<button type="button" class="friends-btn friends-btn-primary friends-btn-invite"' +
          (inviteDisabled ? " disabled" : "") +
          ' data-friend-id="' +
          esc(f.id) +
          '" data-username="' +
          esc(f.username) +
          '">Invite</button>';
      }
      tr.innerHTML =
        '<td class="row-number home-friends-row-num">0</td>' +
        '<td class="home-friends-name-cell"><span class="' +
        esc(dotClass) +
        '" title="' +
        esc(statusTitle(st)) +
        '" aria-label="' +
        esc(statusTitle(st)) +
        '"></span> <span class="friends-username">' +
        esc(f.username) +
        "</span></td>" +
        '<td class="home-friends-status-cell">' +
        esc(statusLabel(st)) +
        "</td>" +
        '<td class="home-friends-actions-cell"><div class="friends-row-actions">' +
        primaryBtn +
        "</div></td>";
      tbody.appendChild(tr);
      updateRowVisual(tr, f);
    });
    renumberRows();
  }

  function refreshData() {
    return fetch("/api/friends/data", { credentials: "same-origin" })
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        if (!data || !data.ok) return;
        var friends = data.friends || [];
        syncPlayingFromApi(friends);
        mergePresenceFromApiFriends(friends);
        renderTable(friends, data.pendingGameInvite || null);
      })
      .catch(function () {});
  }

  document.addEventListener("click", function (ev) {
    var raw = ev.target;
    if (!raw || !raw.closest || !raw.closest("#homeFriendsPanel")) return;
    var t = raw.nodeType === 1 ? raw : raw.parentElement;
    if (!t || !t.closest) return;
    var withdrawBtn = t.closest("[data-action=\"withdraw-game-invite\"]");
    if (withdrawBtn) {
      var gid = withdrawBtn.getAttribute("data-game-id");
      if (!gid) return;
      postJson("/api/friends/game-invite-withdraw", { gameId: gid })
        .then(refreshData)
        .catch(function (e) {
          if (typeof showSiteAlert === "function") showSiteAlert(e.message || "Could not cancel invite", "Game invite");
        });
      return;
    }
    var rejoinBtn = t.closest("[data-action=\"rejoin-game\"]");
    if (rejoinBtn) {
      var gid2 = rejoinBtn.getAttribute("data-game-id");
      if (!gid2) return;
      if (pendingInviterJoiningGameId && String(gid2) === String(pendingInviterJoiningGameId)) {
        if (joiningLabelRevertTimer) {
          clearTimeout(joiningLabelRevertTimer);
          joiningLabelRevertTimer = null;
        }
        pendingInviterJoiningGameId = null;
        pendingInviterJoiningUntil = 0;
      }
      window.location.href = "/game?id=" + encodeURIComponent(gid2);
      return;
    }
    var inviteBtn = t.closest(".friends-btn-invite");
    if (inviteBtn && !inviteBtn.disabled) {
      var fid = inviteBtn.getAttribute("data-friend-id");
      if (!fid) return;
      postJson("/api/friends/game-invite", { targetUserId: fid })
        .then(refreshData)
        .catch(function (e) {
          if (typeof showSiteAlert === "function") showSiteAlert(e.message || "Could not send game invite", "Game invite");
        });
    }
  });

  window.addEventListener("site-ws-message", function (ev) {
    var msg = ev.detail;
    if (!msg) return;
    if (msg.type === "friendPresence" && msg.data) {
      var d = msg.data;
      if (!d.userId) return;
      var trP = tbody.querySelector('tr[data-friend-id="' + d.userId + '"]');
      if (trP && trP.getAttribute("data-friend-game-invite-pending") === "true") return;
      liveOnlineByUserId[d.userId] = !!d.online;
      var tr = tbody.querySelector('tr[data-friend-id="' + d.userId + '"]');
      var un = (tr && tr.getAttribute("data-friend-username")) || d.username || "";
      if (tr) updateRowVisual(tr, { id: d.userId, username: un, status: "offline", rowType: "friend" });
      return;
    }
    if (msg.type === "onlineGameInProgress" && msg.data) {
      var d2 = msg.data;
      var gid = d2.gameId != null ? String(d2.gameId) : "";
      var myName = typeof window.__WELCOME_USERNAME__ === "string" ? window.__WELCOME_USERNAME__ : "";
      if (gid) {
        gamePlayersById[gid] = {
          w: d2.whitePlayerName || "",
          b: d2.blackPlayerName || "",
        };
      }
      if (d2.whitePlayerName) playingUsernames[d2.whitePlayerName] = 1;
      if (d2.blackPlayerName) playingUsernames[d2.blackPlayerName] = 1;
      if (myName && gid && d2.whitePlayerName && d2.blackPlayerName) {
        var wN = d2.whitePlayerName;
        var bN = d2.blackPlayerName;
        var imInGame = wN === myName || bN === myName;
        var otherName = wN === myName ? bN : bN === myName ? wN : "";
        if (imInGame && otherName && otherName !== myName) {
          if (myName && wN === myName && gid) markInviterJoiningGame(gid);
          var rowList = tbody.querySelectorAll("tr[data-friend-username]");
          for (var ri = 0; ri < rowList.length; ri++) {
            var rowTr = rowList[ri];
            if (rowTr.getAttribute("data-friend-game-invite-pending") === "true") continue;
            if (rowTr.getAttribute("data-friend-username") === otherName) {
              rowTr.setAttribute("data-shared-game-id", gid);
              var fid = rowTr.getAttribute("data-friend-id");
              var un = rowTr.getAttribute("data-friend-username") || "";
              updateRowVisual(rowTr, { id: fid, username: un, status: "offline", rowType: "friend" });
            }
          }
        }
      }
      applyPresenceToAllRows();
      return;
    }
    if (msg.type === "onlineGameUpdated" && msg.data) {
      var d3 = msg.data;
      var stNorm = String(d3.status || "")
        .toLowerCase()
        .trim();
      var terminal = stNorm === "game over" || stNorm === "cancelled";
      if (terminal && d3.gameId != null) {
        var gpk = String(d3.gameId);
        if (pendingInviterJoiningGameId && gpk === String(pendingInviterJoiningGameId)) {
          if (joiningLabelRevertTimer) {
            clearTimeout(joiningLabelRevertTimer);
            joiningLabelRevertTimer = null;
          }
          pendingInviterJoiningGameId = null;
          pendingInviterJoiningUntil = 0;
        }
        var wN = d3.whitePlayerName || "";
        var bN = d3.blackPlayerName || "";
        if (wN) delete playingUsernames[wN];
        if (bN) delete playingUsernames[bN];
        var gp = gamePlayersById[gpk];
        if (gp) {
          if (gp.w) delete playingUsernames[gp.w];
          if (gp.b) delete playingUsernames[gp.b];
          delete gamePlayersById[gpk];
        }
        var endedRows = tbody.querySelectorAll("tr[data-shared-game-id]");
        for (var ei = 0; ei < endedRows.length; ei++) {
          var rowTr = endedRows[ei];
          if (rowTr.getAttribute("data-shared-game-id") !== gpk) continue;
          rowTr.removeAttribute("data-shared-game-id");
          var fid2 = rowTr.getAttribute("data-friend-id");
          var un2 = rowTr.getAttribute("data-friend-username") || "";
          updateRowVisual(rowTr, { id: fid2, username: un2, status: "offline", rowType: "friend" });
        }
        applyPresenceToAllRows();
      }
    }
    if (msg.type === "friendGameInviteAccepted" && msg.data && msg.data.gameId) {
      markInviterJoiningGame(msg.data.gameId);
    }
    if (
      msg.type === "friendGameInviteDeclined" ||
      msg.type === "friendGameInviteWithdrawn" ||
      msg.type === "friendGameInviteAccepted"
    ) {
      refreshData();
    }
  });

  function refreshPlayingFromServer() {
    fetch("/api/friends/playing-usernames", { credentials: "same-origin" })
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        if (!data || !data.ok || !Array.isArray(data.usernames)) return;
        var set = {};
        for (var i = 0; i < data.usernames.length; i++) {
          var u = data.usernames[i];
          if (u) set[u] = 1;
        }
        var rows = tbody.querySelectorAll("tr[data-friend-id]");
        for (var j = 0; j < rows.length; j++) {
          var tr = rows[j];
          if (tr.getAttribute("data-friend-game-invite-pending") === "true") continue;
          var un = tr.getAttribute("data-friend-username");
          if (!un) continue;
          if (set[un]) playingUsernames[un] = 1;
          else delete playingUsernames[un];
        }
        applyPresenceToAllRows();
      })
      .catch(function () {});
  }

  function scheduleResyncAfterWsReconnect() {
    if (wsResyncTimer) clearTimeout(wsResyncTimer);
    wsResyncTimer = setTimeout(function () {
      wsResyncTimer = null;
      refreshData();
    }, 500);
  }

  window.addEventListener("site-ws-reconnected", function () {
    scheduleResyncAfterWsReconnect();
  });

  window.addEventListener("pageshow", function (ev) {
    if (ev.persisted) {
      refreshData();
      refreshPlayingFromServer();
    }
  });

  refreshData();
  setInterval(refreshData, 45000);
  refreshPlayingFromServer();
  setInterval(refreshPlayingFromServer, 8000);
})();
      </script>
    </div>
    </div>

    <!-- My Games -->
    <div class="games-panel my-games-panel">
      <div class="panel-header">
        <div class="panel-header-top">
          <div class="panel-title-group">
            <h3 class="panel-title">My Games</h3>
          </div>
          <a href="/list" class="panel-show-all-btn" title="View All Games">Show All</a>
        </div>
        <div class="panel-subtitle">Your recent completed games</div>
      </div>
      <div class="panel-body">
        <% if(playerGames && playerGames.length > 0) { %>
        <div class="table-scroll compact">
          <table class="games-table sortable">
            <thead>
              <tr>
                <th class="sortable-th" data-sort-key="rowIndex" title="Sort by row number">
                  <span class="th-label">#</span>
                  <span class="sort-icon" aria-hidden="true"></span>
                </th>
                <% obj = playerGames[0]; %>
                <% for(const key in obj) { %>
                  <% if(key !== "Id" && !key.startsWith("_")) { %>
                <th class="sortable-th" data-sort-key="<%= key.replace(/^\s+/, '').replace(/\s+$/, '') %>" title="Sort by <%= key.trim() %>">
                  <span class="th-label"><%= key %></span>
                  <span class="sort-icon" aria-hidden="true"></span>
                </th>
                  <% } %>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <% rowIndex = 0; for(const obj of playerGames) { %>
              <tr data-row-index="<%= rowIndex %>" onclick=<%-`"window.location='/review?type=history&id=${obj.Id}'"`%>>
                <td class="row-number sortable-td" data-sort-key="rowIndex" data-sort-value="<%= rowIndex %>"><%= rowIndex + 1 %></td>
                <% for(const key in obj) { %>
                  <% if(key !== 'Id' && !key.startsWith('_')) { %>
                    <% sortVal = key === 'Date' ? (obj._sortableDate != null ? obj._sortableDate : 0) : (key === 'Moves' ? (obj.Moves != null ? obj.Moves : 0) : (obj[key] != null ? String(obj[key]).replace(/"/g, '&quot;') : '')); %>
                <td class="<%= key.trim() === 'Reason' ? 'align-left ' : '' %>sortable-td" data-sort-key="<%= key.trim() %>" data-sort-value="<%= sortVal %>"<% if (key.trim() === 'Result' && obj._resultReason) { %> title="<%= String(obj._resultReason).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;') %>"<% } %> onclick=<%-`"window.location='/review?type=history&id=${obj.Id}'"`%>>
                  <%= obj[key] %>
                </td>
                  <% } %>
                <% } %>
              </tr>
              <% rowIndex++; } %>
            </tbody>
          </table>
        </div>
        <script>
(function() {
    var table = document.querySelector('.my-games-panel table.sortable');
    if (!table) return;
    var thead = table.querySelector('thead tr');
    var tbody = table.querySelector('tbody');
    var sortState = { key: null, asc: true };
    function getSortValue(cell) {
        var key = cell.getAttribute('data-sort-key');
        var raw = cell.getAttribute('data-sort-value');
        if (key === 'rowIndex' || key === 'Date' || key === 'Moves') return Number(raw) || 0;
        return raw;
    }
    function compare(a, b) {
        var na = typeof a === 'number', nb = typeof b === 'number';
        if (na && nb) return a - b;
        if (na) return -1;
        if (nb) return 1;
        return String(a).localeCompare(String(b));
    }
    thead.addEventListener('click', function(ev) {
        var th = ev.target.closest('th.sortable-th');
        if (!th) return;
        ev.preventDefault();
        var key = th.getAttribute('data-sort-key');
        if (sortState.key === key) sortState.asc = !sortState.asc;
        else { sortState.key = key; sortState.asc = true; }
        var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
        rows.sort(function(ra, rb) {
            var ca = ra.querySelector('td[data-sort-key="' + key + '"]');
            var cb = rb.querySelector('td[data-sort-key="' + key + '"]');
            if (!ca || !cb) return 0;
            var va = getSortValue(ca), vb = getSortValue(cb);
            var cmp = compare(va, vb);
            return sortState.asc ? cmp : -cmp;
        });
        rows.forEach(function(r) { tbody.appendChild(r); });
        rows.forEach(function(r, i) {
            var numCell = r.querySelector('td[data-sort-key="rowIndex"]');
            if (numCell) { numCell.setAttribute('data-sort-value', i); numCell.textContent = i + 1; }
        });
        thead.querySelectorAll('.sort-icon').forEach(function(icon) { icon.textContent = ''; icon.classList.remove('asc', 'desc'); });
        var activeIcon = th.querySelector('.sort-icon');
        if (activeIcon) {
            activeIcon.textContent = sortState.asc ? '\u25B2' : '\u25BC';
            activeIcon.classList.add(sortState.asc ? 'asc' : 'desc');
        }
    });
})();
        </script>
        <% } else { %>
        <div class="no-games-message">
          <p>No completed games yet</p>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
