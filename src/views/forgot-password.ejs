<% layout("../views/layouts/boilerplate") %>

<link rel="stylesheet" href="/login.css?v=login-recover-1">

<section class="login-screen login-screen--recover" id="forgotPasswordScreen">
  <form class="login-form login-recover-form" id="forgotPasswordForm" novalidate>
    <h1 class="login-prompt" id="forgotPasswordHeading"><%= pageTitle %></h1>
    <p class="login-recover-lead"><%= pageLead %></p>

    <label class="login-recover-label" for="forgotEmail"><%= t('auth.emailField') %></label>
    <div class="login-row">
      <input
        id="forgotEmail"
        name="email"
        class="login-input login-input--email"
        type="email"
        autocomplete="email"
        maxlength="120"
        required
        aria-describedby="forgotPasswordStatus"
      >
    </div>

    <p class="login-error" id="forgotPasswordError" role="alert" hidden></p>
    <p class="login-recover-status" id="forgotPasswordStatus" role="status" hidden></p>

    <p class="login-recover-actions">
      <button type="submit" class="login-recover-btn" id="forgotPasswordSubmit">
        <%= t('auth.sendRecoveryLink') %>
      </button>
    </p>
    <p class="login-recover-back">
      <a href="/login"><%= t('auth.backToLogin') %></a>
    </p>
  </form>
</section>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function () {
  function t(key, params) {
    if (window.ShmerlingStrings && typeof window.ShmerlingStrings.t === "function") {
      return window.ShmerlingStrings.t(key, params);
    }
    return key;
  }

  var form = document.getElementById("forgotPasswordForm");
  var emailInput = document.getElementById("forgotEmail");
  var errorEl = document.getElementById("forgotPasswordError");
  var statusEl = document.getElementById("forgotPasswordStatus");
  var submitBtn = document.getElementById("forgotPasswordSubmit");
  if (!form || !emailInput) {
    return;
  }

  form.addEventListener("submit", function (event) {
    event.preventDefault();
    if (errorEl) {
      errorEl.hidden = true;
      errorEl.textContent = "";
    }
    if (statusEl) {
      statusEl.hidden = true;
      statusEl.textContent = "";
    }
    var email = String(emailInput.value || "").trim();
    if (!email) {
      if (errorEl) {
        errorEl.textContent = t("auth.emailRequired");
        errorEl.hidden = false;
      }
      return;
    }
    if (submitBtn) {
      submitBtn.disabled = true;
    }
    fetch("/api/forgot-password", {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json", "Accept": "application/json" },
      body: JSON.stringify({ email: email }),
    })
      .then(function (res) {
        return res.json().catch(function () {
          return { ok: false, message: t("auth.recoveryRequestFailed") };
        }).then(function (body) {
          return { res: res, body: body };
        });
      })
      .then(function (result) {
        if (submitBtn) {
          submitBtn.disabled = false;
        }
        if (result.res.status === 429) {
          if (errorEl) {
            errorEl.textContent = (result.body && result.body.message)
              || t("auth.recoveryTooMany");
            errorEl.hidden = false;
          }
          return;
        }
        if (statusEl) {
          statusEl.textContent = (result.body && result.body.message)
            || t("auth.recoverySentGeneric");
          statusEl.hidden = false;
        }
        emailInput.value = "";
      })
      .catch(function () {
        if (submitBtn) {
          submitBtn.disabled = false;
        }
        if (errorEl) {
          errorEl.textContent = t("auth.recoveryRequestFailed");
          errorEl.hidden = false;
        }
      });
  });
})();
</script>
