<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'en' %>" dir="<%= typeof htmlDir !== 'undefined' ? htmlDir : 'ltr' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('play.appTitle') %></title>
  <link rel="stylesheet" href="/app.css">
  <link rel="stylesheet" href="/a11y.css">
  <% if (typeof username !== 'undefined' && username) { %>
  <link rel="stylesheet" href="/app/ui/app.css">
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Cinzel:wght@600;700&family=Cormorant+Garamond:wght@600;700&family=EB+Garamond:wght@600;700&family=Libre+Baskerville:wght@700&family=Merriweather:wght@700;900&family=Oswald:wght@600;700&family=Raleway:wght@600;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="/ChessGame.js"></script>
  <script src="/themes.js"></script>
  <script src="/pieceSets.js"></script>
  <script src="/strings/en.js"></script>
  <script src="/strings/en-extra.js"></script>
  <script src="/strings/he.js"></script>
  <script src="/strings/he-extra.js"></script>
  <script src="/strings/ja.js"></script>
  <script src="/strings/ja-extra.js"></script>
  <script src="/strings/fr.js"></script>
  <script src="/strings/fr-extra.js"></script>
  <script src="/strings/de.js"></script>
  <script src="/strings/de-extra.js"></script>
  <script src="/strings/zh.js"></script>
  <script src="/strings/zh-extra.js"></script>
  <script src="/strings/ar.js"></script>
  <script src="/strings/ar-extra.js"></script>
  <script src="/strings/hi.js"></script>
  <script src="/strings/hi-extra.js"></script>
  <script src="/strings/es.js"></script>
  <script src="/strings/es-extra.js"></script>
  <script src="/strings/ru.js"></script>
  <script src="/strings/ru-extra.js"></script>
  <script src="/strings/uk.js"></script>
  <script src="/strings/uk-extra.js"></script>
  <script src="/strings/no.js"></script>
  <script src="/strings/no-extra.js"></script>
  <script src="/strings/bn.js"></script>
  <script src="/strings/bn-extra.js"></script>
  <script src="/strings/pt.js"></script>
  <script src="/strings/pt-extra.js"></script>
  <script src="/strings/index.js"></script>
  <script src="/strings/t-bridge.js"></script>
  <script src="/validation/positionValidation.js"></script>
  <script src="/chessboard.js"></script>
  <script src="/lobby.js"></script>
  <script src="/customValidation.js"></script>
  <script src="/a11y/focusTrap.js"></script>
  <script src="/a11y/bindUiActions.js"></script>
  <script src="/a11y/enhanceClickables.js"></script>
  <script src="/siteDialogs.js"></script>
  <% if (typeof username !== 'undefined' && username) { %>
  <script src="/app/ui/play-shell-detect.js"></script>
  <script src="/app/ui/desktop-theme-keys.js"></script>
  <script src="/app/ui/desktop-custom-theme.js"></script>
  <script src="/app/ui/desktop-theme.js"></script>
  <script src="/app/ui/desktop-api.js"></script>
  <script src="/app/ui/desktop-game-settings.js"></script>
  <script src="/app/ui/desktop-prefs-gameplay.js"></script>
  <script src="/app/ui/desktop-fullscreen.js"></script>
  <script src="/app/ui/desktop-prefs-display.js"></script>
  <script src="/app/ui/desktop-prefs-language.js"></script>
  <script src="/app/ui/desktop-chrome.js"></script>
  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
    window.__SHMERLING_USER_TYPE__ = <%- JSON.stringify(typeof userType !== 'undefined' && userType ? userType : 'Member') %>;
    window.__SHMERLING_PLAY_ADVANCED__ = <%= (typeof canPlayAdvanced !== 'undefined' && canPlayAdvanced) ? 'true' : 'false' %>;
    window.__SHMERLING_CAN_CUSTOMIZE_THEMES__ = <%= (typeof canCustomizeThemes !== 'undefined' && canCustomizeThemes) ? 'true' : 'false' %>;
    window.__SHMERLING_CAN_DEBUG__ = <%= (typeof canDebug !== 'undefined' && canDebug) ? 'true' : 'false' %>;
  </script>
  <script src="/lobbyPresence.js"></script>
  <script src="/friendInviteOptions.js"></script>
  <script src="/friendGameInvite.js"></script>
  <% } %>
</head>

<body<% if (typeof hideTopbar !== 'undefined' && hideTopbar) { %> class="hide-topbar"<% } %>>
  <%- include('../partials/skip-link') %>
  <% if(username) { %>
  <%- include('../partials/topbar', { showWebPreferences: true }) %>
  <% }%>

  <%- include("../partials/flash") %>

  <main id="main-content" tabindex="-1">
    <%-body %>

  </main>
  <div id="a11yBoardAnnounce" class="a11y-sr-only" aria-live="polite" aria-atomic="true"></div>
  <div id="paletteSelctor" class="palettes">
  </div>

  <%- include('../partials/footer') %>

  <%- include('../partials/site-dialogs') %>

  <% if (typeof username !== 'undefined' && username) { %>
  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
    (function () {
      function ping() {
        fetch("/api/presence/ping", { method: "POST", credentials: "same-origin" }).catch(function () {});
      }
      ping();
      setInterval(ping, 45000);
    })();
  </script>
  <% } %>

</body>

</html>