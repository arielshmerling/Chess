<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'en' %>" dir="<%= typeof htmlDir !== 'undefined' ? htmlDir : 'ltr' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Home — Chess</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/app.css">
  <link rel="stylesheet" href="/a11y.css">
  <link rel="stylesheet" href="/welcome.css">
  <link rel="stylesheet" href="/friends.css">
  <link rel="stylesheet" href="/assets/mobile-welcome.css">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <%- include('../partials/locale-scripts') %>
  <script src="/themes.js" defer></script>
  <script src="/pieceSets.js" defer></script>
  <script src="/lobby.js" defer></script>
  <script src="/a11y/focusTrap.js" defer></script>
  <script src="/a11y/bindUiActions.js" defer></script>
  <script src="/a11y/enhanceClickables.js" defer></script>
  <script src="/siteDialogs.js" defer></script>
  <% if (typeof username !== 'undefined' && username) { %>
  <script src="/lobbyPresence.js"></script>
  <script src="/friendInviteOptions.js"></script>
  <script src="/friendGameInvite.js"></script>
  <% } %>
</head>

<body class="mobile-home-shell">
  <%- include('../partials/skip-link') %>
  <% if(username) { %>
  <%- include('../partials/mobile-home-topbar') %>
  <% }%>

  <%- include("../partials/flash") %>

  <main id="main-content" tabindex="-1">
    <%-body %>
  </main>
  <div id="a11yBoardAnnounce" class="a11y-sr-only" aria-live="polite" aria-atomic="true"></div>

  <div id="paletteSelctor" class="palettes"></div>

  <%- include('../partials/footer') %>

  <%- include('../partials/site-dialogs') %>

  <% if (typeof username !== 'undefined' && username) { %>
  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
    (function () {
      function ping() {
        fetch("/api/presence/ping", { method: "POST", credentials: "same-origin" }).catch(function () {});
      }
      ping();
      setInterval(ping, 45000);
    })();
  </script>
  <% } %>

</body>

</html>
