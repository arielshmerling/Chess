<% layout("../views/layouts/boilerplate") %>

<link rel="stylesheet" href="/login.css?v=login-transparent-1">

<section class="login-screen" id="loginScreen" data-step="username">
  <form method="post" action="/login" class="login-form" id="loginForm" novalidate>
    <p class="login-prompt" id="loginPrompt" role="status" aria-live="polite"><%= t('auth.whoAreYou') %></p>

    <div class="login-row" id="loginRow">
      <input
        id="username"
        name="username"
        class="login-input login-input--username"
        type="text"
        autocomplete="username"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        maxlength="30"
        autofocus
        required
        aria-label="<%= t('auth.usernameField') %>">
      <input
        id="password"
        name="password"
        class="login-input login-input--password"
        type="password"
        autocomplete="current-password"
        spellcheck="false"
        required
        aria-label="<%= t('auth.passwordField') %>">
      <button type="submit" class="login-next" id="loginNext" aria-label="<%= t('auth.continue') %>">
        <svg class="login-next-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M5 12h13M12 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    <p class="login-error" id="loginError" role="alert"><%= errorMessage %></p>
  </form>

  <p class="login-version"><%= appVersion %></p>
</section>

<script src="/loginFlow.js"></script>
