<% layout("../views/layouts/boilerplate") %>
<form method="post" action="/register" class="validated-form" novalidate>
  <div class="loginBoxWrapper">
    <div class="loginBox">
      <div class="labelRow"> <label for="username"><%= t('site.username') %></label> </div>
      <div class="labelRow"> <input id="username" username="username" name="username" autofocus autocomplete="username" required><span></span></div><span id="usernameValidationMessage" class="validationMessage"></span>
      <br>
      <div class="labelRow"><label for="password"><%= t('site.password') %></label></div>
      <div class="labelRow"> <input id="password" name="password" type="password" autocomplete="new-password" required minlength="4" maxlength="30"><span></span></div><span id="passwordValidationMessage" class="validationMessage"></span>
      <br>
      <div class="labelRow"><label for="confirmPassword"><%= t('site.register.confirmPassword') %></label> </div>
      <div class="labelRow"> <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required><span class="ht"></span></div>
      <span id="confirmPasswordValidationMessage" class="validationMessage"></span>
      <br>
      <div class="labelRow"><label id="levelLabel"><%= t('site.register.playerLevel') %></label></div>
      <div class="selectionBox" role="radiogroup" aria-labelledby="levelLabel">
        <div class="selectionOption selectedOption" role="radio" aria-checked="true" tabindex="0" data-value="Rookie"><%= t('site.register.rookie') %></div>
        <div class="selectionOption" role="radio" aria-checked="false" tabindex="-1" data-value="Skilled"><%= t('site.register.skilled') %></div>
        <div class="selectionOption" role="radio" aria-checked="false" tabindex="-1" data-value="Elite"><%= t('site.register.elite') %></div>
        <div class="selectionOption" role="radio" aria-checked="false" tabindex="-1" data-value="Grand Master"><%= t('site.register.grandMaster') %></div>
      </div>
      <input type="hidden" id="level" name="level" value="Rookie" />

      <br><br>
      <button class="button" type="submit"><%= t('site.register.submit') %></button>
    </div>
  </div>
</form>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
  (function () {
    var box = document.querySelector(".selectionBox[role='radiogroup']");
    var hidden = document.getElementById("level");
    if (!box || !hidden) {
      return;
    }
    var options = Array.prototype.slice.call(box.querySelectorAll('[role="radio"]'));

    function selectOption(selected) {
      options.forEach(function (opt) {
        var on = opt === selected;
        opt.classList.toggle("selectedOption", on);
        opt.setAttribute("aria-checked", on ? "true" : "false");
        opt.setAttribute("tabindex", on ? "0" : "-1");
      });
      hidden.value = selected.getAttribute("data-value") || selected.textContent.trim();
      selected.focus();
    }

    options.forEach(function (opt) {
      opt.addEventListener("click", function () {
        selectOption(opt);
      });
      opt.addEventListener("keydown", function (e) {
        var idx = options.indexOf(opt);
        if (e.key === " " || e.key === "Enter") {
          e.preventDefault();
          selectOption(opt);
          return;
        }
        if (e.key === "ArrowRight" || e.key === "ArrowDown") {
          e.preventDefault();
          selectOption(options[(idx + 1) % options.length]);
        } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
          e.preventDefault();
          selectOption(options[(idx - 1 + options.length) % options.length]);
        }
      });
    });
  })();
</script>
<script src="formValidations.js"></script>
<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
  window.onload = function () {
    if (typeof overrideFormValidity === "function") {
      overrideFormValidity();
    }
  };
</script>
