<% layout("../views/layouts/boilerplate") %>

<link rel="stylesheet" href="/welcome.css">
<link rel="stylesheet" href="/board-geometry.css">

<div class="welcome-container active-games-list-page board-geometry">
  <header class="hero-banner hero-banner--board">
    <div class="hero-board-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text-section">
        <h1 class="hero-username"><%= t('site.activeGamesList.title') %></h1>
        <p class="hero-tagline"><%= t('site.activeGamesList.tagline') %></p>
      </div>
    </div>
  </header>

  <div class="games-section">
    <section class="games-panel online-games-panel active-games-list-panel">
      <div class="panel-header">
        <div class="panel-header-top">
          <div class="panel-title-group">
            <h2 class="panel-title"><%= t('site.activeGamesList.liveGames') %></h2>
          </div>
        </div>
      </div>
      <div class="panel-body online-games-body<% if (allGames && allGames.length > 0) { %> has-online-games<% } %>" id="active-list-container">
        <div class="table-scroll" id="active-list-table-wrap">
          <table class="games-table">
            <thead>
              <tr>
                <th>#</th>
                <th><%= t('site.activeGamesList.game') %></th>
                <th><%= t('site.activeGamesList.started') %></th>
                <th><%= t('site.activeGames.moves') %></th>
                <th><%= t('site.activeGames.status') %></th>
              </tr>
            </thead>
            <tbody id="active-list-tbody">
              <% if(allGames && allGames.length > 0) { %>
              <% var rowNum = 1; for(var idx = 0; idx < allGames.length; idx++) { var obj = allGames[idx]; %>
              <% var playBase = (typeof canUsePlayPage !== 'undefined' && canUsePlayPage) ? '/play' : '/game'; %>
              <% var gameUrl = (obj.IsParticipant && (obj.StatusKey === 'inProgress' || obj.StatusKey === 'onHold' || obj.Status === 'In progress' || obj.Status === 'On hold'))
                ? playBase + '?id=' + obj.Id
                : ((typeof canUsePlayPage !== 'undefined' && canUsePlayPage)
                    ? '/play?id=' + obj.Id + '&mode=watch'
                    : '/watch?id=' + obj.Id); %>
              <tr data-game-id="<%= obj.Id %>" onclick="window.location='<%= gameUrl %>'">
                <td class="row-number"><%= rowNum++ %></td>
                <td class="Game"><%= obj.Game %></td>
                <td class="Started" title="<%= obj.StartedTooltip || '' %>"><%= obj.Started %></td>
                <td class="Moves"><%= obj.Moves %></td>
                <td class="Status" data-status-key="<%= obj.StatusKey || '' %>"><%= obj.Status || t('site.activeGames.inProgress') %></td>
              </tr>
              <% } %>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="no-games-message" id="active-list-no-games">
          <p><%= t('site.welcome.noGamesNow') %></p>
        </div>
      </div>
    </section>
  </div>

  <%- include('partials/site-page-footer') %>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function() {
  function t(key, params) {
    if (window.ShmerlingStrings && typeof window.ShmerlingStrings.t === "function") {
      return window.ShmerlingStrings.t(key, params);
    }
    return key;
  }
  window.__WELCOME_USERNAME__ = <%- typeof username !== 'undefined' && username ? JSON.stringify(String(username)) : '""' %>;
  var container = document.getElementById("active-list-container");
  var tbody = document.getElementById("active-list-tbody");
  var tableWrap = document.getElementById("active-list-table-wrap");
  var noGamesMsg = document.getElementById("active-list-no-games");
  function setVisibility() {
    var hasRows = tbody && tbody.querySelectorAll("tr").length > 0;
    if (container) container.classList.toggle("has-online-games", !!hasRows);
    if (tableWrap) tableWrap.style.display = hasRows ? "" : "none";
    if (noGamesMsg) noGamesMsg.style.display = hasRows ? "none" : "block";
  }
  function renumberRows() {
    if (!tbody) return;
    var rows = tbody.querySelectorAll("tr");
    for (var i = 0; i < rows.length; i++) {
      var numCell = rows[i].querySelector("td.row-number");
      if (numCell) numCell.textContent = i + 1;
    }
  }
  function getGameRowUrl(id, data) {
    var isParticipant = data.isParticipant === true || (window.__WELCOME_USERNAME__ && data.whitePlayerName !== undefined && (data.whitePlayerName === window.__WELCOME_USERNAME__ || data.blackPlayerName === window.__WELCOME_USERNAME__));
    var statusKey = data.StatusKey || "";
    var stLower = String(data.status || data.Status || "").toLowerCase();
    var joinable = statusKey === "inProgress" || statusKey === "onHold" ||
      stLower === "in progress" || stLower === "on hold";
    if (isParticipant && joinable) {
      return (window.__SHMERLING_USE_NEW_PLAY_UI__ ? "/play?id=" : "/game?id=") + encodeURIComponent(id);
    }
    if (window.__SHMERLING_USE_NEW_PLAY_UI__) {
      return "/play?id=" + encodeURIComponent(id) + "&mode=watch";
    }
    return "/watch?id=" + encodeURIComponent(id);
  }
  function addOrUpdateGameRow(data) {
    if (!tbody || !data.gameId) return;
    var id = String(data.gameId);
    var url = getGameRowUrl(id, data);
    var tr = tbody.querySelector("tr[data-game-id=\"" + id + "\"]");
    function normStatus(d) {
      if (d.StatusKey === "onHold" || d.status === "on hold" || d.Status === "On hold") {
        return { key: "onHold", label: t("site.activeGames.onHold") };
      }
      if (d.StatusKey === "inProgress" || d.status === "in progress" || d.Status === "In progress" || !d.Status) {
        return { key: "inProgress", label: t("site.activeGames.inProgress") };
      }
      if (d.Status) {
        return { key: d.StatusKey || "", label: d.Status };
      }
      return { key: "inProgress", label: t("site.activeGames.inProgress") };
    }
    function formatStarted(d) {
      if (d.Started) return d.Started;
      if (d.StartedMinutes == null && !d.startedAtMs) return t("site.activeGames.notStarted");
      var minutes = d.StartedMinutes;
      if (minutes == null && d.startedAtMs) {
        minutes = Math.max(0, parseInt((Date.now() - d.startedAtMs) / 1000 / 60, 10) || 0);
      }
      if (minutes < 1) return t("site.activeGames.justStarted");
      if (minutes === 1) return t("site.activeGames.oneMinuteAgo");
      return t("site.activeGames.minutesAgo", { count: minutes });
    }
    function escHtml(s) {
      return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
    var statusInfo = normStatus(data);
    var startedLabel = formatStarted(data);
    if (tr) {
      var gCell = tr.querySelector("td.Game");
      var sCell = tr.querySelector("td.Started");
      var mCell = tr.querySelector("td.Moves");
      var statusCell = tr.querySelector("td.Status");
      if (gCell) gCell.textContent = data.Game || "";
      if (sCell) {
        sCell.textContent = startedLabel;
        if (data.StartedTooltip) sCell.title = data.StartedTooltip;
      }
      if (mCell) mCell.textContent = data.Moves != null ? data.Moves : "0";
      if (statusCell) {
        statusCell.textContent = statusInfo.label;
        if (statusInfo.key) statusCell.setAttribute("data-status-key", statusInfo.key);
      }
      tr.onclick = function() { window.location = url; };
      return;
    }
    tr = document.createElement("tr");
    tr.setAttribute("data-game-id", id);
    tr.onclick = function() { window.location = url; };
    var tt = (data.StartedTooltip || "").replace(/"/g, "&quot;");
    tr.innerHTML = "<td class=\"row-number\">0</td><td class=\"Game\">" + escHtml(data.Game) + "</td><td class=\"Started\" title=\"" + tt + "\">" + escHtml(startedLabel) + "</td><td class=\"Moves\">" + (data.Moves != null ? data.Moves : "0") + "</td><td class=\"Status\" data-status-key=\"" + escHtml(statusInfo.key) + "\">" + escHtml(statusInfo.label) + "</td>";
    tbody.appendChild(tr);
    renumberRows();
    setVisibility();
  }
  function updateGameRow(gameId, data) {
    if (!tbody) return;
    var tr = tbody.querySelector("tr[data-game-id=\"" + String(gameId) + "\"]");
    if (!tr) return;
    if (data.movesCount != null) {
      var movesCell = tr.querySelector("td.Moves");
      if (movesCell) movesCell.textContent = data.movesCount;
    }
    if (data.status === "game over") {
      tr.remove();
      renumberRows();
      setVisibility();
    }
  }
  if (container && tbody) setVisibility();

  function refreshActiveGamesFromServer() {
    fetch("/active-games?limit=100", { credentials: "same-origin" })
      .then(function(r) { return r.ok ? r.json() : []; })
      .then(function(games) {
        if (!tbody || !Array.isArray(games)) return;
        var ids = games.map(function(g) { return String(g.Id); });
        games.forEach(function(g) {
          addOrUpdateGameRow({
            gameId: g.Id,
            Game: g.Game,
            Started: g.Started,
            StartedTooltip: g.StartedTooltip,
            StartedMinutes: g.StartedMinutes,
            startedAtMs: g.startedAtMs,
            Moves: g.Moves,
            Status: g.Status,
            StatusKey: g.StatusKey,
            isParticipant: g.IsParticipant,
            whitePlayerName: g.whitePlayerName,
            blackPlayerName: g.blackPlayerName
          });
        });
        tbody.querySelectorAll("tr[data-game-id]").forEach(function(tr) {
          if (ids.indexOf(tr.getAttribute("data-game-id")) === -1) tr.remove();
        });
        renumberRows();
        setVisibility();
      })
      .catch(function() {});
  }

  setInterval(refreshActiveGamesFromServer, 8000);
  refreshActiveGamesFromServer();

  window.addEventListener("site-ws-message", function (ev) {
    var msg = ev.detail;
    if (!msg) return;
    if (msg.type === "onlineGameInProgress" && msg.data) addOrUpdateGameRow(msg.data);
    if (msg.type === "onlineGameUpdated" && msg.data) updateGameRow(msg.data.gameId, msg.data);
  });
})();
</script>
