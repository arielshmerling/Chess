<% const notFound = Number(statusCode) === 404; %>
<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'en' %>" dir="<%= typeof htmlDir !== 'undefined' ? htmlDir : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= notFound ? t('errorPage.notFoundTitle') : t('errorPage.genericTitle') %> · <%= t('play.appTitle') %></title>
    <link rel="stylesheet" href="/error.css">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
</head>
<body>
    <main class="error-page">
        <section class="error-content" aria-labelledby="errorTitle">
            <p class="error-code"><%= t('errorPage.code', { code: statusCode }) %></p>
            <h1 class="error-title" id="errorTitle">
                <%= notFound ? t('errorPage.notFoundTitle') : t('errorPage.genericTitle') %>
            </h1>
            <p class="error-message">
                <%= notFound ? t('errorPage.notFoundMessage') : t('errorPage.genericMessage') %>
            </p>
            <a class="error-home" href="/home">
                <span class="error-home-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M19 12H6M12 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                <span><%= t('errorPage.backHome') %></span>
            </a>
        </section>
    </main>
</body>
</html>