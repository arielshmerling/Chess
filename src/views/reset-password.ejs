<% layout("../views/layouts/boilerplate") %>

<link rel="stylesheet" href="/login.css?v=login-recover-1">

<section class="login-screen login-screen--recover" id="resetPasswordScreen">
  <% if (tokenMissing) { %>
    <div class="login-form login-recover-form">
      <h1 class="login-prompt"><%= pageTitle %></h1>
      <p class="login-recover-lead"><%= t('auth.resetTokenMissing') %></p>
      <p class="login-recover-back">
        <a href="/forgot-password"><%= t('auth.requestNewLink') %></a>
        ·
        <a href="/login"><%= t('auth.backToLogin') %></a>
      </p>
    </div>
  <% } else { %>
  <form class="login-form login-recover-form" id="resetPasswordForm" novalidate>
    <h1 class="login-prompt"><%= pageTitle %></h1>
    <p class="login-recover-lead"><%= pageLead %></p>

    <input type="hidden" id="resetToken" name="token" value="<%= resetToken %>">

    <label class="login-recover-label" for="resetEmail"><%= t('auth.emailField') %></label>
    <div class="login-row">
      <input
        id="resetEmail"
        name="email"
        class="login-input login-input--email"
        type="email"
        autocomplete="email"
        maxlength="120"
        required
      >
    </div>

    <label class="login-recover-label" for="resetNewPassword"><%= t('auth.newPasswordField') %></label>
    <div class="login-row">
      <input
        id="resetNewPassword"
        name="newPassword"
        class="login-input login-input--password"
        type="password"
        autocomplete="new-password"
        minlength="4"
        maxlength="30"
        required
      >
    </div>

    <label class="login-recover-label" for="resetConfirmPassword"><%= t('auth.confirmPasswordField') %></label>
    <div class="login-row">
      <input
        id="resetConfirmPassword"
        name="confirmPassword"
        class="login-input login-input--password"
        type="password"
        autocomplete="new-password"
        minlength="4"
        maxlength="30"
        required
      >
    </div>

    <p class="login-error" id="resetPasswordError" role="alert" hidden></p>
    <p class="login-recover-status" id="resetPasswordStatus" role="status" hidden></p>

    <p class="login-recover-actions">
      <button type="submit" class="login-recover-btn" id="resetPasswordSubmit">
        <%= t('auth.saveNewPassword') %>
      </button>
    </p>
    <p class="login-recover-back">
      <a href="/login"><%= t('auth.backToLogin') %></a>
    </p>
  </form>
  <% } %>
</section>

<% if (!tokenMissing) { %>
<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function () {
  function t(key, params) {
    if (window.ShmerlingStrings && typeof window.ShmerlingStrings.t === "function") {
      return window.ShmerlingStrings.t(key, params);
    }
    return key;
  }

  var form = document.getElementById("resetPasswordForm");
  var errorEl = document.getElementById("resetPasswordError");
  var statusEl = document.getElementById("resetPasswordStatus");
  var submitBtn = document.getElementById("resetPasswordSubmit");
  if (!form) {
    return;
  }

  form.addEventListener("submit", function (event) {
    event.preventDefault();
    if (errorEl) {
      errorEl.hidden = true;
      errorEl.textContent = "";
    }
    if (statusEl) {
      statusEl.hidden = true;
      statusEl.textContent = "";
    }
    var token = String((document.getElementById("resetToken") || {}).value || "");
    var email = String((document.getElementById("resetEmail") || {}).value || "").trim();
    var newPassword = String((document.getElementById("resetNewPassword") || {}).value || "");
    var confirmPassword = String((document.getElementById("resetConfirmPassword") || {}).value || "");
    if (!email || !newPassword || !confirmPassword) {
      if (errorEl) {
        errorEl.textContent = t("auth.resetFieldsRequired");
        errorEl.hidden = false;
      }
      return;
    }
    if (newPassword !== confirmPassword) {
      if (errorEl) {
        errorEl.textContent = t("auth.passwordMismatch");
        errorEl.hidden = false;
      }
      return;
    }
    if (submitBtn) {
      submitBtn.disabled = true;
    }
    fetch("/api/reset-password", {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json", "Accept": "application/json" },
      body: JSON.stringify({
        token: token,
        email: email,
        newPassword: newPassword,
        confirmPassword: confirmPassword,
      }),
    })
      .then(function (res) {
        return res.json().catch(function () {
          return { ok: false, message: t("auth.resetFailed") };
        }).then(function (body) {
          return { res: res, body: body };
        });
      })
      .then(function (result) {
        if (result.res.ok && result.body && result.body.ok) {
          if (statusEl) {
            statusEl.textContent = t("auth.resetSuccess");
            statusEl.hidden = false;
          }
          window.setTimeout(function () {
            window.location.href = result.body.redirectUrl || "/login";
          }, 1200);
          return;
        }
        if (submitBtn) {
          submitBtn.disabled = false;
        }
        if (errorEl) {
          errorEl.textContent = (result.body && result.body.message)
            || t("auth.resetFailed");
          errorEl.hidden = false;
        }
      })
      .catch(function () {
        if (submitBtn) {
          submitBtn.disabled = false;
        }
        if (errorEl) {
          errorEl.textContent = t("auth.resetFailed");
          errorEl.hidden = false;
        }
      });
  });
})();
</script>
<% } %>
