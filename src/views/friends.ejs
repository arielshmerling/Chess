<% layout("../views/layouts/boilerplate") %>

<link rel="stylesheet" href="/welcome.css">
<link rel="stylesheet" href="/board-geometry.css">
<link rel="stylesheet" href="/friends.css">

<div class="friends-page welcome-container board-geometry">
  <header class="hero-banner hero-banner--board">
    <div class="hero-board-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text-section">
        <h1 class="hero-username"><%= t('site.friendsPage.title') %></h1>
        <p class="hero-tagline"><%= t('site.friendsPage.tagline') %></p>
      </div>
    </div>
  </header>

  <div class="games-section friends-section">
    <div class="friends-two-columns">
      <section class="games-panel friends-list-panel">
        <div class="panel-header">
          <div class="panel-header-top">
            <div class="panel-title-group">
              <h2 class="panel-title"><%= t('site.friendsPage.myFriends') %></h2>
            </div>
          </div>
        </div>
        <div class="panel-body">
          <div id="friendsEmpty" class="no-games-message">
            <p><%= t('site.friendsPage.noFriendsYet') %></p>
          </div>
          <ul id="friendsList" class="friends-user-list" aria-live="polite"></ul>
        </div>
      </section>

      <section class="games-panel friends-search-panel">
        <div class="panel-header">
          <div class="panel-header-top">
            <div class="panel-title-group">
              <h2 class="panel-title"><%= t('site.friendsPage.findPlayers') %></h2>
            </div>
          </div>
          <p class="panel-subtitle"><%= t('site.friendsPage.searchByUsername') %></p>
        </div>
        <div class="panel-body">
          <div class="friends-search-row">
            <label class="friends-search-label" for="friendSearchInput"><%= t('site.username').replace(':', '') %></label>
            <input type="text" id="friendSearchInput" class="friends-search-input" autocomplete="off" maxlength="48" placeholder="<%= t('site.friendsPage.searchPlaceholder') %>" aria-describedby="friendSearchHint">
          
          </div>
          <ul id="searchResults" class="friends-user-list friends-search-results" aria-live="polite"></ul>
          <div id="searchPlaceholder" class="friends-search-placeholder"><%= t('site.friendsPage.enterCharToSearch') %></div>
        </div>
      </section>
    </div>
  </div>

  <%- include('partials/site-page-footer') %>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
window.__FRIENDS_PAGE_USERNAME__ = <%- JSON.stringify(typeof sessionUsername !== "undefined" && sessionUsername != null ? sessionUsername : "") %>;
</script>
<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function () {
  function t(key, params) {
    if (window.ShmerlingStrings && typeof window.ShmerlingStrings.t === "function") {
      return window.ShmerlingStrings.t(key, params);
    }
    return key;
  }

  var friendsList = document.getElementById("friendsList");
  var friendsEmpty = document.getElementById("friendsEmpty");
  var searchInput = document.getElementById("friendSearchInput");
  var searchResults = document.getElementById("searchResults");
  var searchPlaceholder = document.getElementById("searchPlaceholder");
  var searchTimer = null;

  /** Live WS presence; reconciled from API on each /api/friends/data fetch so it cannot stay wrong after reconnects. */
  var liveOnlineByUserId = {};
  var wsResyncTimer = null;
  /** Usernames currently in an active online game (lobby WS). */
  var playingUsernames = {};
  /** gameId -> { w, b } for clearing playing when a game ends. */
  var gamePlayersById = {};
  /** After a friend accepts, show “Joining…” on the inviter’s row until timeout or navigation (not “Rejoin” immediately). */
  var pendingInviterJoiningGameId = null;
  var pendingInviterJoiningUntil = 0;
  var JOINING_LABEL_MS = 15000;
  var joiningLabelRevertTimer = null;

  function markInviterJoiningGame(gameId) {
    if (!gameId) return;
    pendingInviterJoiningGameId = String(gameId);
    pendingInviterJoiningUntil = Date.now() + JOINING_LABEL_MS;
    if (joiningLabelRevertTimer) clearTimeout(joiningLabelRevertTimer);
    joiningLabelRevertTimer = setTimeout(function () {
      joiningLabelRevertTimer = null;
      pendingInviterJoiningGameId = null;
      pendingInviterJoiningUntil = 0;
      if (friendsList) applyPresenceToAllVisibleFriends();
    }, JOINING_LABEL_MS);
  }

  function esc(s) {
    return String(s == null ? "" : s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function postJson(url, body) {
    return fetch(url, {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify(body || {}),
    }).then(function (r) {
      return r.json().then(function (data) {
        if (!r.ok) throw new Error((data && data.message) || r.statusText || t("site.friendsPage.requestFailed"));
        return data;
      });
    });
  }

  function statusTitle(st) {
    if (st === "playing") return t("site.friendsPage.playing");
    if (st === "online") return t("site.friendsPage.online");
    if (st === "pending") return t("site.friendsPage.pendingFriendshipOffer");
    return t("site.friendsPage.offline");
  }

  function computeEffectiveStatus(f) {
    if (f.rowType === "pendingOut") return "pending";
    if (f.username && playingUsernames[f.username]) return "playing";
    if (Object.prototype.hasOwnProperty.call(liveOnlineByUserId, f.id)) {
      return liveOnlineByUserId[f.id] ? "online" : "offline";
    }
    return f.status || "offline";
  }

  function syncPlayingFromApi(friends) {
    if (!friends) return;
    friends.forEach(function (f) {
      if (f.rowType === "pendingOut") return;
      if (f.status === "playing") playingUsernames[f.username] = 1;
      else delete playingUsernames[f.username];
    });
  }

  /**
   * Server is source of truth for online/offline on each poll; WS only refines between polls.
   * Drops stale keys so old friendPresence values cannot paint everyone grey forever.
   */
  function mergePresenceFromApiFriends(friends) {
    if (!friends) return;
    var friendIds = {};
    friends.forEach(function (f) {
      if (f.rowType === "pendingOut") return;
      friendIds[f.id] = true;
      if (f.status === "playing") {
        delete liveOnlineByUserId[f.id];
        return;
      }
      liveOnlineByUserId[f.id] = f.status === "online";
    });
    Object.keys(liveOnlineByUserId).forEach(function (k) {
      if (!friendIds[k]) delete liveOnlineByUserId[k];
    });
  }

  function sharedGamePrimaryButtonLabel(sharedGid) {
    var gid = sharedGid != null ? String(sharedGid) : "";
    if (
      gid &&
      pendingInviterJoiningGameId &&
      gid === pendingInviterJoiningGameId &&
      Date.now() < pendingInviterJoiningUntil
    ) {
      return t("site.friendsPage.joining");
    }
    return t("site.friendsPage.rejoin");
  }

  function setPrimaryActionButton(li, status) {
    var primary = li.querySelector(".friends-row-actions .friends-btn-primary");
    if (!primary) return;
    var sharedGid = li.getAttribute("data-shared-game-id");
    var fid = li.getAttribute("data-friend-id");
    var fun = li.getAttribute("data-friend-username") || "";
    if (status === "playing" && sharedGid) {
      primary.disabled = false;
      primary.textContent = sharedGamePrimaryButtonLabel(sharedGid);
      primary.setAttribute("data-action", "rejoin-game");
      primary.setAttribute("data-game-id", sharedGid);
      primary.removeAttribute("data-friend-id");
      primary.removeAttribute("data-username");
      primary.classList.remove("friends-btn-invite");
      primary.classList.add("friends-btn-rejoin");
      return;
    }
    primary.textContent = t("site.friendsPage.invite");
    primary.removeAttribute("data-action");
    primary.removeAttribute("data-game-id");
    if (fid) primary.setAttribute("data-friend-id", fid);
    if (fun) primary.setAttribute("data-username", fun);
    primary.classList.add("friends-btn-invite");
    primary.classList.remove("friends-btn-rejoin");
    primary.disabled = status !== "online";
  }

  function updateFriendRowVisual(userId, username, status) {
    if (!friendsList) return;
    var li = friendsList.querySelector('li[data-friend-id="' + userId + '"]');
    if (!li) return;
    if (li.getAttribute("data-friend-offer-in") === "true") return;
    if (li.getAttribute("data-friend-pending-out") === "true") return;
    if (li.getAttribute("data-friend-game-invite-pending") === "true") return;
    var dot = li.querySelector(".friends-status-dot");
    if (dot) {
      dot.className = "friends-status-dot friends-status-" + status;
      dot.title = statusTitle(status);
      dot.setAttribute("aria-label", statusTitle(status));
    }
    setPrimaryActionButton(li, status);
  }

  function applyPresenceToAllVisibleFriends() {
    if (!friendsList) return;
    var rows = friendsList.querySelectorAll("li[data-friend-id]");
    for (var i = 0; i < rows.length; i++) {
      var li = rows[i];
      if (li.getAttribute("data-friend-offer-in") === "true") continue;
      if (li.getAttribute("data-friend-pending-out") === "true") continue;
      if (li.getAttribute("data-friend-game-invite-pending") === "true") continue;
      var id = li.getAttribute("data-friend-id");
      var un = li.getAttribute("data-friend-username") || "";
      updateFriendRowVisual(id, un, computeEffectiveStatus({ id: id, username: un, status: "offline", rowType: "friend" }));
    }
  }

  function renderFriendsAndOffers(offersIn, friends, pendingGameInvite) {
    if (!friendsList || !friendsEmpty) return;
    friendsList.innerHTML = "";
    var offers = (offersIn || []).slice().sort(function (a, b) {
      return String(a.username || "").localeCompare(String(b.username || ""), undefined, { sensitivity: "base" });
    });
    var friendRows = friends || [];
    if (offers.length === 0 && friendRows.length === 0) {
      friendsEmpty.style.display = "block";
      return;
    }
    friendsEmpty.style.display = "none";
    var offerLabel = t("site.friendsPage.friendRequest");
    offers.forEach(function (o) {
      var li = document.createElement("li");
      li.className = "friends-friend-row friends-row-offer-in";
      li.setAttribute("data-friend-id", o.id);
      li.setAttribute("data-friend-offer-in", "true");
      li.innerHTML =
        '<span class="friends-offer-icon" role="img" title="' +
        esc(offerLabel) +
        '" aria-label="' +
        esc(offerLabel) +
        '"></span>' +
        '<span class="friends-username">' +
        esc(o.username) +
        ' <span class="friends-pending-suffix">' + t("site.friendsPage.wantsToBeFriends") + '</span></span>' +
        '<div class="friends-row-actions">' +
        '<button type="button" class="friends-btn friends-btn-primary" data-action="accept" data-id="' +
        esc(o.id) +
        '">' + t("site.friendsPage.accept") + '</button>' +
        '<button type="button" class="friends-btn friends-btn-muted" data-action="decline" data-id="' +
        esc(o.id) +
        '">' + t("site.friendsPage.decline") + '</button>' +
        "</div>";
      friendsList.appendChild(li);
    });
    friendRows.forEach(function (f) {
      var li = document.createElement("li");
      li.className = "friends-friend-row";
      li.setAttribute("data-friend-id", f.id);
      li.setAttribute("data-friend-username", f.username);
      if (f.rowType === "pendingOut") {
        li.setAttribute("data-friend-pending-out", "true");
        var pendTitle = statusTitle("pending");
        li.innerHTML =
          '<span class="friends-status-dot friends-status-pending" title="' +
          esc(pendTitle) +
          '" aria-label="' +
          esc(pendTitle) +
          '"></span>' +
          '<span class="friends-username">' +
          esc(f.username) +
          ' <span class="friends-pending-suffix">' + t("site.friendsPage.pendingOfferSuffix") + '</span></span>' +
          '<div class="friends-row-actions">' +
          '<button type="button" class="friends-btn friends-btn-primary friends-btn-invite" disabled data-friend-id="' +
          esc(f.id) +
          '" data-username="' +
          esc(f.username) +
          '">' + t("site.friendsPage.invite") + '</button>' +
          '<button type="button" class="friends-btn friends-btn-muted" data-action="withdraw-invite" data-id="' +
          esc(f.id) +
          '">' + t("site.friendsPage.withdraw") + '</button>' +
          "</div>";
      } else {
        var pg =
          pendingGameInvite &&
          pendingGameInvite.inviteeUserId === f.id &&
          f.rowType === "friend";
        if (pg) {
          var pendTitle = t("site.friendsPage.waitingFriendRespond");
          li.setAttribute("data-friend-game-invite-pending", "true");
          li.innerHTML =
            '<span class="friends-status-dot friends-status-online" title="' +
            esc(pendTitle) +
            '" aria-label="' +
            esc(pendTitle) +
            '"></span>' +
            '<span class="friends-username">' +
            esc(f.username) +
            "</span>" +
            '<div class="friends-row-actions">' +
            '<button type="button" class="friends-btn friends-btn-muted" data-action="withdraw-game-invite" data-game-id="' +
            esc(pendingGameInvite.gameId) +
            '">' + t("site.friendsPage.cancelInvite") + '</button>' +
            '<button type="button" class="friends-btn friends-btn-danger" data-action="remove" data-id="' +
            esc(f.id) +
            '" disabled title="' + t("site.friendsPage.cancelBeforeRemove") + '">' + t("site.friendsPage.remove") + '</button>' +
            "</div>";
        } else {
          var st = computeEffectiveStatus(f);
          var dotClass = "friends-status-dot friends-status-" + st;
          var sharedId = f.sharedGameWithMeId || null;
          if (sharedId) {
            li.setAttribute("data-shared-game-id", sharedId);
          }
          var showRejoin = st === "playing" && sharedId;
          var inviteDisabled = st !== "online";
          var primaryBtn;
          if (showRejoin) {
            var rejoinLabel = sharedGamePrimaryButtonLabel(sharedId);
            primaryBtn =
              '<button type="button" class="friends-btn friends-btn-primary friends-btn-rejoin" data-action="rejoin-game" data-game-id="' +
              esc(sharedId) +
              '">' +
              esc(rejoinLabel) +
              "</button>";
          } else {
            primaryBtn =
              '<button type="button" class="friends-btn friends-btn-primary friends-btn-invite"' +
              (inviteDisabled ? " disabled" : "") +
              ' data-friend-id="' +
              esc(f.id) +
              '" data-username="' +
              esc(f.username) +
              '">' + t("site.friendsPage.invite") + '</button>';
          }
          li.innerHTML =
            '<span class="' +
            esc(dotClass) +
            '" title="' +
            esc(statusTitle(st)) +
            '" aria-label="' +
            esc(statusTitle(st)) +
            '"></span>' +
            '<span class="friends-username">' +
            esc(f.username) +
            "</span>" +
            '<div class="friends-row-actions">' +
            primaryBtn +
            '<button type="button" class="friends-btn friends-btn-danger" data-action="remove" data-id="' +
            esc(f.id) +
            '">' + t("site.friendsPage.remove") + '</button>' +
            "</div>";
        }
      }
      friendsList.appendChild(li);
    });
  }

  function renderSearchResults(results) {
    if (!searchResults || !searchPlaceholder) return;
    searchResults.innerHTML = "";
    if (!results || results.length === 0) {
      searchPlaceholder.textContent = t("site.friendsPage.noMatchingUsers");
      searchPlaceholder.style.display = "block";
      return;
    }
    searchPlaceholder.style.display = "none";
    results.forEach(function (u) {
      var li = document.createElement("li");
      li.className = "friends-search-row-item";
      var addPart = "";
      if (u.isFriend) {
        addPart = '<span class="friends-tag">' + t("site.friendsPage.friendsTag") + '</span>';
      } else if (u.requestSent) {
        addPart = '<span class="friends-tag">' + t("site.friendsPage.offerSent") + '</span>';
      } else if (u.requestReceived) {
        addPart = '<span class="friends-tag">' + t("site.friendsPage.offerReceivedTag") + '</span>';
      } else {
        addPart =
          '<button type="button" class="friends-btn friends-btn-primary" data-action="addfriend" data-id="' +
          esc(u.id) +
          '">' + t("site.friendsPage.addFriend") + '</button>';
      }
      li.innerHTML = '<span class="friends-username">' + esc(u.username) + "</span>" + addPart;
      searchResults.appendChild(li);
    });
  }

  function refreshData() {
    return fetch("/api/friends/data", { credentials: "same-origin" })
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        if (!data || !data.ok) return;
        var friends = data.friends || [];
        syncPlayingFromApi(friends);
        mergePresenceFromApiFriends(friends);
        renderFriendsAndOffers(data.offersIn || [], friends, data.pendingGameInvite || null);
      })
      .catch(function () {});
  }

  function runSearch(q) {
    var clean = q.replace(/[^a-zA-Z0-9]/g, "");
    if (clean.length < 1) {
      if (searchResults) searchResults.innerHTML = "";
      if (searchPlaceholder) {
        searchPlaceholder.textContent = "<%= t('site.friendsPage.enterCharToSearch') %>";
        searchPlaceholder.style.display = "block";
      }
      return;
    }
    fetch("/api/friends/search?q=" + encodeURIComponent(clean), { credentials: "same-origin" })
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        if (!data || !data.ok) return;
        renderSearchResults(data.results || []);
      })
      .catch(function () {});
  }

  document.addEventListener("click", function (ev) {
    var raw = ev.target;
    if (!raw || !raw.closest) return;
    var el = raw.nodeType === 1 ? raw : raw.parentElement;
    if (!el || !el.closest) return;
    var actionEl = el.closest("[data-action]");
    var action = actionEl ? actionEl.getAttribute("data-action") : null;
    var id = actionEl ? actionEl.getAttribute("data-id") : null;
    if (action === "accept" && id) {
      postJson("/api/friends/accept", { fromUserId: id }).then(refreshData).catch(function (e) {
        showSiteAlert(e.message || t("site.friendsPage.couldNotAccept"), t("site.friendsPage.couldNotAccept"));
      });
    }
    if (action === "decline" && id) {
      postJson("/api/friends/decline", { fromUserId: id }).then(refreshData).catch(function (e) {
        showSiteAlert(e.message || t("site.friendsPage.couldNotDecline"), t("site.friendsPage.couldNotDecline"));
      });
    }
    if (action === "remove" && id) {
      showSiteConfirm(t("site.friendsPage.removeFriendConfirm"), {
        title: t("site.friendsPage.removeFriendTitle"),
        confirmLabel: t("site.friendsPage.remove"),
        cancelLabel: t("site.cancel"),
      }).then(function (ok) {
        if (!ok) return;
        postJson("/api/friends/remove", { friendUserId: id }).then(refreshData).catch(function (e) {
          showSiteAlert(e.message || t("site.friendsPage.couldNotRemove"), t("site.friendsPage.couldNotRemove"));
        });
      });
    }
    if (action === "withdraw-game-invite") {
      var gid = actionEl.getAttribute("data-game-id");
      if (!gid) return;
      postJson("/api/friends/game-invite-withdraw", { gameId: gid })
        .then(refreshData)
        .catch(function (e) {
          showSiteAlert(e.message || t("site.friendsPage.couldNotCancelInvite"), t("site.friendsPage.gameInvite"));
        });
    }
    if (action === "withdraw-invite" && id) {
      showSiteConfirm(t("site.friendsPage.withdrawOfferConfirm"), {
        title: t("site.friendsPage.withdrawOfferTitle"),
        confirmLabel: t("site.friendsPage.withdraw"),
        cancelLabel: t("site.cancel"),
      }).then(function (ok) {
        if (!ok) return;
        postJson("/api/friends/withdraw", { targetUserId: id }).then(refreshData).catch(function (e) {
          showSiteAlert(e.message || t("site.friendsPage.couldNotWithdraw"), t("site.friendsPage.couldNotWithdraw"));
        });
      });
    }
    if (action === "addfriend" && id) {
      postJson("/api/friends/invite", { targetUserId: id })
        .then(function () {
          return refreshData();
        })
        .then(function () {
          var v = searchInput ? searchInput.value : "";
          runSearch(v);
        })
        .catch(function (e) {
          showSiteAlert(e.message || t("site.friendsPage.couldNotSendInvite"), t("site.friendsPage.couldNotSendInvite"));
        });
    }
    if (action === "rejoin-game") {
      var gid = actionEl.getAttribute("data-game-id");
      if (!gid) return;
      if (pendingInviterJoiningGameId && String(gid) === String(pendingInviterJoiningGameId)) {
        if (joiningLabelRevertTimer) {
          clearTimeout(joiningLabelRevertTimer);
          joiningLabelRevertTimer = null;
        }
        pendingInviterJoiningGameId = null;
        pendingInviterJoiningUntil = 0;
      }
      window.location.href =
        (window.__SHMERLING_USE_NEW_PLAY_UI__ ? "/play?id=" : "/game?id=") +
        encodeURIComponent(gid);
      return;
    }
    var inviteBtn = el.closest(".friends-btn-invite");
    if (inviteBtn && !inviteBtn.disabled) {
      var fid = inviteBtn.getAttribute("data-friend-id");
      if (!fid) return;
      postJson("/api/friends/game-invite", { targetUserId: fid })
        .then(function () {
          return refreshData();
        })
        .catch(function (e) {
          showSiteAlert(e.message || t("site.friendsPage.couldNotSendGameInvite"), t("site.friendsPage.gameInvite"));
        });
    }
  });

  if (searchInput) {
    searchInput.addEventListener("input", function () {
      var v = searchInput.value;
      var filtered = v.replace(/[^a-zA-Z0-9]/g, "");
      if (v !== filtered) searchInput.value = filtered;
      if (searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(function () {
        runSearch(filtered);
      }, 280);
    });
    searchInput.addEventListener("keydown", function (e) {
      if (!e.key || e.key.length !== 1) return;
      if (/^[a-zA-Z0-9]$/.test(e.key)) return;
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      var blocked = /[^\x00-\x7F]/.test(e.key) || /[^a-zA-Z0-9]/.test(e.key);
      if (blocked) e.preventDefault();
    });
  }

  window.addEventListener("site-ws-message", function (ev) {
    var msg = ev.detail;
    if (!msg) return;
    if (msg.type === "friendPresence" && msg.data) {
      var d = msg.data;
      if (!d.userId) return;
      var liP = friendsList && friendsList.querySelector('li[data-friend-id="' + d.userId + '"]');
      if (liP && liP.getAttribute("data-friend-offer-in") === "true") return;
      if (liP && liP.getAttribute("data-friend-pending-out") === "true") return;
      if (liP && liP.getAttribute("data-friend-game-invite-pending") === "true") return;
      liveOnlineByUserId[d.userId] = !!d.online;
      var li = friendsList && friendsList.querySelector('li[data-friend-id="' + d.userId + '"]');
      var un = (li && li.getAttribute("data-friend-username")) || d.username || "";
      updateFriendRowVisual(d.userId, un, computeEffectiveStatus({ id: d.userId, username: un, status: "offline", rowType: "friend" }));
      return;
    }
    if (msg.type === "onlineGameInProgress" && msg.data) {
      var d2 = msg.data;
      var gid = d2.gameId != null ? String(d2.gameId) : "";
      var myName = typeof window.__FRIENDS_PAGE_USERNAME__ === "string" ? window.__FRIENDS_PAGE_USERNAME__ : "";
      if (gid) {
        gamePlayersById[gid] = {
          w: d2.whitePlayerName || "",
          b: d2.blackPlayerName || "",
        };
      }
      if (d2.whitePlayerName) playingUsernames[d2.whitePlayerName] = 1;
      if (d2.blackPlayerName) playingUsernames[d2.blackPlayerName] = 1;
      if (myName && gid && d2.whitePlayerName && d2.blackPlayerName) {
        var wN = d2.whitePlayerName;
        var bN = d2.blackPlayerName;
        var imInGame = wN === myName || bN === myName;
        var otherName = wN === myName ? bN : bN === myName ? wN : "";
        if (imInGame && otherName && otherName !== myName) {
          if (myName && wN === myName && gid) {
            markInviterJoiningGame(gid);
          }
          var rowList = friendsList ? friendsList.querySelectorAll("li[data-friend-username]") : [];
          for (var ri = 0; ri < rowList.length; ri++) {
            var rowLi = rowList[ri];
            if (rowLi.getAttribute("data-friend-offer-in") === "true") continue;
            if (rowLi.getAttribute("data-friend-pending-out") === "true") continue;
            if (rowLi.getAttribute("data-friend-game-invite-pending") === "true") continue;
            if (rowLi.getAttribute("data-friend-username") === otherName) {
              rowLi.setAttribute("data-shared-game-id", gid);
              var fid = rowLi.getAttribute("data-friend-id");
              var un = rowLi.getAttribute("data-friend-username") || "";
              updateFriendRowVisual(fid, un, computeEffectiveStatus({ id: fid, username: un, status: "offline", rowType: "friend" }));
            }
          }
        }
      }
      applyPresenceToAllVisibleFriends();
      return;
    }
    if (msg.type === "onlineGameUpdated" && msg.data) {
      var d3 = msg.data;
      var stNorm = String(d3.status || "")
        .toLowerCase()
        .trim();
      var terminal = stNorm === "game over" || stNorm === "cancelled";
      if (terminal && d3.gameId != null) {
        var gpk = String(d3.gameId);
        if (pendingInviterJoiningGameId && gpk === String(pendingInviterJoiningGameId)) {
          if (joiningLabelRevertTimer) {
            clearTimeout(joiningLabelRevertTimer);
            joiningLabelRevertTimer = null;
          }
          pendingInviterJoiningGameId = null;
          pendingInviterJoiningUntil = 0;
        }
        var wN = d3.whitePlayerName || "";
        var bN = d3.blackPlayerName || "";
        if (wN) delete playingUsernames[wN];
        if (bN) delete playingUsernames[bN];
        var gp = gamePlayersById[gpk];
        if (gp) {
          if (gp.w) delete playingUsernames[gp.w];
          if (gp.b) delete playingUsernames[gp.b];
          delete gamePlayersById[gpk];
        }
        if (friendsList) {
          var endedRows = friendsList.querySelectorAll("li[data-shared-game-id]");
          for (var ei = 0; ei < endedRows.length; ei++) {
            var rowLi = endedRows[ei];
            if (rowLi.getAttribute("data-shared-game-id") !== gpk) continue;
            rowLi.removeAttribute("data-shared-game-id");
            var fid2 = rowLi.getAttribute("data-friend-id");
            var un2 = rowLi.getAttribute("data-friend-username") || "";
            updateFriendRowVisual(fid2, un2, computeEffectiveStatus({ id: fid2, username: un2, status: "offline", rowType: "friend" }));
          }
        }
        applyPresenceToAllVisibleFriends();
      }
    }
    if (msg.type === "friendGameInviteAccepted" && msg.data && msg.data.gameId) {
      markInviterJoiningGame(msg.data.gameId);
    }
    if (
      msg.type === "friendGameInviteDeclined" ||
      msg.type === "friendGameInviteWithdrawn" ||
      msg.type === "friendGameInviteAccepted"
    ) {
      refreshData();
    }
  });

  function refreshPlayingFromServer() {
    fetch("/api/friends/playing-usernames", { credentials: "same-origin" })
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        if (!data || !data.ok || !Array.isArray(data.usernames)) return;
        var set = {};
        for (var i = 0; i < data.usernames.length; i++) {
          var u = data.usernames[i];
          if (u) set[u] = 1;
        }
        if (!friendsList) return;
        var rows = friendsList.querySelectorAll("li[data-friend-id]");
        for (var j = 0; j < rows.length; j++) {
          var li = rows[j];
      if (li.getAttribute("data-friend-offer-in") === "true") continue;
      if (li.getAttribute("data-friend-pending-out") === "true") continue;
      if (li.getAttribute("data-friend-game-invite-pending") === "true") continue;
      var un = li.getAttribute("data-friend-username");
          if (!un) continue;
          if (set[un]) playingUsernames[un] = 1;
          else delete playingUsernames[un];
        }
        applyPresenceToAllVisibleFriends();
      })
      .catch(function () {});
  }

  function scheduleResyncAfterWsReconnect() {
    if (wsResyncTimer) clearTimeout(wsResyncTimer);
    wsResyncTimer = setTimeout(function () {
      wsResyncTimer = null;
      refreshData();
    }, 500);
  }

  window.addEventListener("site-ws-reconnected", function () {
    scheduleResyncAfterWsReconnect();
  });

  window.addEventListener("pageshow", function (ev) {
    if (ev.persisted) {
      refreshData();
      refreshPlayingFromServer();
    }
  });

  refreshData();
  setInterval(refreshData, 45000);
  refreshPlayingFromServer();
  setInterval(refreshPlayingFromServer, 8000);
})();
</script>
