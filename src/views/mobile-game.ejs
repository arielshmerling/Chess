<% layout("../views/layouts/mobile-game-boilerplate") %>

<link rel="stylesheet" href="/welcome.css">
<script>
  window.__LAST_GAME_OPTIONS__ = window.__LAST_GAME_OPTIONS__ || {};
</script>

<div id="main" class="mobile-game-page" data-initial-game-id="<%= typeof gameId !== 'undefined' && gameId != null ? gameId : '' %>" data-research-mode="<%= typeof researchMode !== 'undefined' && researchMode ? 'true' : '' %>">
  <!-- Bookmarks UI omitted on mobile; inert stubs satisfy any getElementById lookups. -->
  <div id="bookmarksPanel" class="mobile-game-bookmarks-stub" aria-hidden="true">
    <div id="bookmarksList" class="bookmarksList"></div>
  </div>

  <section id="mobile-match-bar" class="mobile-match-bar" data-active-turn="white" data-game-id="<%= typeof gameId !== 'undefined' && gameId != null ? String(gameId).replace(/"/g, '&quot;') : '' %>">
    <div class="mobile-match-bar__row">
      <div class="mobile-clock-cell mobile-clock-cell--white">
        <div id="whiteClock" class="mobile-clock-display">
          <div id="whiteTurnClock" class="turnClock unvisible"><img src="/images/clock.png" width="24" alt="" /></div>
          <div id="whiteClockTimeText" class="mobile-clock-time">05:00:00</div>
        </div>
      </div>
      <div class="mobile-vs-block">
        <button type="button" class="mobile-vs-title" id="mobileMatchTitleBtn"
          title=""
          aria-label="Players and game ID (tooltip).">
          <span id="whitePlayerName" class="mobile-vs-name mobile-vs-name--line1"></span>
          <span class="mobile-vs-sep" aria-hidden="true">Vs.</span>
          <span id="blackPlayerName" class="mobile-vs-name mobile-vs-name--line3"></span>
        </button>
      </div>
      <div class="mobile-clock-cell mobile-clock-cell--black">
        <div id="blackClock" class="mobile-clock-display">
          <div id="blackTurnClock" class="turnClock unvisible"><img src="/images/clock.png" width="24" alt="" /></div>
          <div id="blackClockTimeText" class="mobile-clock-time">05:00:00</div>
        </div>
      </div>
    </div>
  </section>

  <div id="chessboard"> </div>

  <div class="mobile-captures-row">
    <div id="whiteCapturedPiece" class="sideBlock captureToolsList mobile-capture-tray"></div>
    <div id="blackCapturedPiece" class="sideBlock captureToolsList mobile-capture-tray"></div>
  </div>

  <div class="mobile-game-offscreen-suite" aria-hidden="true">
    <div id="movesDivContainer" class="movesDivContainer">
      <div id="movesDivHeader" class="movesDivHeader">
        <table class="movesTableHeader">
          <tr>
            <th>#</th>
            <th>White</th>
            <th>Black</th>
          </tr>
        </table>
      </div>
      <div id="movesDiv" class="movesDiv">

      </div>
    </div>
    <div id="gameNav" class="gameNav">

    </div>
    <div class="messagesContainer">
      <div id="messages" class="messages"></div>
      <div class="chatSendLine">
        <input type="text" class="chatline" id="chatline" maxlength="30" />
        <img src="/images/whiteSend.png" alt="send" class="sendButton" onclick="onSendChatButtonClick(event)" />
      </div>
    </div>
    <div id="blackPlayersInfo" class="sideBlock playerInfo short mobile-game-hidden-player">
      <div class="playerInfo-statusWrap">
        <div class="friends-status-dot friends-status-offline" id="blackPlayerStatus" title="" aria-label=""></div>
      </div>
      <div id="blackPlayerDiconnectionTimer" class="disconnectionTimer hide"></div>
    </div>
    <div id="whitePlayersInfo" class="sideBlock playerInfo short mobile-game-hidden-player">
      <div class="playerInfo-statusWrap">
        <div class="friends-status-dot friends-status-offline" id="whitePlayerStatus" title="" aria-label=""></div>
      </div>
      <div id="whitePlayerDiconnectionTimer" class="disconnectionTimer hide"></div>
    </div>
  </div>

</div>

<section id="options" class="mobile-options-bar">
</section>

  <div id="playNowModal" class="play-now-modal" aria-hidden="true">
    <div class="play-now-modal-overlay" onclick="closePlayNowModal()"></div>
    <div class="play-now-modal-dialog" role="dialog" aria-labelledby="playNowModalTitle">
      <h2 id="playNowModalTitle" class="play-now-modal-title">New game</h2>
      <form id="playNowForm" class="play-now-form" onsubmit="startNewGameFromModal(event)">
        <div class="play-now-field">
          <label class="play-now-label">Playing color</label>
          <div class="play-now-radio-group">
            <label class="play-now-radio">
              <input type="radio" name="color" value="white" checked>
              <span>White</span>
            </label>
            <label class="play-now-radio">
              <input type="radio" name="color" value="black">
              <span>Black</span>
            </label>
          </div>
        </div>
        <div class="play-now-field">
          <div class="play-now-engine-time-row">
            <div class="play-now-engine-col">
              <label class="play-now-label" for="playNowEngine">Engine</label>
              <select id="playNowEngine" name="engine" class="play-now-select play-now-select--compact">
                <option value="brain4">Brain 4.0</option>
                <option value="brain3">Brain 3</option>
                <option value="brain2">Brain 2</option>
                <option value="brain5">Brain 5</option>
              </select>
            </div>
            <div class="play-now-time-col">
              <label class="play-now-label" for="playNowTimeMinutes">Time (min)</label>
              <input type="number" id="playNowTimeMinutes" name="timeMinutes" class="play-now-time-input" min="1" max="180" step="1" value="90" title="Clock time per side in minutes">
            </div>
          </div>
        </div>
        <div class="play-now-field">
          <label class="play-now-label" for="playNowDifficulty">Difficulty (1–5)</label>
          <div class="play-now-slider-row">
            <input type="range" min="1" max="5" value="3" name="difficulty" id="playNowDifficulty" class="play-now-slider" oninput="document.getElementById('playNowDifficultyValue').textContent=this.value">
            <span id="playNowDifficultyValue" class="play-now-slider-value">3</span>
          </div>
        </div>
        <div class="play-now-field">
          <label class="play-now-label">Mouse preference</label>
          <div class="play-now-radio-group">
            <label class="play-now-radio" id="mouseDragLabel">
              <input type="radio" name="mouse" value="drag" id="mouseDrag" checked>
              <span>Drag</span>
            </label>
            <label class="play-now-radio">
              <input type="radio" name="mouse" value="double" id="mouseDouble">
              <span>Double click</span>
            </label>
          </div>
        </div>
        <div class="play-now-field">
          <label class="play-now-checkbox-label">
            <input type="checkbox" name="showMoves" id="playNowShowMoves" value="1" checked>
            <span>Show available moves</span>
          </label>
        </div>
        <div class="play-now-field">
          <label class="play-now-checkbox-label" title="A private game is not visible to other members and is not shown on the club homepage.">
            <input type="checkbox" name="private" id="playNowPrivate" value="1">
            <span>Private</span>
          </label>
        </div>
        <div class="play-now-modal-actions">
          <button type="button" class="play-now-btn-cancel" onclick="closePlayNowModal()">Cancel</button>
          <button type="submit" class="play-now-btn-start">Start</button>
        </div>
      </form>
    </div>
  </div>
