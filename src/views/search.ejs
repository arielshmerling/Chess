<% layout("../views/layouts/boilerplate") %>

<link rel="stylesheet" href="/welcome.css">
<link rel="stylesheet" href="/board-geometry.css">

<div class="welcome-container search-page board-geometry">
  <header class="hero-banner hero-banner--board">
    <div class="hero-board-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text-section">
        <h1 class="hero-username"><%= t('site.search') %></h1>
        <p class="hero-tagline"><%= t('site.searchPage.tagline') %></p>
      </div>
      <div class="hero-right">
        <form class="search-hero-form" method="get" action="search" id="searchHeroForm">
          <input type="text" id="search" name="q" class="search-hero-input" value="<%= q || '' %>"
            autocomplete="off" aria-label="<%= t('site.searchPage.title').replace(':', '').replace('：', '').trim() %>">
          <button id="searchButton" type="submit" class="search-hero-btn"><%= t('site.searchPage.button') %></button>
        </form>
      </div>
    </div>
  </header>

  <div class="games-section">
    <section class="games-panel search-results-panel" id="PGNGameList">
      <div class="panel-header">
        <div class="panel-header-top">
          <div class="panel-title-group">
            <h2 class="panel-title"><%= t('site.searchPage.results') %></h2>
          </div>
          <p class="panel-subtitle panel-subtitle--inline" id="searchResultsCount" aria-live="polite"><%= t('site.searchPage.loading') %></p>
        </div>
      </div>
      <div class="panel-body">
        <div id="searchResultsStatus" class="no-games-message" role="status" aria-live="polite">
          <p><%= t('site.searchPage.loadingLibrary') %></p>
        </div>
        <div class="table-scroll table-scroll--wide" id="searchResultsTableWrap" hidden>
          <table class="games-table sortable" id="searchResultsTable">
            <thead>
              <tr id="searchResultsHead"></tr>
            </thead>
            <tbody id="searchResultsBody"></tbody>
          </table>
        </div>
        <nav class="pagesNav" id="searchPagesNav" hidden></nav>
      </div>
    </section>
  </div>

  <%- include('partials/site-page-footer') %>
</div>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
  window.__SEARCH_BOOT__ = {
    q: <%- JSON.stringify(q || "") %>,
    page: <%= typeof page !== "undefined" ? Number(page) || 1 : 1 %>,
    sortKey: <%- JSON.stringify(sortKey || null) %>,
    sortOrder: <%- JSON.stringify(sortOrder || null) %>,
    strings: {
      resultsCount: <%- JSON.stringify(t("site.searchPage.resultsCount")) %>,
      loading: <%- JSON.stringify(t("site.searchPage.loading")) %>,
      loadingLibrary: <%- JSON.stringify(t("site.searchPage.loadingLibrary")) %>,
      loadError: <%- JSON.stringify(t("site.searchPage.loadError")) %>,
      noResults: <%- JSON.stringify(t("site.searchPage.noResults")) %>,
      first: <%- JSON.stringify(t("site.searchPage.first")) %>,
      last: <%- JSON.stringify(t("site.searchPage.last")) %>,
      previous: <%- JSON.stringify(t("site.searchPage.previous")) %>,
      next: <%- JSON.stringify(t("site.searchPage.next")) %>,
      previous5Pages: <%- JSON.stringify(t("site.searchPage.previous5Pages")) %>,
      next5Pages: <%- JSON.stringify(t("site.searchPage.next5Pages")) %>,
      previous10Pages: <%- JSON.stringify(t("site.searchPage.previous10Pages")) %>,
      next10Pages: <%- JSON.stringify(t("site.searchPage.next10Pages")) %>,
      sortBy: <%- JSON.stringify(t("site.welcome.sortBy", { key: "{{key}}" })) %>,
      sortByRowNumber: <%- JSON.stringify(t("site.welcome.sortByRowNumber")) %>,
      colDate: <%- JSON.stringify(t("site.gameList.date")) %>,
      colTime: <%- JSON.stringify(t("site.gameList.time")) %>,
      colWhite: <%- JSON.stringify(t("common.white")) %>,
      colBlack: <%- JSON.stringify(t("common.black")) %>,
      colResult: <%- JSON.stringify(t("site.gameList.result")) %>,
      colMoves: <%- JSON.stringify(t("site.activeGames.moves")) %>,
      colReason: <%- JSON.stringify(t("site.gameList.reason")) %>,
      colType: <%- JSON.stringify(t("site.gameList.type")) %>,
      colStatus: <%- JSON.stringify(t("site.gameList.status")) %>,
      colEvent: <%- JSON.stringify(t("site.gameList.event")) %>,
      colSite: <%- JSON.stringify(t("site.gameList.site")) %>,
      colRound: <%- JSON.stringify(t("site.gameList.round")) %>
    }
  };
</script>
<script src="/searchPage.js" defer></script>
